      </solution>
    </exercise>
    <exercise number="48" has_solution="false">
      <problem>
        <paragraph>The difference of $$9x$$ and $$8x$$ is $$17.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="49" has_solution="true">
