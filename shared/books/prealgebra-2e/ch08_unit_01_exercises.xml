    <paragraph>Translate to an Equation and Solve</paragraph>
    <paragraph>In the following exercises, translate to an equation and then solve.</paragraph>
    <exercise number="42" has_solution="false">
      <problem>
        <paragraph>Five more than $$x$$ is equal to $$21.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="43" has_solution="true">
      <problem>
        <paragraph>The sum of $$x$$ and $$-5$$ is $$33.$$</paragraph>
      </problem>
      <solution>
        <paragraph>x + (−5) = 33; x = 38</paragraph>
      </solution>
    </exercise>
    <exercise number="44" has_solution="false">
      <problem>
        <paragraph>Ten less than $$m$$ is $$-14.$$</paragraph>
      </problem>
    </exercise>
