  <exercises>
    <heading level="1">Section 8.1 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Solve Equations Using the Subtraction and Addition Properties of Equality</paragraph>
    <paragraph>In the following exercises, determine whether the given value is a solution to the equation.</paragraph>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>Is $$y = \frac{1}{3}$$ a solution of $$4y + 2 = 10y?$$</paragraph>
      </problem>
      <solution>
        <paragraph>yes</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>Is $$x = \frac{3}{4}$$ a solution of $$5x + 3 = 9x?$$</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>Is $$u = -\frac{1}{2}$$ a solution of $$8u - 1 = 6u?$$</paragraph>
      </problem>
      <solution>
        <paragraph>no</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>Is $$v = -\frac{1}{3}$$ a solution of $$9v - 2 = 3v?$$</paragraph>
      </problem>
    </exercise>
