    <paragraph>Solve Equations that Need to be Simplified</paragraph>
    <paragraph>In the following exercises, solve each equation.</paragraph>
    <exercise number="22" has_solution="false">
      <problem>
        <paragraph>$$c + 3 - 10 = 18$$</paragraph>
      </problem>
    </exercise>
    <exercise number="23" has_solution="true">
      <problem>
        <paragraph>$$m + 6 - 8 = 15$$</paragraph>
      </problem>
      <solution>
        <paragraph>m = 17</paragraph>
      </solution>
    </exercise>
    <exercise number="24" has_solution="false">
      <problem>
        <paragraph>$$9x + 5 - 8x + 14 = 20$$</paragraph>
      </problem>
    </exercise>
