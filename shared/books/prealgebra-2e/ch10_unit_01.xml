      <list type="ol" style="1">
        <item>ⓐ $$\ y^{3} - 8$$</item>
        <item>ⓑ $$\ 9x^{3} - 5x^{2} - x$$</item>
        <item>ⓒ $$\ x^{4} - 3x^{2} - 4x - 7$$</item>
