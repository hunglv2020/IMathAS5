    <paragraph>Translate Word Phrases into Expressions with Integers</paragraph>
    <paragraph>Translate each phrase into an expression with integers. Do not simplify.</paragraph>
    <exercise number="43" has_solution="true">
      <problem>
        <list type="ordered">
          <item>ⓐ the opposite of $$8$$</item>
          <item>ⓑ the opposite of $$-6$$</item>
          <item>ⓒ negative three</item>
          <item>ⓓ $$4$$ minus negative $$3$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ −8</item>
          <item>ⓑ −(−6), or 6</item>
          <item>ⓒ −3</item>
          <item>ⓓ 4−(−3)</item>
        </list>
      </solution>
    </exercise>
