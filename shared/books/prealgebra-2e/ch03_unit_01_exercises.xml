    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Locate Positive and Negative Numbers on the Number Line</paragraph>
    <paragraph>For the following exercises, draw a number line and locate and label the given points on that number line.</paragraph>
    <exercise number="1" has_solution="true">
      <problem>
        <list type="ordered">
          <item>ⓐ $$2$$</item>
          <item>ⓑ $$-2$$</item>
          <item>ⓒ $$-5$$</item>
        </list>
      </problem>
      <solution/>
    </exercise>
