    <paragraph>Order Positive and Negative Numbers on the Number Line</paragraph>
    <paragraph>In the following exercises, order each of the following pairs of numbers, using $$&lt;$$ or $$\text{&gt;.}$$</paragraph>
    <exercise number="5" has_solution="true">
      <problem>
        <list type="ordered">
          <item>ⓐ $$9 \text{\_\_} 4\$$</item>
          <item>ⓑ $$-3 \text{\_\_} 6\$$</item>
          <item>ⓒ $$-8 \text{\_\_} -2\$$</item>
          <item>ⓓ $$1 \text{\_\_} -10$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ &gt;</item>
          <item>ⓑ &lt;</item>
          <item>ⓒ &lt;</item>
          <item>ⓓ &gt;</item>
        </list>
      </solution>
    </exercise>
    <exercise number="6" has_solution="false">
      <problem>
        <list type="ordered">
          <item>ⓐ $$6 \text{\_\_} 2;\$$</item>
          <item>ⓑ $$-7 \text{\_\_} 4;\$$</item>
          <item>ⓒ $$-9 \text{\_\_} -1;\$$</item>
          <item>ⓓ $$9 \text{\_\_} -3$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="7" has_solution="true">
      <problem>
        <list type="ordered">
          <item>ⓐ $$-5 \text{\_\_} 1;\$$</item>
          <item>ⓑ $$-4 \text{\_\_} -9;\$$</item>
          <item>ⓒ $$6 \text{\_\_} 10;\$$</item>
          <item>ⓓ $$3 \text{\_\_} -8$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ &lt;</item>
          <item>ⓑ &gt;</item>
          <item>ⓒ &lt;</item>
          <item>ⓓ &gt;</item>
        </list>
      </solution>
    </exercise>
    <exercise number="8" has_solution="false">
