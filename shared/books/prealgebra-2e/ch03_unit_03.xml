    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell>ⓐ</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell>$$8 - 2$$ This means $$8$$ take away $$2$$ .</cell>
          </row>
          <row>
            <cell>Start with 8 positives.</cell>
            <cell/>
          </row>
          <row>
            <cell>Take away 2 positives.</cell>
            <cell/>
          </row>
          <row>
            <cell>How many are left?</cell>
            <cell>$$6$$</cell>
          </row>
          <row>
            <cell/>
            <cell>$$8 - 2 = 6$$</cell>
          </row>
        </tbody>
      </table>
      <table>
        <tbody>
          <row>
            <cell>ⓑ</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell>$$-5 - 4$$ This means $$-5$$ take away $$4$$ .</cell>
          </row>
          <row>
            <cell>Start with 5 negatives.</cell>
            <cell/>
          </row>
          <row>
            <cell>You need to take away 4 positives.Add 4 neutral pairs to get 4 positives.</cell>
            <cell/>
          </row>
          <row>
            <cell>Take away 4 positives.</cell>
            <cell/>
          </row>
          <row>
            <cell>How many are left?</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell>$$-9$$</cell>
          </row>
          <row>
            <cell/>
            <cell>$$-5 - 4 = -9$$</cell>
          </row>
        </tbody>
      </table>
      <table>
        <tbody>
          <row>
            <cell>ⓒ</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell>$$6 - (-6)$$ This means $$6$$ take away $$-6$$ .</cell>
          </row>
          <row>
            <cell>Start with 6 positives.</cell>
            <cell/>
          </row>
          <row>
            <cell>Add 6 neutrals to get 6 negatives to take away.</cell>
            <cell/>
          </row>
          <row>
            <cell>Remove 6 negatives.</cell>
            <cell/>
          </row>
          <row>
            <cell>How many are left?</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell>$$12$$</cell>
          </row>
          <row>
            <cell/>
            <cell>$$6 - (-6) = 12$$</cell>
          </row>
        </tbody>
      </table>
      <table>
        <tbody>
          <row>
            <cell>ⓓ</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell>$$-8 - (-3)$$ This means $$-8$$ take away $$-3$$ .</cell>
          </row>
          <row>
            <cell>Start with 8 negatives.</cell>
            <cell/>
          </row>
          <row>
            <cell>Take away 3 negatives.</cell>
            <cell/>
          </row>
          <row>
            <cell>How many are left?</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell>$$-5$$</cell>
          </row>
          <row>
            <cell/>
            <cell>$$-8 - (-3) = -5$$</cell>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
