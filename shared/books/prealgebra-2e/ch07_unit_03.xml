<section number="7.3" title="Distributive Property">
  <learning_objectives>
    <objective number="" />
    <objective number="" />
  </learning_objectives>
  <note type="Be Prepared" number="7.7">
    <p>Before you get started, take this readiness quiz.</p>
    <p>Multiply: $$3{(0.25)}.$$
If you missed this problem, review Example 5.15</p>
  </note>
  <note type="Be Prepared" number="7.8">
    <p>Simplify: $$10 - (-2)(3).$$
If you missed this problem, review Example 3.51</p>
  </note>
