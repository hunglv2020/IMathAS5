<section>
  <heading level="1">7.3 Distributive Property</heading>
  <heading level="2">Learning Objectives</heading>
  <list type="unordered">
    <item>Simplify expressions using the distributive property</item>
    <item>Evaluate expressions using the distributive property</item>
  </list>
  <note type="practice" source_type="Be Prepared" title="Be Prepared" number="7.7">
