    <paragraph>Evaluate Variable Expressions with Integers</paragraph>
    <paragraph>In the following exercises, evaluate each expression.</paragraph>
    <exercise number="87" has_solution="true">
      <problem>
        <paragraph>$$x = -26$$ when</paragraph>
        <list type="ordered">
          <item>ⓐ $$x = -95$$</item>
          <item>ⓑ $$y + 9$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ −18</item>
          <item>ⓑ −87</item>
        </list>
      </solution>
    </exercise>
    <exercise number="88" has_solution="false">
