        <list type="ordered">
          <item>ⓐ when $$x = 3$$</item>
          <item>ⓑ in general</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ $$y=2y=2$$</item>
          <item>ⓑ $$y=12-2x3y=12-2x3$$</item>
        </list>
      </solution>
    </exercise>
