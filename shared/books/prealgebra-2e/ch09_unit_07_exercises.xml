        <list type="ordered">
          <item>ⓐ $$I = \text{\$5,480}$$ , $$r = \text{4\%}$$ , $$t = 7 \text{years}$$</item>
          <item>ⓑ in general</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ $$P=\$19,571.43P=\$19,571.43$$</item>
          <item>ⓑ $$P=IrtP=Irt$$</item>
