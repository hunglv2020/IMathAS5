    <heading level="1">Everyday Math</heading>
    <exercise number="357" has_solution="true">
      <problem>
        <paragraph>Converting temperature While on a tour in Greece, Tatyana saw that the temperature was $$\text{40°}$$ Celsius. Solve for $$F$$ in the formula $$C = \frac{5}{9}\left( {F - 32} \right)$$ to find the temperature in Fahrenheit.</paragraph>
      </problem>
      <solution>
        <paragraph>104° F</paragraph>
      </solution>
    </exercise>
