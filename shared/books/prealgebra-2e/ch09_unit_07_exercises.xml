    <paragraph>Solve a Formula for a Specific Variable</paragraph>
    <paragraph>In the following exercises, use the formula. $$d = rt.$$</paragraph>
    <exercise number="319" has_solution="true">
      <problem>
        <paragraph>Solve for $$t:$$</paragraph>
        <list type="ordered">
          <item>ⓐ when $$d = 350$$ and $$r = 70$$</item>
          <item>ⓑ in general</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ $$t=5t=5$$</item>
          <item>ⓑ $$t=drt=dr$$</item>
        </list>
      </solution>
    </exercise>
