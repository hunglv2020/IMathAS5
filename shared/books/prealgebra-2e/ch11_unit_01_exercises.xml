            </row>
          </thead>
          <tbody>
            <row>
              <cell>$$-1-1$$</cell>
              <cell>$$-6-6$$</cell>
              <cell>$$(-1,-6)(-1,-6)$$</cell>
            </row>
            <row>
              <cell>$$00$$</cell>
              <cell>$$-4-4$$</cell>
              <cell>$$(0,-4)(0,-4)$$</cell>
            </row>
            <row>
              <cell>$$22$$</cell>
              <cell>$$00$$</cell>
              <cell>$$(2,0)(2,0)$$</cell>
