    <paragraph>Find Solutions to Linear Equations in Two Variables</paragraph>
    <paragraph>In the following exercises, complete the table to find solutions to each linear equation.</paragraph>
    <exercise number="29" has_solution="true">
      <problem>
        <paragraph>$$y = 2x - 4$$</paragraph>
        <table>
          <thead>
            <row>
              <cell header="true">$$x$$</cell>
              <cell header="true">$$y$$</cell>
              <cell header="true">$$(x,y)$$</cell>
            </row>
          </thead>
          <tbody>
            <row>
              <cell>$$-1$$</cell>
              <cell/>
              <cell/>
            </row>
            <row>
              <cell>$$0$$</cell>
              <cell/>
              <cell/>
            </row>
            <row>
              <cell>$$2$$</cell>
              <cell/>
              <cell/>
            </row>
          </tbody>
        </table>
      </problem>
      <solution>
        <table>
          <thead>
            <row>
              <cell header="true">$$xx$$</cell>
              <cell header="true">$$yy$$</cell>
