    <paragraph>Write Percent Equations as Proportions</paragraph>
    <paragraph>In the following exercises, translate to a proportion.</paragraph>
    <exercise number="299" has_solution="true">
      <problem>
        <paragraph>What number is $$\text{35\%}$$ of $$250?$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$n 250 = 35 100 n 250 = 35 100$$</paragraph>
      </solution>
    </exercise>
    <exercise number="300" has_solution="false">
