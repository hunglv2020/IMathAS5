    <paragraph>Identify the Place Value of a Digit</paragraph>
    <paragraph>In the following exercises, find the place value of the given digits.</paragraph>
    <exercise number="9" has_solution="true">
      <problem>
        <paragraph>$$579,601$$</paragraph>
        <list type="ordered">
          <item>ⓐ 9</item>
          <item>ⓑ 6</item>
          <item>ⓒ 0</item>
          <item>ⓓ 7</item>
          <item>ⓔ 5</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ thousands</item>
          <item>ⓑ hundreds</item>
          <item>ⓒ tens</item>
          <item>ⓓ ten thousands</item>
          <item>ⓔ hundred thousands</item>
        </list>
      </solution>
    </exercise>
    <exercise number="10" has_solution="false">
      <problem>
        <paragraph>$$398,127$$</paragraph>
