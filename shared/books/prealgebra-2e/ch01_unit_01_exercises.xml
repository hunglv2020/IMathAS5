    <heading level="1">Section 1.1 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Identify Counting Numbers and Whole Numbers</paragraph>
    <paragraph>In the following exercises, determine which of the following numbers are ⓐ counting numbers ⓑ whole numbers.</paragraph>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>$$0,\frac{2}{3},5,8.1,125$$</paragraph>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ 5, 125</item>
          <item>ⓑ 0, 5, 125</item>
        </list>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>$$0,\frac{7}{10},3,20.5,300$$</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>$$0,\frac{4}{9},3.9,50,221$$</paragraph>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ 50, 221</item>
          <item>ⓑ 0, 50, 221</item>
        </list>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>$$0,\frac{3}{5},10,303,422.6$$</paragraph>
      </problem>
    </exercise>
