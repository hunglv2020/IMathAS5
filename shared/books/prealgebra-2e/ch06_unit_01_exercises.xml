        <row>
          <cell>$$\text{A}$$</cell>
          <cell>$$\text{4/5}$$</cell>
        </row>
        <row>
          <cell>$$\text{B}$$</cell>
          <cell>$$\text{3.5/4}$$</cell>
        </row>
        <row>
          <cell>$$\text{C}$$</cell>
