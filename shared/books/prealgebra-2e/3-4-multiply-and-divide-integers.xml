        <table summary="Worked example: Multiplication of a negative and positive integer, showing the problem, explanation, and final result." number="Table 3.5">
          <tbody>
            <row>
              <cell>ⓐ</cell>
              <cell />
            </row>
            <row>
              <cell />
              <cell>$$–9 \cdot 3$$</cell>
            </row>
            <row>
              <cell>Multiply, noting that the signs are different and so the product is negative.</cell>
              <cell>$$–27$$</cell>
            </row>
          </tbody>
        </table>
        <table summary="Example demonstrating the multiplication of two negative numbers, showing that a positive product results when signs are the same." number="Table 3.6">
          <tbody>
            <row>
              <cell>ⓑ</cell>
              <cell />
            </row>
            <row>
              <cell />
              <cell>$$–2(–5)$$</cell>
            </row>
            <row>
              <cell>Multiply, noting that the signs are the same and so the product is positive.</cell>
              <cell>$$10$$</cell>
            </row>
          </tbody>
        </table>
        <table summary="Example showing multiplication of integers with different signs, yielding a negative product." number="Table 3.7">
          <tbody>
            <row>
              <cell>ⓒ</cell>
              <cell />
            </row>
            <row>
              <cell />
              <cell>$$4(–8)$$</cell>
            </row>
            <row>
              <cell>Multiply, noting that the signs are different and so the product is negative.</cell>
