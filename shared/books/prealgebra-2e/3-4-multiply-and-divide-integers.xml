            </row>
          </tbody>
        </table>
        <table summary="Illustrates the multiplication of 7 and 6, showing the positive product and the reason for its sign." number="Table 3.8">
          <tbody>
            <row>
              <cell>ⓓ</cell>
              <cell />
            </row>
            <row>
              <cell />
              <cell>$$7 \cdot 6$$</cell>
