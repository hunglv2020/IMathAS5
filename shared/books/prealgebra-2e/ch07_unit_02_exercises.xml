          <item>ⓐ $$d + 2.375 + ( - d)$$</item>
          <item>ⓑ $$d + ( - d) + 2.375$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ 2.375</item>
          <item>ⓑ 2.375</item>
        </list>
      </solution>
    </exercise>
    <exercise number="48" has_solution="false">
      <problem>
        <paragraph>If $$j = 11,$$ evaluate:</paragraph>
        <list type="ordered">
          <item>ⓐ $$\frac{5}{6}\left( {\frac{6}{5}j} \right)$$</item>
          <item>ⓑ $$\left( {\frac{5}{6} \cdot \frac{6}{5}} \right)j$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="49" has_solution="true">
      <problem>
        <paragraph>If $$k = 21,$$ evaluate:</paragraph>
