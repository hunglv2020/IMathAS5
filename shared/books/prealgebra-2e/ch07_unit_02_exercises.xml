    </exercise>
    <exercise number="41" has_solution="true">
      <problem>
        <paragraph>$$4{({7x})} = \text{\_\_\_}$$</paragraph>
      </problem>
      <solution>
        <paragraph>4(7x) = (4 · 7)x</paragraph>
