    </exercise>
    <paragraph>Evaluate Expressions using the Commutative and Associative Properties</paragraph>
    <paragraph>In the following exercises, evaluate each expression for the given value.</paragraph>
    <exercise number="44" has_solution="false">
      <problem>
        <paragraph>If $$y = \frac{5}{8},$$ evaluate:</paragraph>
        <list type="ordered">
          <item>ⓐ $$y + 0.49 + ( - y)$$</item>
          <item>ⓑ $$y + ( - y) + 0.49$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="45" has_solution="true">
      <problem>
        <paragraph>If $$z = \frac{7}{8},$$ evaluate:</paragraph>
        <list type="unordered">
          <item>ⓐ $$z + 0.97 + ( - z)$$</item>
          <item>ⓑ $$z + ( - z) + 0.97$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ 0.97</item>
          <item>ⓑ 0.97</item>
        </list>
      </solution>
    </exercise>
    <exercise number="46" has_solution="false">
      <problem>
        <paragraph>If $$c = - \frac{11}{4},$$ evaluate:</paragraph>
        <list type="ordered">
          <item>ⓐ $$c + 3.125 + ( - c)$$</item>
          <item>ⓑ $$c + ( - c) + 3.125$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="47" has_solution="true">
      <problem>
        <paragraph>If $$d = - \frac{9}{4},$$ evaluate:</paragraph>
