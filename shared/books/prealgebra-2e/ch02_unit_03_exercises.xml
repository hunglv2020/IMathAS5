    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Determine Whether a Number is a Solution of an Equation</paragraph>
    <paragraph>In the following exercises, determine whether each given value is a solution to the equation.</paragraph>
    <exercise number="147" has_solution="true">
      <problem>
        <paragraph>$$x + 13 = 21$$</paragraph>
        <list type="ordered">
          <item>ⓐ $$x = 8$$</item>
          <item>ⓑ $$x = 34$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ yes</item>
          <item>ⓑ no</item>
        </list>
      </solution>
    </exercise>
    <exercise number="148" has_solution="false">
