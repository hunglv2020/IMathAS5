    <heading level="1">Everyday Math</heading>
    <exercise number="209" has_solution="true">
      <problem>
        <paragraph>Insurance Vince’s car insurance has a $$\text{\$500}$$ deductible. Find the amount the insurance company will pay, $$p,$$ for an $$\text{\$1800}$$ claim by solving the equation $$500 + p = 1800.$$</paragraph>
      </problem>
      <solution>
        <paragraph>\$1300</paragraph>
      </solution>
    </exercise>
    <exercise number="210" has_solution="false">
      <problem>
        <paragraph>Insurance Marta’s homeowner’s insurance policy has a $$\text{\$750}$$ deductible. The insurance company paid $$\text{\$5800}$$ to repair damages caused by a storm. Find the total cost of the storm damage, $$d,$$ by solving the equation $$d - 750 = 5800.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="211" has_solution="true">
      <problem>
        <paragraph>Sale purchase Arthur bought a suit that was on sale for $$\text{\$120}$$ off. He paid $$\text{\$340}$$ for the suit. Find the original price, $$p,$$ of the suit by solving the equation $$p - 120 = 340.$$</paragraph>
      </problem>
      <solution>
        <paragraph>\$460</paragraph>
      </solution>
    </exercise>
    <exercise number="212" has_solution="false">
      <problem>
        <paragraph>Sale purchase Rita bought a sofa that was on sale for $$\text{\$1299} .$$ She paid a total of $$\text{\$1409} ,$$ including sales tax. Find the amount of the sales tax, $$t,$$ by solving the equation $$1299 + t = 1409.$$</paragraph>
      </problem>
    </exercise>
