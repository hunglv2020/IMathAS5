              <cell>Check:</cell>
              <cell>Is the product of −3.1 and $$x$$ equal to $$5.27$$?</cell>
              <cell />
            </row>
            <row>
              <cell>Let $$x = -1.7$$:</cell>
              <cell>Is the product of $$-3.1$$ and $$-1.7$$ equal to $$5.27$$?</cell>
              <cell />
            </row>
            <row>
              <cell>Translate.</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>Simplify.</cell>
              <cell />
              <cell />
            </row>
          </tbody>
        </table>
      </solution>
    </example>
