    <paragraph>Evaluate Expressions Using the Distributive Property</paragraph>
    <paragraph>In the following exercises, evaluate both expressions for the given value.</paragraph>
    <exercise number="142" has_solution="false">
      <problem>
        <paragraph>If $$v = -2,$$ evaluate</paragraph>
        <list type="ordered">
          <item>ⓐ $$6(4v + 7)$$</item>
          <item>ⓑ $$6 \cdot 4v + 6 \cdot 7$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="143" has_solution="true">
      <problem>
        <paragraph>If $$u = -1,$$ evaluate</paragraph>
        <list type="ordered">
          <item>ⓐ $$8(5u + 12)$$</item>
          <item>ⓑ $$8 \cdot 5u + 8 \cdot 12$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ 56</item>
          <item>ⓑ 56</item>
        </list>
      </solution>
    </exercise>
    <exercise number="144" has_solution="false">
      <problem>
        <paragraph>If $$n = \frac{2}{3},$$ evaluate</paragraph>
        <list type="ordered">
          <item>ⓐ $$3\left( n + \frac{5}{6} \right)$$</item>
          <item>ⓑ $$3 \cdot n + 3 \cdot \frac{5}{6}$$</item>
        </list>
      </problem>
    </exercise>
