    <heading level="1">Section 5.4 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Determine Whether a Decimal is a Solution of an Equation</paragraph>
    <paragraph>In the following exercises, determine whether each number is a solution of the given equation.</paragraph>
    <exercise number="285" has_solution="true">
      <problem>
        <paragraph>$$x - 0.8 = 2.3$$ ⓐ $$x = 2$$ ⓑ $$x = -1.5$$ ⓒ $$x = 3.1$$</paragraph>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ no</item>
          <item>ⓑ no</item>
          <item>ⓒ yes</item>
        </list>
      </solution>
    </exercise>
    <exercise number="286" has_solution="false">
      <problem>
        <paragraph>$$y + 0.6 = -3.4$$ ⓐ $$y = -4$$ ⓑ $$y = -2.8$$ ⓒ $$y = 2.6$$</paragraph>
      </problem>
    </exercise>
    <exercise number="287" has_solution="true">
      <problem>
        <paragraph>$$\frac{h}{1.5} = -4.3$$ ⓐ $$h = 6.45$$ ⓑ $$h = -6.45$$ ⓒ $$h = -2.1$$</paragraph>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ no</item>
          <item>ⓑ yes</item>
          <item>ⓒ no</item>
        </list>
      </solution>
    </exercise>
