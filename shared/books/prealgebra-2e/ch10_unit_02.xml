  <example number="10.27">
    <problem>
      <paragraph>Multiply: $${\left( {\frac{3}{4} c^{3}d} \right){({12cd^{2}})}}.$$</paragraph>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell/>
            <cell>$$\left( \frac{3}{4} c^{3}d \right)(12cd^{2})$$</cell>
          </row>
          <row>
            <cell>Use the Commutative Property to rearrange the factors.</cell>
            <cell>$$\frac{3}{4} \cdot 12 \cdot c^{3} \cdot c \cdot d \cdot d^{2}$$</cell>
          </row>
          <row>
            <cell>Multiply.</cell>
            <cell>$$9c^{4}d^{3}$$</cell>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
