            <cell>$${({- 7x^{3}y^{4}})}^{2}$$</cell>
          </row>
          <row>
            <cell>Take each factor to the second power.</cell>
            <cell>$${(-7)}^{2}{(x^{3})}^{2}{(y^{4})}^{2}$$</cell>
          </row>
          <row>
            <cell>Use the Power Property.</cell>
            <cell>$$49x^{6}y^{8}$$</cell>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
  <note type="practice" source_type="Try It" title="Try It" number="10.45">
