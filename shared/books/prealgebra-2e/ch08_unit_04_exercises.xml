    <heading level="1">Everyday Math</heading>
    <exercise number="249" has_solution="true">
      <problem>
        <paragraph>Coins Taylor has $$\text{\$2.00}$$ in dimes and pennies. The number of pennies is $$2$$ more than the number of dimes. Solve the equation $$0.10d + 0.01(d + 2) = 2$$ for $$d,$$ the number of dimes.</paragraph>
      </problem>
      <solution>
        <paragraph>d = 18</paragraph>
      </solution>
    </exercise>
    <exercise number="250" has_solution="false">
      <problem>
        <paragraph>Stamps Travis bought $$\text{\$9.45}$$ worth of $$\text{49-cent}$$ stamps and $$\text{21-cent}$$ stamps. The number of $$\text{21-cent}$$ stamps was $$5$$ less than the number of $$\text{49-cent}$$ stamps. Solve the equation $$0.49s + 0.21(s - 5) = 9.45$$ for $$s,$$ to find the number of $$\text{49-cent}$$ stamps Travis bought.</paragraph>
      </problem>
    </exercise>
