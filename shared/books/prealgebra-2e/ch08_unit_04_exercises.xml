<section>
  <exercises>
    <heading level="1">Section 8.4 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Solve equations with fraction coefficients</paragraph>
    <paragraph>In the following exercises, solve the equation by clearing the fractions.</paragraph>
    <exercise number="209" has_solution="true">
      <problem>
        <paragraph>$$\frac{1}{4} x - \frac{1}{2} = - \frac{3}{4}$$</paragraph>
      </problem>
      <solution>
        <paragraph>x = −1</paragraph>
      </solution>
    </exercise>
    <exercise number="210" has_solution="false">
      <problem>
        <paragraph>$$\frac{3}{4} x - \frac{1}{2} = \frac{1}{4}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="211" has_solution="true">
      <problem>
        <paragraph>$$\frac{5}{6} y - \frac{2}{3} = - \frac{3}{2}$$</paragraph>
      </problem>
      <solution>
        <paragraph>y = −1</paragraph>
      </solution>
    </exercise>
    <exercise number="212" has_solution="false">
      <problem>
        <paragraph>$$\frac{5}{6} y - \frac{1}{3} = - \frac{7}{6}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="213" has_solution="true">
      <problem>
        <paragraph>$$\frac{1}{2} a + \frac{3}{8} = \frac{3}{4}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$a = 3 4 a = 3 4$$</paragraph>
      </solution>
    </exercise>
    <exercise number="214" has_solution="false">
      <problem>
        <paragraph>$$\frac{5}{8} b + \frac{1}{2} = - \frac{3}{4}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="215" has_solution="true">
      <problem>
        <paragraph>$$2 = \frac{1}{3} x - \frac{1}{2} x + \frac{2}{3} x$$</paragraph>
      </problem>
      <solution>
        <paragraph>x = 4</paragraph>
      </solution>
    </exercise>
    <exercise number="216" has_solution="false">
      <problem>
        <paragraph>$$2 = \frac{3}{5} x - \frac{1}{3} x + \frac{2}{5} x$$</paragraph>
      </problem>
    </exercise>
    <exercise number="217" has_solution="true">
      <problem>
        <paragraph>$$\frac{1}{4} m - \frac{4}{5} m + \frac{1}{2} m = -1$$</paragraph>
      </problem>
      <solution>
        <paragraph>m = 20</paragraph>
      </solution>
    </exercise>
    <exercise number="218" has_solution="false">
      <problem>
        <paragraph>$$\frac{5}{6} n - \frac{1}{4} n - \frac{1}{2} n = -2$$</paragraph>
      </problem>
    </exercise>
    <exercise number="219" has_solution="true">
      <problem>
        <paragraph>$$x + \frac{1}{2} = \frac{2}{3} x - \frac{1}{2}$$</paragraph>
      </problem>
      <solution>
        <paragraph>x = −3</paragraph>
      </solution>
    </exercise>
    <exercise number="220" has_solution="false">
      <problem>
        <paragraph>$$x + \frac{3}{4} = \frac{1}{2} x - \frac{5}{4}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="221" has_solution="true">
      <problem>
        <paragraph>$$\frac{1}{3} w + \frac{5}{4} = w - \frac{1}{4}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$w = 9 4 w = 9 4$$</paragraph>
      </solution>
    </exercise>
    <exercise number="222" has_solution="false">
      <problem>
        <paragraph>$$\frac{3}{2} z + \frac{1}{3} = z - \frac{2}{3}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="223" has_solution="true">
      <problem>
        <paragraph>$$\frac{1}{2} x - \frac{1}{4} = \frac{1}{12} x + \frac{1}{6}$$</paragraph>
      </problem>
      <solution>
        <paragraph>x = 1</paragraph>
      </solution>
    </exercise>
    <exercise number="224" has_solution="false">
      <problem>
        <paragraph>$$\frac{1}{2} a - \frac{1}{4} = \frac{1}{6} a + \frac{1}{12}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="225" has_solution="true">
      <problem>
        <paragraph>$$\frac{1}{3} b + \frac{1}{5} = \frac{2}{5} b - \frac{3}{5}$$</paragraph>
      </problem>
      <solution>
        <paragraph>b = 12</paragraph>
      </solution>
    </exercise>
    <exercise number="226" has_solution="false">
      <problem>
        <paragraph>$$\frac{1}{3} x + \frac{2}{5} = \frac{1}{5} x - \frac{2}{5}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="227" has_solution="true">
      <problem>
        <paragraph>$$1 = \frac{1}{6}{({12x - 6})}$$</paragraph>
      </problem>
      <solution>
        <paragraph>x = 1</paragraph>
      </solution>
    </exercise>
    <exercise number="228" has_solution="false">
      <problem>
        <paragraph>$$1 = \frac{1}{5}{({15x - 10})}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="229" has_solution="true">
      <problem>
        <paragraph>$$\frac{1}{4}{({p - 7})} = \frac{1}{3}{({p + 5})}$$</paragraph>
      </problem>
      <solution>
        <paragraph>p = −41</paragraph>
      </solution>
    </exercise>
    <exercise number="230" has_solution="false">
      <problem>
        <paragraph>$$\frac{1}{5}{({q + 3})} = \frac{1}{2}{({q - 3})}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="231" has_solution="true">
      <problem>
        <paragraph>$$\frac{1}{2}{({x + 4})} = \frac{3}{4}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x = - 5 2 x = - 5 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="232" has_solution="false">
      <problem>
        <paragraph>$$\frac{1}{3}{({x + 5})} = \frac{5}{6}$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Solve Equations with Decimal Coefficients</paragraph>
    <paragraph>In the following exercises, solve the equation by clearing the decimals.</paragraph>
    <exercise number="233" has_solution="true">
