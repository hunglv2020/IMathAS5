    <paragraph>Add and Subtract Polynomials</paragraph>
    <paragraph>In the following exercises, add or subtract the polynomials.</paragraph>
    <exercise number="27" has_solution="true">
      <problem>
        <paragraph>$$(4y^{2} + 10y + 3) + (8y^{2} - 6y + 5)$$</paragraph>
      </problem>
      <solution>
        <paragraph>12y2 + 4y + 8</paragraph>
      </solution>
    </exercise>
    <exercise number="28" has_solution="false">
      <problem>
        <paragraph>$$(7x^{2} - 9x + 2) + (6x^{2} - 4x + 3)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="29" has_solution="true">
      <problem>
        <paragraph>$$(x^{2} + 6x + 8) + (-4x^{2} + 11x - 9)$$</paragraph>
      </problem>
      <solution>
        <paragraph>−3x2 + 17x − 1</paragraph>
      </solution>
    </exercise>
    <exercise number="30" has_solution="false">
      <problem>
        <paragraph>$$(y^{2} + 9y + 4) + (-2y^{2} - 5y - 1)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="31" has_solution="true">
      <problem>
        <paragraph>$$(3a^{2} + 7) + (a^{2} - 7a - 18)$$</paragraph>
      </problem>
      <solution>
        <paragraph>4a2 − 7a − 11</paragraph>
      </solution>
    </exercise>
    <exercise number="32" has_solution="false">
      <problem>
        <paragraph>$$(p^{2} - 5p - 11) + (3p^{2} + 9)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="33" has_solution="true">
      <problem>
        <paragraph>$$(6m^{2} - 9m - 3) - (2m^{2} + m - 5)$$</paragraph>
      </problem>
      <solution>
        <paragraph>4m2 − 10m + 2</paragraph>
      </solution>
    </exercise>
    <exercise number="34" has_solution="false">
      <problem>
        <paragraph>$$(3n^{2} - 4n + 1) - (4n^{2} - n - 2)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="35" has_solution="true">
      <problem>
        <paragraph>$$(z^{2} + 8z + 9) - (z^{2} - 3z + 1)$$</paragraph>
      </problem>
      <solution>
