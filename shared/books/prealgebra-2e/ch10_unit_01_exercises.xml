<section>
  <exercises>
    <heading level="1">Section 10.1 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Identify Polynomials, Monomials, Binomials and Trinomials</paragraph>
    <paragraph>In the following exercises, determine if each of the polynomials is a monomial, binomial, trinomial, or other polynomial.</paragraph>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>$$5x + 2$$</paragraph>
      </problem>
      <solution>
        <paragraph>binomial</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>$$z^{2} - 5z - 6$$</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>$$a^{2} + 9a + 18$$</paragraph>
      </problem>
      <solution>
        <paragraph>trinomial</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>$$-12p^{4}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="5" has_solution="true">
      <problem>
        <paragraph>$$y^{3} - 8y^{2} + 2y - 16$$</paragraph>
      </problem>
      <solution>
        <paragraph>polynomial</paragraph>
      </solution>
    </exercise>
    <exercise number="6" has_solution="false">
      <problem>
        <paragraph>$$10 - 9x$$</paragraph>
      </problem>
    </exercise>
    <exercise number="7" has_solution="true">
      <problem>
        <paragraph>$$23y^{2}$$</paragraph>
      </problem>
      <solution>
        <paragraph>monomial</paragraph>
      </solution>
    </exercise>
    <exercise number="8" has_solution="false">
      <problem>
        <paragraph>$$m^{4} + 4m^{3} + 6m^{2} + 4m + 1$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Determine the Degree of Polynomials</paragraph>
    <paragraph>In the following exercises, determine the degree of each polynomial.</paragraph>
    <exercise number="9" has_solution="true">
      <problem>
        <paragraph>$$8a^{5} - 2a^{3} + 1$$</paragraph>
      </problem>
      <solution>
        <paragraph>5</paragraph>
      </solution>
    </exercise>
    <exercise number="10" has_solution="false">
      <problem>
        <paragraph>$$5c^{3} + 11c^{2} - c - 8$$</paragraph>
      </problem>
    </exercise>
    <exercise number="11" has_solution="true">
      <problem>
        <paragraph>$$3x - 12$$</paragraph>
      </problem>
      <solution>
        <paragraph>1</paragraph>
      </solution>
    </exercise>
    <exercise number="12" has_solution="false">
