    <exercise number="14" has_solution="false">
      <problem>
        <paragraph>$$-22$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Add and Subtract Monomials</paragraph>
    <paragraph>In the following exercises, add or subtract the monomials.</paragraph>
