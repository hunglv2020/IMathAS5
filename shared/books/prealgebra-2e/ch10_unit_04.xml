            <cell/>
            <cell>$$\left( {7z} \right)^{0}$$</cell>
          </row>
          <row>
            <cell>Use the definition of the zero exponent.</cell>
            <cell>1</cell>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
