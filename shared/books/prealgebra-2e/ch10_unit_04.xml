      <list type="ordered">
        <item>ⓐ $$\left( \frac{5}{8} \right)^{2}$$</item>
        <item>ⓑ $$\left( \frac{x}{3} \right)^{4}$$</item>
        <item>ⓒ $$\left( \frac{y}{m} \right)^{3}$$</item>
      </list>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell>ⓐ</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell/>
          </row>
          <row>
            <cell>Use the Quotient to a Power Property, $$\left( \frac{a}{b} \right)^{m} = \frac{a^{m}}{b^{m}}$$ .</cell>
            <cell/>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell/>
          </row>
        </tbody>
      </table>
      <table>
        <tbody>
          <row>
            <cell>ⓑ</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell/>
          </row>
          <row>
            <cell>Use the Quotient to a Power Property, $$\left( \frac{a}{b} \right)^{m} = \frac{a^{m}}{b^{m}}$$ .</cell>
            <cell/>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell/>
          </row>
        </tbody>
      </table>
      <table>
        <tbody>
          <row>
            <cell>ⓒ</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell/>
          </row>
          <row>
            <cell>Raise the numerator and denominator to the third power.</cell>
            <cell/>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
