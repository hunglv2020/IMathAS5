    <heading level="1">Everyday Math</heading>
    <exercise number="65" has_solution="false">
      <problem>
        <paragraph>Basketball In the 2014 NBA playoffs, the San Antonio Spurs beat the Miami Heat. The table below shows the heights of the starters on each team. Use this table to fill in the appropriate symbol $$\text{(=} , \text{&lt;} , \text{&gt;)} .$$</paragraph>
        <table>
          <thead>
            <row>
              <cell header="true">Spurs</cell>
              <cell header="true">Height</cell>
              <cell header="true"/>
              <cell header="true">Heat</cell>
              <cell header="true">Height</cell>
            </row>
          </thead>
          <tbody>
            <row>
              <cell>Tim Duncan</cell>
              <cell>$$\text{83''}$$</cell>
              <cell/>
              <cell>Rashard Lewis</cell>
              <cell>$$\text{82''}$$</cell>
            </row>
            <row>
              <cell>Boris Diaw</cell>
              <cell>$$\text{80''}$$</cell>
              <cell>LeBron James</cell>
              <cell>$$\text{80''}$$</cell>
            </row>
            <row>
              <cell>Kawhi Leonard</cell>
              <cell>$$\text{79''}$$</cell>
              <cell>Chris Bosh</cell>
              <cell>$$\text{83''}$$</cell>
            </row>
            <row>
              <cell>Tony Parker</cell>
              <cell>$$\text{74''}$$</cell>
              <cell>Dwyane Wade</cell>
              <cell>$$\text{76''}$$</cell>
            </row>
            <row>
              <cell>Danny Green</cell>
              <cell>$$\text{78''}$$</cell>
              <cell>Ray Allen</cell>
              <cell>$$\text{77''}$$</cell>
            </row>
          </tbody>
        </table>
        <list type="ordered">
          <item>ⓐ Height of Tim Duncan____Height of Rashard Lewis</item>
          <item>ⓑ Height of Boris Diaw____Height of LeBron James</item>
          <item>ⓒ Height of Kawhi Leonard____Height of Chris Bosh</item>
          <item>ⓓ Height of Tony Parker____Height of Dwyane Wade</item>
          <item>ⓔ Height of Danny Green____Height of Ray Allen</item>
        </list>
      </problem>
    </exercise>
