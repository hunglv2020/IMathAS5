<section>
  <exercises>
    <heading level="1">Section 2.1 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Use Variables and Algebraic Symbols</paragraph>
    <paragraph>In the following exercises, translate from algebraic notation to words.</paragraph>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>$$16 - 9$$</paragraph>
      </problem>
      <solution>
        <paragraph>16 minus 9, the difference of sixteen and nine</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>$$25 - 7$$</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>$$5 \cdot 6$$</paragraph>
      </problem>
      <solution>
        <paragraph>5 times 6, the product of five and six</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>$$3 \cdot 9$$</paragraph>
      </problem>
    </exercise>
    <exercise number="5" has_solution="true">
      <problem>
        <paragraph>$$28 \div 4$$</paragraph>
      </problem>
      <solution>
        <paragraph>28 divided by 4, the quotient of twenty-eight and four</paragraph>
      </solution>
    </exercise>
    <exercise number="6" has_solution="false">
      <problem>
        <paragraph>$$45 \div 5$$</paragraph>
      </problem>
    </exercise>
    <exercise number="7" has_solution="true">
      <problem>
        <paragraph>$$x + 8$$</paragraph>
      </problem>
      <solution>
        <paragraph>x plus 8, the sum of x and eight</paragraph>
      </solution>
    </exercise>
    <exercise number="8" has_solution="false">
      <problem>
        <paragraph>$$x + 11$$</paragraph>
      </problem>
    </exercise>
    <exercise number="9" has_solution="true">
      <problem>
        <paragraph>$$(2)(7)$$</paragraph>
      </problem>
      <solution>
        <paragraph>2 times 7, the product of two and seven</paragraph>
      </solution>
    </exercise>
    <exercise number="10" has_solution="false">
      <problem>
        <paragraph>$$(4)(8)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="11" has_solution="true">
      <problem>
        <paragraph>$$14 &lt; 21$$</paragraph>
      </problem>
      <solution>
        <paragraph>fourteen is less than twenty-one</paragraph>
      </solution>
    </exercise>
    <exercise number="12" has_solution="false">
      <problem>
        <paragraph>$$17 &lt; 35$$</paragraph>
      </problem>
    </exercise>
    <exercise number="13" has_solution="true">
      <problem>
        <paragraph>$$36 \geq 19$$</paragraph>
      </problem>
      <solution>
        <paragraph>thirty-six is greater than or equal to nineteen</paragraph>
      </solution>
    </exercise>
    <exercise number="14" has_solution="false">
      <problem>
        <paragraph>$$42 \geq 27$$</paragraph>
      </problem>
    </exercise>
    <exercise number="15" has_solution="true">
      <problem>
        <paragraph>$$3n = 24$$</paragraph>
      </problem>
      <solution>
        <paragraph>3 times n equals 24, the product of three and n equals twenty-four</paragraph>
      </solution>
    </exercise>
    <exercise number="16" has_solution="false">
      <problem>
        <paragraph>$$6n = 36$$</paragraph>
      </problem>
    </exercise>
    <exercise number="17" has_solution="true">
      <problem>
        <paragraph>$$y - 1 &gt; 6$$</paragraph>
      </problem>
      <solution>
        <paragraph>y minus 1 is greater than 6, the difference of y and one is greater than six</paragraph>
      </solution>
    </exercise>
    <exercise number="18" has_solution="false">
      <problem>
        <paragraph>$$y - 4 &gt; 8$$</paragraph>
      </problem>
    </exercise>
    <exercise number="19" has_solution="true">
      <problem>
        <paragraph>$$2 \leq 18 \div 6$$</paragraph>
      </problem>
      <solution>
        <paragraph>2 is less than or equal to 18 divided by 6; 2 is less than or equal to the quotient of eighteen and six</paragraph>
      </solution>
    </exercise>
    <exercise number="20" has_solution="false">
      <problem>
        <paragraph>$$3 \leq 20 \div 4$$</paragraph>
      </problem>
    </exercise>
    <exercise number="21" has_solution="true">
      <problem>
        <paragraph>$$a \neq 7 \cdot 4$$</paragraph>
      </problem>
      <solution>
        <paragraph>a is not equal to 7 times 4, a is not equal to the product of seven and four</paragraph>
      </solution>
    </exercise>
    <exercise number="22" has_solution="false">
      <problem>
        <paragraph>$$a \neq 1 \cdot 12$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Identify Expressions and Equations</paragraph>
    <paragraph>In the following exercises, determine if each is an expression or an equation.</paragraph>
    <exercise number="23" has_solution="true">
      <problem>
        <paragraph>$$9 \cdot 6 = 54$$</paragraph>
      </problem>
      <solution>
        <paragraph>equation</paragraph>
      </solution>
    </exercise>
    <exercise number="24" has_solution="false">
      <problem>
        <paragraph>$$7 \cdot 9 = 63$$</paragraph>
      </problem>
    </exercise>
    <exercise number="25" has_solution="true">
      <problem>
        <paragraph>$$5 \cdot 4 + 3$$</paragraph>
      </problem>
      <solution>
        <paragraph>expression</paragraph>
      </solution>
    </exercise>
    <exercise number="26" has_solution="false">
      <problem>
        <paragraph>$$6 \cdot 3 + 5$$</paragraph>
      </problem>
    </exercise>
    <exercise number="27" has_solution="true">
      <problem>
        <paragraph>$$x + 7$$</paragraph>
      </problem>
      <solution>
        <paragraph>expression</paragraph>
      </solution>
    </exercise>
    <exercise number="28" has_solution="false">
      <problem>
        <paragraph>$$x + 9$$</paragraph>
      </problem>
    </exercise>
    <exercise number="29" has_solution="true">
      <problem>
        <paragraph>$$y - 5 = 25$$</paragraph>
      </problem>
      <solution>
        <paragraph>equation</paragraph>
      </solution>
    </exercise>
    <exercise number="30" has_solution="false">
      <problem>
        <paragraph>$$y - 8 = 32$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Simplify Expressions with Exponents</paragraph>
    <paragraph>In the following exercises, write in exponential form.</paragraph>
    <exercise number="31" has_solution="true">
      <problem>
        <paragraph>$$3 \cdot 3 \cdot 3 \cdot 3 \cdot 3 \cdot 3 \cdot 3$$</paragraph>
      </problem>
      <solution>
        <paragraph>37</paragraph>
      </solution>
    </exercise>
    <exercise number="32" has_solution="false">
      <problem>
        <paragraph>$$4 \cdot 4 \cdot 4 \cdot 4 \cdot 4 \cdot 4$$</paragraph>
      </problem>
    </exercise>
    <exercise number="33" has_solution="true">
      <problem>
        <paragraph>$$x \cdot x \cdot x \cdot x \cdot x$$</paragraph>
      </problem>
      <solution>
        <paragraph>x 5</paragraph>
      </solution>
    </exercise>
    <exercise number="34" has_solution="false">
      <problem>
        <paragraph>$$y \cdot y \cdot y \cdot y \cdot y \cdot y$$</paragraph>
      </problem>
    </exercise>
    <paragraph>In the following exercises, write in expanded form.</paragraph>
    <exercise number="35" has_solution="true">
      <problem>
        <paragraph>$$5^{3}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$5 \cdot 5 \cdot 5 5 \cdot 5 \cdot 5$$</paragraph>
      </solution>
    </exercise>
    <exercise number="36" has_solution="false">
      <problem>
        <paragraph>$$8^{3}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="37" has_solution="true">
      <problem>
        <paragraph>$$2^{8}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2 \cdot 2 \cdot 2 \cdot 2 \cdot 2 \cdot 2 \cdot 2 \cdot 2 2 \cdot 2 \cdot 2 \cdot 2 \cdot 2 \cdot 2 \cdot 2 \cdot 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="38" has_solution="false">
      <problem>
        <paragraph>$$10^{5}$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Simplify Expressions Using the Order of Operations</paragraph>
    <paragraph>In the following exercises, simplify.</paragraph>
    <exercise number="39" has_solution="true">
      <problem>
        <list type="ordered">
          <item>ⓐ $$3 + 8 \cdot 5$$</item>
          <item>ⓑ $$\text{(3+8)} \cdot 5$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ 43</item>
          <item>ⓑ 55</item>
        </list>
      </solution>
    </exercise>
    <exercise number="40" has_solution="false">
      <problem>
        <list type="ordered">
          <item>ⓐ $$2 + 6 \cdot 3$$</item>
          <item>ⓑ $$\text{(2+6)} \cdot 3$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="41" has_solution="true">
      <problem>
        <paragraph>$$2^{3} - 12 \div (9 - 5)$$</paragraph>
      </problem>
      <solution>
        <paragraph>5</paragraph>
      </solution>
    </exercise>
    <exercise number="42" has_solution="false">
      <problem>
        <paragraph>$$3^{2} - 18 \div (11 - 5)$$</paragraph>
      </problem>
    </exercise>
