  <example number="10.31">
    <problem>
      <paragraph>Multiply: $$-2x{({5x^{2} + 7x - 3})}.$$</paragraph>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell/>
            <cell>$$-2x{({5x^{2} + 7x - 3})}$$</cell>
          </row>
          <row>
            <cell>Distribute.</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell>$$-2x \cdot 5x^{2} + (-2x) \cdot 7x - (-2x) \cdot 3$$</cell>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell>$$-10x^{3} - 14x^{2} + 6x$$</cell>
          </row>
        </tbody>
      </table>
    </solution>
