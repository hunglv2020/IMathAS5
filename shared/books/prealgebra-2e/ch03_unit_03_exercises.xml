    <paragraph>Translate Word Phrases to Algebraic Expressions</paragraph>
    <paragraph>In the following exercises, translate each phrase into an algebraic expression and then simplify.</paragraph>
    <exercise number="187" has_solution="true">
      <problem>
        <list type="ordered">
          <item>ⓐ The difference of $$3$$ and $$-10$$</item>
          <item>ⓑ Subtract $$-20$$ from $$45$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ 3 − (−10) = 13</item>
          <item>ⓑ 45 − (−20) = 65</item>
        </list>
      </solution>
    </exercise>
    <exercise number="188" has_solution="false">
