      </solution>
    </exercise>
    <exercise number="332" has_solution="false">
      <problem>
        <paragraph>$$f(x) = 2x^{3} - 6x - 24$$ divided by $$x - 3$$</paragraph>
      </problem>
    </exercise>
    <exercise number="333" has_solution="true">
