<section>
  <exercises>
    <heading level="1">Section 5.4 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Divide Monomials</paragraph>
    <paragraph>In the following exercises, divide the monomials.</paragraph>
    <exercise number="288" has_solution="false">
      <problem>
        <paragraph>$$15r^{4}s^{9} \div \left( {15r^{4}s^{9}} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="289" has_solution="true">
      <problem>
        <paragraph>$$20m^{8}n^{4} \div \left( {30m^{5}n^{9}} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2 m 3 3 n 5 2 m 3 3 n 5$$</paragraph>
      </solution>
    </exercise>
    <exercise number="290" has_solution="false">
      <problem>
        <paragraph>$$\frac{18a^{4}b^{8}}{-27a^{9}b^{5}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="291" has_solution="true">
      <problem>
        <paragraph>$$\frac{45x^{5}y^{9}}{-60x^{8}y^{6}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-3 y 3 4 x 3 -3 y 3 4 x 3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="292" has_solution="false">
      <problem>
        <paragraph>$$\frac{\left( {10m^{5}n^{4}} \right)\left( {5m^{3}n^{6}} \right)}{25m^{7}n^{5}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="293" has_solution="true">
      <problem>
        <paragraph>$$\frac{\left( {-18p^{4}q^{7}} \right)\left( {-6p^{3}q^{8}} \right)}{-36p^{12}q^{10}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-3 q 5 p 5 -3 q 5 p 5$$</paragraph>
      </solution>
    </exercise>
    <exercise number="294" has_solution="false">
      <problem>
        <paragraph>$$\frac{\left( {6a^{4}b^{3}} \right)\left( {4ab^{5}} \right)}{\left( {12a^{2}b} \right)\left( {a^{3}b} \right)}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="295" has_solution="true">
      <problem>
        <paragraph>$$\frac{\left( {4u^{2}v^{5}} \right)\left( {15u^{3}v} \right)}{\left( {12u^{3}v} \right)\left( {u^{4}v} \right)}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$5 v 4 u 2 5 v 4 u 2$$</paragraph>
      </solution>
    </exercise>
    <paragraph>Divide a Polynomial by a Monomial</paragraph>
    <paragraph>In the following exercises, divide each polynomial by the monomial.</paragraph>
    <exercise number="296" has_solution="false">
      <problem>
        <paragraph>$$\left( {9n^{4} + 6n^{3}} \right) \div 3n$$</paragraph>
      </problem>
    </exercise>
    <exercise number="297" has_solution="true">
      <problem>
        <paragraph>$$\left( {8x^{3} + 6x^{2}} \right) \div 2x$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$4 x 2 + 3 x 4 x 2 + 3 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="298" has_solution="false">
      <problem>
        <paragraph>$$\left( {63m^{4} - 42m^{3}} \right) \div \left( {-7m^{2}} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="299" has_solution="true">
      <problem>
        <paragraph>$$\left( {48y^{4} - 24y^{3}} \right) \div \left( {-8y^{2}} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-6 y 2 + 3 y -6 y 2 + 3 y$$</paragraph>
      </solution>
    </exercise>
    <exercise number="300" has_solution="false">
      <problem>
        <paragraph>$$\frac{66x^{3}y^{2} - 110x^{2}y^{3} - 44x^{4}y^{3}}{11x^{2}y^{2}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="301" has_solution="true">
      <problem>
        <paragraph>$$\frac{72r^{5}s^{2} + 132r^{4}s^{3} - 96r^{3}s^{5}}{12r^{2}s^{2}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$6 r 3 + 11 r 2 s - 8 r s 3 6 r 3 + 11 r 2 s - 8 r s 3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="302" has_solution="false">
      <problem>
        <paragraph>$$\frac{10x^{2} + 5x - 4}{-5x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="303" has_solution="true">
      <problem>
        <paragraph>$$\frac{20y^{2} + 12y - 1}{-4y}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-5 y - 3 + 1 4 y -5 y - 3 + 1 4 y$$</paragraph>
      </solution>
    </exercise>
    <paragraph>Divide Polynomials using Long Division</paragraph>
    <paragraph>In the following exercises, divide each polynomial by the binomial.</paragraph>
    <exercise number="304" has_solution="false">
      <problem>
        <paragraph>$$\left( {y^{2} + 7y + 12} \right) \div \left( {y + 3} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="305" has_solution="true">
      <problem>
        <paragraph>$$\left( {a^{2} - 2a - 35} \right) \div \left( {a + 5} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$a - 7 a - 7$$</paragraph>
      </solution>
    </exercise>
    <exercise number="306" has_solution="false">
      <problem>
        <paragraph>$$\left( {6m^{2} - 19m - 20} \right) \div \left( {m - 4} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="307" has_solution="true">
      <problem>
        <paragraph>$$\left( {4x^{2} - 17x - 15} \right) \div \left( {x - 5} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$4 x + 3 4 x + 3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="308" has_solution="false">
      <problem>
        <paragraph>$$\left( {q^{2} + 2q + 20} \right) \div \left( {q + 6} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="309" has_solution="true">
      <problem>
        <paragraph>$$\left( {p^{2} + 11p + 16} \right) \div \left( {p + 8} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$p + 3 - 8 p + 8 p + 3 - 8 p + 8$$</paragraph>
      </solution>
    </exercise>
    <exercise number="310" has_solution="false">
      <problem>
        <paragraph>$$\left( {3b^{3} + b^{2} + 4} \right) \div \left( {b + 1} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="311" has_solution="true">
      <problem>
        <paragraph>$$\left( {2n^{3} - 10n + 28} \right) \div \left( {n + 3} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2 n 2 - 6 n + 8 + 4 n + 3 2 n 2 - 6 n + 8 + 4 n + 3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="312" has_solution="false">
      <problem>
        <paragraph>$$\left( {z^{3} + 1} \right) \div \left( {z + 1} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="313" has_solution="true">
      <problem>
        <paragraph>$$\left( {m^{3} + 1000} \right) \div \left( {m + 10} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$m 2 - 10 m + 100 m 2 - 10 m + 100$$</paragraph>
      </solution>
    </exercise>
    <exercise number="314" has_solution="false">
      <problem>
        <paragraph>$$\left( {64x^{3} - 27} \right) \div \left( {4x - 3} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="315" has_solution="true">
      <problem>
        <paragraph>$$\left( {125y^{3} - 64} \right) \div \left( {5y - 4} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$25 y 2 + 20 y + 16 25 y 2 + 20 y + 16$$</paragraph>
      </solution>
    </exercise>
    <paragraph>Divide Polynomials using Synthetic Division</paragraph>
    <paragraph>In the following exercises, use synthetic Division to find the quotient and remainder.</paragraph>
    <exercise number="316" has_solution="false">
      <problem>
        <paragraph>$$x^{3} - 6x^{2} + 5x + 14$$ is divided by $$x + 1$$</paragraph>
      </problem>
    </exercise>
    <exercise number="317" has_solution="true">
      <problem>
        <paragraph>$$x^{3} - 3x^{2} - 4x + 12$$ is divided by $$x + 2$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x 2 - 5 x + 6 ; 0 x 2 - 5 x + 6 ; 0$$</paragraph>
      </solution>
    </exercise>
    <exercise number="318" has_solution="false">
      <problem>
        <paragraph>$$2x^{3} - 11x^{2} + 11x + 12$$ is divided by $$x - 3$$</paragraph>
      </problem>
    </exercise>
    <exercise number="319" has_solution="true">
      <problem>
        <paragraph>$$2x^{3} - 11x^{2} + 16x - 12$$ is divided by $$x - 4$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2 x 2 - 3 x + 4 ; 4 2 x 2 - 3 x + 4 ; 4$$</paragraph>
      </solution>
    </exercise>
    <exercise number="320" has_solution="false">
      <problem>
        <paragraph>$$x^{4} - 5x^{2} + 13x + 3$$ is divided by $$x + 3$$</paragraph>
      </problem>
    </exercise>
    <exercise number="321" has_solution="true">
      <problem>
        <paragraph>$$x^{4} + x^{2} + 6x - 10$$ is divided by $$x + 2$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x 3 - 2 x 2 + 5 x - 4 ; - 2 x 3 - 2 x 2 + 5 x - 4 ; - 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="322" has_solution="false">
      <problem>
        <paragraph>$$2x^{4} - 9x^{3} + 5x^{2} - 3x - 6$$ is divided by $$x - 4$$</paragraph>
      </problem>
    </exercise>
    <exercise number="323" has_solution="true">
      <problem>
        <paragraph>$$3x^{4} - 11x^{3} + 2x^{2} + 10x + 6$$ is divided by $$x - 3$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$3 x 3 - 2 x 2 - 4 x - 2 ; 0 3 x 3 - 2 x 2 - 4 x - 2 ; 0$$</paragraph>
      </solution>
    </exercise>
    <paragraph>Divide Polynomial Functions</paragraph>
    <paragraph>In the following exercises, divide.</paragraph>
    <exercise number="324" has_solution="false">
      <problem>
        <paragraph>For functions $$f(x) = x^{2} - 13x + 36$$ and $$g(x) = x - 4,$$ find ⓐ $$\left( \frac{f}{g} \right)(x)$$ ⓑ $$\left( \frac{f}{g} \right)(-1)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="325" has_solution="true">
      <problem>
        <paragraph>For functions $$f(x) = x^{2} - 15x + 54$$ and $$g(x) = x - 9,$$ find ⓐ $$\left( \frac{f}{g} \right)(x)$$ ⓑ $$\left( \frac{f}{g} \right)(-5)$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ $$(fg)(x)=x-6(fg)(x)=x-6$$ ⓑ $$(fg)(-5)=-11(fg)(-5)=-11$$</paragraph>
      </solution>
    </exercise>
    <exercise number="326" has_solution="false">
      <problem>
        <paragraph>For functions $$f(x) = x^{3} + x^{2} - 7x + 2$$ and $$g(x) = x - 2,$$ find ⓐ $$\left( \frac{f}{g} \right)(x)$$ ⓑ $$\left( \frac{f}{g} \right)(2)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="327" has_solution="true">
      <problem>
        <paragraph>For functions $$f(x) = x^{3} + 2x^{2} - 19x + 12$$ and $$g(x) = x - 3,$$ find ⓐ $$\left( \frac{f}{g} \right)(x)$$ ⓑ $$\left( \frac{f}{g} \right)(0)$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ $$(fg)(x)=x2+5x-4(fg)(x)=x2+5x-4$$ ⓑ $$(fg)(0)=-4(fg)(0)=-4$$</paragraph>
      </solution>
    </exercise>
    <exercise number="328" has_solution="false">
      <problem>
        <paragraph>For functions $$f(x) = x^{2} - 3x + 2$$ and $$g(x) = x + 3,$$ find ⓐ $$\left( \frac{f}{g} \right)(x)$$ ⓑ $$\left( \frac{f}{g} \right)(3)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="329" has_solution="true">
      <problem>
        <paragraph>For functions $$f(x) = x^{2} + 2x - 3$$ and $$g(x) = x + 3$$ find ⓐ $$\left( \frac{f}{g} \right)(x)$$ ⓑ $$\left( \frac{f}{g} \right)(3)$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ $$fgx=x-1;x\ne -3fgx=x-1;x\ne -3$$ ⓑ $$fg3=2fg3=2$$</paragraph>
      </solution>
    </exercise>
    <paragraph>Use the Remainder and Factor Theorem</paragraph>
    <paragraph>In the following exercises, use the Remainder Theorem to find the remainder.</paragraph>
    <exercise number="330" has_solution="false">
      <problem>
        <paragraph>$$f(x) = x^{3} - 8x + 7$$ is divided by $$x + 3$$</paragraph>
      </problem>
    </exercise>
    <exercise number="331" has_solution="true">
      <problem>
        <paragraph>$$f(x) = x^{3} - 4x - 9$$ is divided by $$x + 2$$</paragraph>
      </problem>
      <solution>
