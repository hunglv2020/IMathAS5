    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Find an Equation of the Line Given the Slope and y-Intercept</paragraph>
    <paragraph>In the following exercises, find the equation of a line with given slope and y-intercept. Write the equation in slope-intercept form.</paragraph>
    <exercise number="155" has_solution="true">
      <problem>
        <paragraph>slope 3 and $$y$$ -intercept $$\left( {0,5} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = 3 x + 5 y = 3 x + 5$$</paragraph>
      </solution>
    </exercise>
    <exercise number="156" has_solution="false">
      <problem>
        <paragraph>slope 8 andy-intercept $$\left( {0,-6} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="157" has_solution="true">
      <problem>
        <paragraph>slope $$-3$$ and $$y$$ -intercept $$\left( {0,-1} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = -3 x - 1 y = -3 x - 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="158" has_solution="false">
      <problem>
        <paragraph>slope $$-1$$ and $$y$$ -intercept $$\left( {0,3} \right)$$</paragraph>
      </problem>
    </exercise>
