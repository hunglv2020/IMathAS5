    <paragraph>Evaluate an Expression</paragraph>
    <paragraph>In the following exercises, evaluate the following expressions.</paragraph>
    <exercise number="31" has_solution="true">
      <problem>
        <paragraph>When $$x = 2,$$ ⓐ $$x^{6}$$ ⓑ $$4^{x}$$ ⓒ $$2x^{2} + 3x - 7$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ 64 ⓑ 16 ⓒ 7</paragraph>
      </solution>
    </exercise>
    <exercise number="32" has_solution="false">
      <problem>
        <paragraph>When $$x = 3,$$ ⓐ $$x^{5}$$ ⓑ $$5^{x}$$ ⓒ $$3x^{2} - 4x - 8$$</paragraph>
      </problem>
    </exercise>
    <exercise number="33" has_solution="true">
      <problem>
        <paragraph>When $$x = 4,y = 1$$ $$x^{2} + 3xy - 7y^{2}$$</paragraph>
      </problem>
      <solution>
