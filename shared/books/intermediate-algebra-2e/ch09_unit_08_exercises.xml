<section>
  <exercises>
    <heading level="1">Section 9.8 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Solve Quadratic Inequalities Graphically</paragraph>
    <paragraph>In the following exercises, ⓐ solve graphically and ⓑ write the solution in interval notation.</paragraph>
    <exercise number="363" has_solution="true">
      <problem>
        <paragraph>$$x^{2} + 6x + 5 &gt; 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ</paragraph>
        <paragraph>ⓑ $$(-\infty ,-5)\cup (-1,\infty )(-\infty ,-5)\cup (-1,\infty )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="364" has_solution="false">
      <problem>
        <paragraph>$$x^{2} + 4x - 12 &lt; 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="365" has_solution="true">
      <problem>
        <paragraph>$$x^{2} + 4x + 3 \leq 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ</paragraph>
        <paragraph>ⓑ $$[-3,-1][-3,-1]$$</paragraph>
      </solution>
    </exercise>
    <exercise number="366" has_solution="false">
      <problem>
        <paragraph>$$x^{2} - 6x + 8 \geq 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="367" has_solution="true">
      <problem>
        <paragraph>$$-x^{2} - 3x + 18 \leq 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ</paragraph>
        <paragraph>ⓑ $$(-\infty ,-6]\cup [3,\infty )(-\infty ,-6]\cup [3,\infty )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="368" has_solution="false">
      <problem>
        <paragraph>$$-x^{2} + 2x + 24 &lt; 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="369" has_solution="true">
      <problem>
        <paragraph>$$-x^{2} + x + 12 \geq 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ</paragraph>
        <paragraph>ⓑ $$[-3,4][-3,4]$$</paragraph>
      </solution>
    </exercise>
    <exercise number="370" has_solution="false">
      <problem>
        <paragraph>$$-x^{2} + 2x + 15 &gt; 0$$</paragraph>
      </problem>
    </exercise>
