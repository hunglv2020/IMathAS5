<section>
  <exercises>
    <heading level="1">Section 12.4 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Use Pascal’s Triangle to Expand a Binomial</paragraph>
    <paragraph>In the following exercises, expand each binomial using Pascal’s Triangle.</paragraph>
    <exercise number="192" has_solution="false">
      <problem>
        <paragraph>$$\left( {x + y} \right)^{4}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="193" has_solution="true">
      <problem>
        <paragraph>$$\left( {a + b} \right)^{8}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$a 8 + 8 a 7 b + 28 a 6 b 2 + 56 a 5 b 3 a 8 + 8 a 7 b + 28 a 6 b 2 + 56 a 5 b 3$$ $$+ 70 a 4 b 4 + 56 a 3 b 5 + 28 a 2 b 6 + 70 a 4 b 4 + 56 a 3 b 5 + 28 a 2 b 6$$ $$+ 8 a b 7 + b 8 + 8 a b 7 + b 8$$</paragraph>
      </solution>
    </exercise>
    <exercise number="194" has_solution="false">
      <problem>
        <paragraph>$$\left( {m + n} \right)^{10}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="195" has_solution="true">
      <problem>
        <paragraph>$$\left( {p + q} \right)^{9}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$p 9 + 9 p 8 q + 36 p 7 q 2 + 84 p 6 q 3 p 9 + 9 p 8 q + 36 p 7 q 2 + 84 p 6 q 3$$ $$+ 126 p 5 q 4 + 126 p 4 q 5 + 84 p 3 q 6 + 126 p 5 q 4 + 126 p 4 q 5 + 84 p 3 q 6$$ $$+ 36 p 2 q 7 + 9 p q 8 + q 9 + 36 p 2 q 7 + 9 p q 8 + q 9$$</paragraph>
      </solution>
    </exercise>
