    <paragraph>Rationalize a Two Term Denominator</paragraph>
    <paragraph>In the following exercises, simplify.</paragraph>
    <exercise number="271" has_solution="true">
      <problem>
        <paragraph>$$\frac{8}{1 - \sqrt{5}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-2 ( 1 + 5 ) -2 ( 1 + 5 )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="272" has_solution="false">
      <problem>
        <paragraph>$$\frac{7}{2 - \sqrt{6}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="273" has_solution="true">
      <problem>
        <paragraph>$$\frac{6}{3 - \sqrt{7}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$3 ( 3 + 7 ) 3 ( 3 + 7 )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="274" has_solution="false">
