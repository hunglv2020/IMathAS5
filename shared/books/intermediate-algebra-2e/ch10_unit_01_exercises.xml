    <paragraph>In the following exercises, determine whether or not the given functions are inverses.</paragraph>
    <exercise number="31" has_solution="true">
      <problem>
        <paragraph>$$f(x) = x + 8$$ and $$g(x) = x - 8$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$g(f(x))=x,g(f(x))=x,$$ and $$f(g(x))=x,f(g(x))=x,$$ so they are inverses.</paragraph>
      </solution>
    </exercise>
    <exercise number="32" has_solution="false">
      <problem>
        <paragraph>$$f(x) = x - 9$$ and $$g(x) = x + 9$$</paragraph>
      </problem>
    </exercise>
    <exercise number="33" has_solution="true">
      <problem>
        <paragraph>$$f(x) = 7x$$ and $$g(x) = \frac{x}{7}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$g(f(x))=x,g(f(x))=x,$$ and $$f(g(x))=x,f(g(x))=x,$$ so they are inverses.</paragraph>
      </solution>
    </exercise>
    <exercise number="34" has_solution="false">
