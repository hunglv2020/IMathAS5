    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Use the Zero Product Property</paragraph>
    <paragraph>In the following exercises, solve.</paragraph>
    <exercise number="277" has_solution="true">
      <problem>
        <paragraph>$$\left( {3a - 10} \right)\left( {2a - 7} \right) = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$a = 10 / 3 , a = 7 / 2 a = 10 / 3 , a = 7 / 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="278" has_solution="false">
      <problem>
        <paragraph>$$\left( {5b + 1} \right)\left( {6b + 1} \right) = 0$$</paragraph>
