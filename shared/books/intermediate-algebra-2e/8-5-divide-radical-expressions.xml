  <exercises title="Section 8.5 Exercises">
    <instruction>Divide Square Roots In the following exercises, simplify.</instruction>
    <exercise number="245" has_solution="true">
      <problem>
        <p>ⓐ $$\frac{\sqrt{128}}{\sqrt{72}}$$ ⓑ $$\frac{\sqrt[3]{128}}{\sqrt[3]{54}}$$</p>
      </problem>
      <solution>
