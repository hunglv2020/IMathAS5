    <exercise number="163" has_solution="true">
      <problem>
        <paragraph>Show two different algebraic methods to simplify $$4^{\frac{3}{2}}.$$ Explain all your steps.</paragraph>
      </problem>
      <solution>
        <paragraph>Answers will vary.</paragraph>
      </solution>
    </exercise>
    <exercise number="164" has_solution="false">
      <problem>
        <paragraph>Explain why the expression $$\left( {- 16} \right)^{\frac{3}{2}}$$ cannot be evaluated.</paragraph>
      </problem>
    </exercise>
