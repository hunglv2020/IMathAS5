  <exercises>
    <heading level="1">Section 4.1 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Determine Whether an Ordered Pair is a Solution of a System of Equations</paragraph>
    <paragraph>In the following exercises, determine if the following points are solutions to the given system of equations.</paragraph>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>$$\left\{ \begin{array}{l} {y = 2x - 1} \\ {3x - 4y = - 6} \end{array} \right.$$</paragraph>
        <paragraph>ⓐ $$\left\{ \begin{array}{l} {6x - 2y = 12} \\ {3x + 7y = -13} \end{array} \right.$$ ⓑ $$\left\{ \begin{array}{l} {2x - 6y = 0} \\ {3x - 4y = 5} \end{array} \right.$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ yes ⓑ no</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>$$(3,1)$$</paragraph>
        <paragraph>ⓐ $$(-3,4)$$ ⓑ $$\left\{ \begin{array}{l} {- 3x + y = 8} \\ {- x + 2y = -9} \end{array} \right.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>$$(-5,-7)$$</paragraph>
        <paragraph>ⓐ $$(-5,7)$$ ⓑ $$\left\{ \begin{array}{l} {x + y = 2} \\ {y = \frac{3}{4}x} \end{array} \right.$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ yes ⓑ no</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>$$\left( {\frac{8}{7},\frac{6}{7}} \right)$$ ⓐ $$\left( {1,\frac{3}{4}} \right)$$ ⓑ $$\left\{ \begin{array}{l} {2x + 3y = 6} \\ {y = \frac{2}{3}x + 2} \end{array} \right.$$</paragraph>
      </problem>
    </exercise>
