      </problem>
      <solution>
        <paragraph>ⓐ $$y=0y=0$$ , ⓑ $$x=-12x=-12$$ , ⓒ $$u=-4,u=7u=-4,u=7$$</paragraph>
      </solution>
    </exercise>
