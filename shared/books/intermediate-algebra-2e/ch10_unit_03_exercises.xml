<section>
  <exercises>
    <heading level="1">Section 10.3 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Convert Between Exponential and Logarithmic Form</paragraph>
    <paragraph>In the following exercises, convert from exponential to logarithmic form.</paragraph>
    <exercise number="126" has_solution="false">
      <problem>
        <paragraph>$$4^{2} = 16$$</paragraph>
      </problem>
    </exercise>
    <exercise number="127" has_solution="true">
      <problem>
        <paragraph>$$2^{5} = 32$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$log 2 32 = 5 log 2 32 = 5$$</paragraph>
      </solution>
    </exercise>
    <exercise number="128" has_solution="false">
      <problem>
        <paragraph>$$3^{3} = 27$$</paragraph>
      </problem>
    </exercise>
    <exercise number="129" has_solution="true">
      <problem>
        <paragraph>$$5^{3} = 125$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$log 5 125 = 3 log 5 125 = 3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="130" has_solution="false">
      <problem>
        <paragraph>$$10^{3} = 1000$$</paragraph>
      </problem>
    </exercise>
    <exercise number="131" has_solution="true">
      <problem>
        <paragraph>$$10^{-2} = \frac{1}{100}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$log 1 100 = -2 log 1 100 = -2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="132" has_solution="false">
      <problem>
        <paragraph>$$x^{\frac{1}{2}} = \sqrt{3}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="133" has_solution="true">
      <problem>
        <paragraph>$$x^{\frac{1}{3}} = \sqrt[3]{6}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$log x 6 3 = 1 3 log x 6 3 = 1 3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="134" has_solution="false">
      <problem>
        <paragraph>$$32^{x} = \sqrt[4]{32}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="135" has_solution="true">
      <problem>
        <paragraph>$$17^{x} = \sqrt[5]{17}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$log 17 17 5 = x log 17 17 5 = x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="136" has_solution="false">
      <problem>
        <paragraph>$$\left( \frac{1}{4} \right)^{2} = \frac{1}{16}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="137" has_solution="true">
      <problem>
        <paragraph>$$\left( \frac{1}{3} \right)^{4} = \frac{1}{81}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$log 1 3 1 81 = 4 log 1 3 1 81 = 4$$</paragraph>
      </solution>
    </exercise>
    <exercise number="138" has_solution="false">
      <problem>
        <paragraph>$$3^{-2} = \frac{1}{9}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="139" has_solution="true">
      <problem>
        <paragraph>$$4^{-3} = \frac{1}{64}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$log 4 1 64 = -3 log 4 1 64 = -3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="140" has_solution="false">
      <problem>
        <paragraph>$$e^{x} = 6$$</paragraph>
      </problem>
    </exercise>
    <exercise number="141" has_solution="true">
      <problem>
        <paragraph>$$e^{3} = x$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$ln x = 3 ln x = 3$$</paragraph>
      </solution>
    </exercise>
