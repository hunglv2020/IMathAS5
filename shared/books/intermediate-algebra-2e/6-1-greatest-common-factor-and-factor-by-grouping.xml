<section number="6.1" title="Greatest Common Factor and Factor by Grouping">
  <learning_objectives>
    <objective number="" />
    <objective number="" />
    <objective number="" />
  </learning_objectives>
  <note type="Be Prepared" number="6.1">
    <p>Before you get started, take this readiness quiz.</p>
    <p>Factor 56 into primes.
If you missed this problem, review Example 1.2.</p>
  </note>
  <note type="Be Prepared" number="6.2">
