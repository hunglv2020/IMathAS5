      <problem>
        <paragraph>$$g(x) = \sqrt{6x + 1},$$ find ⓐ $$g(4)$$ ⓑ $$g(8).$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ $$g(4)=5g(4)=5$$ ⓑ $$g(8)=7g(8)=7$$</paragraph>
      </solution>
    </exercise>
