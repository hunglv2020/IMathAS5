<section>
  <exercises>
    <heading level="1">Section 7.6 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Solve Rational Inequalities</paragraph>
    <paragraph>In the following exercises, solve each rational inequality and write the solution in interval notation.</paragraph>
    <exercise number="339" has_solution="true">
      <problem>
        <paragraph>$$\frac{x - 3}{x + 4} \geq 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$( - \infty , -4 ) \cup [ 3 , \infty ) ( - \infty , -4 ) \cup [ 3 , \infty )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="340" has_solution="false">
      <problem>
        <paragraph>$$\frac{x + 6}{x - 5} \geq 0$$</paragraph>
      </problem>
    </exercise>
