    <paragraph>Classify Equations</paragraph>
    <paragraph>In the following exercises, classify each equation as a conditional equation, an identity, or a contradiction and then state the solution.</paragraph>
    <exercise number="31" has_solution="true">
      <problem>
        <paragraph>$$23z + 19 = 3\left( {5z - 9} \right) + 8z + 46$$</paragraph>
      </problem>
      <solution>
        <paragraph>identity; all real numbers</paragraph>
      </solution>
    </exercise>
    <exercise number="32" has_solution="false">
