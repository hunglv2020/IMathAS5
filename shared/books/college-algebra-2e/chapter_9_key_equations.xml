<?xml version='1.0' encoding='utf-8'?>
<key_equations chapter="9">
  <equation>
    <label>Formula for a factorial</label>
    <formula>$$\begin{array}{l} {0! = 1} \\ {1! = 1} \\ {n! = n\left( {n - 1} \right)\left( {n - 2} \right)\cdots(2)(1)\text{,~for~}n \geq 2} \end{array}$$</formula>
  </equation>
  <equation>
    <label>recursive formula for nth term of an arithmetic sequence</label>
    <formula>$$a_{n} = {a_{n - 1} + d},{n \geq 2}$$</formula>
  </equation>
  <equation>
    <label>explicit formula for nth term of an arithmetic sequence</label>
    <formula>$$\begin{array}{l} {a_{n} = a_{1} + d(n - 1)} \end{array}$$</formula>
  </equation>
  <equation>
    <label>recursive formula fornthnthterm of a geometric sequence</label>
    <formula>$$a_{n} = ra_{n - 1},n \geq 2$$</formula>
  </equation>
  <equation>
    <label>explicit formula fornthnthterm of a geometric sequence</label>
    <formula>$$a_{n} = a_{1}r^{n - 1}$$</formula>
  </equation>
  <equation>
    <label>sum of the firstnnterms of an arithmetic series</label>
    <formula>$$S_{n} = \frac{n(a_{1} + a_{n})}{2}$$</formula>
  </equation>
  <equation>
    <label>sum of the firstnnterms of a geometric series</label>
    <formula>$$S_{n} = \frac{a_{1}(1 - r^{n})}{1 - r},r \neq 1$$</formula>
  </equation>
  <equation>
    <label>sum of an infinite geometric series with–1&lt;r&lt;1–1&lt;r&lt;1</label>
    <formula>$$S_{n} = \frac{a_{1}}{1 - r},r \neq 1$$</formula>
  </equation>
  <equation>
    <label>number of permutations ofnndistinct objects takenrrat a time</label>
    <formula>$$P(n,r) = \frac{n!}{(n - r)!}$$</formula>
  </equation>
  <equation>
    <label>number of combinations ofnndistinct objects takenrrat a time</label>
    <formula>$$C(n,r) = \frac{n!}{r!(n - r)!}$$</formula>
  </equation>
  <equation>
    <label>number of permutations ofnnnon-distinct objects</label>
    <formula>$$\frac{n!}{r_{1}!r_{2}!\ldots r_{k}!}$$</formula>
  </equation>
  <equation>
    <label>Binomial Theorem</label>
    <formula>$${(x + y)}^{n} = {\sum\limits_{k - 0}^{n}\begin{pmatrix} n \\ k \end{pmatrix}}x^{n - k}y^{k}$$</formula>
  </equation>
  <equation>
    <label>(r+1)th(r+1)thterm of a binomial expansion</label>
    <formula>$$\begin{pmatrix} n \\ r \end{pmatrix}x^{n - r}y^{r}$$</formula>
  </equation>
  <equation>
    <label>probability of an event with equally likely outcomes</label>
    <formula>$$P(E) = \frac{n(E)}{n(S)}$$</formula>
  </equation>
  <equation>
    <label>probability of the union of two events</label>
    <formula>$$P(E \cup F) = P(E) + P(F) - P(E \cap F)$$</formula>
  </equation>
  <equation>
    <label>probability of the union of mutually exclusive events</label>
    <formula>$$P(E \cup F) = P(E) + P(F)$$</formula>
  </equation>
  <equation>
    <label>probability of the complement of an event</label>
    <formula>$$P(E') = 1 - P(E)$$</formula>
  </equation>
</key_equations>
