      </solution>
    </exercise>
    <exercise number="20" has_solution="false">
      <problem>
        <paragraph>$$\begin{array}{l} {- \frac{1}{4}x + \frac{3}{2}y = 11} \\ {- \frac{1}{8}x + \frac{1}{3}y = 3} \end{array}$$</paragraph>
