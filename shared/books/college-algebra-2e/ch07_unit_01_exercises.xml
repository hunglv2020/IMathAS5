      </solution>
    </exercise>
    <exercise number="16" has_solution="false">
      <problem>
        <paragraph>$$\begin{array}{l} { x-0.2y = 1} \\ {-10x + 2y = 5} \end{array}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="17" has_solution="true">
