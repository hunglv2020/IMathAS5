    </exercise>
    <paragraph>For the following exercises, solve each system by addition.</paragraph>
    <exercise number="21" has_solution="true">
      <problem>
        <paragraph>$$\begin{array}{l} {-2x + 5y = -42} \\ { 7x + 2y = 30} \end{array}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$( 6,-6 ) ( 6,-6 )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="22" has_solution="false">
      <problem>
        <paragraph>$$\begin{array}{l} {6x-5y = -34} \\ {2x + 6y = 4} \end{array}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="23" has_solution="true">
      <problem>
        <paragraph>$$\begin{array}{l} { 5x - y = -2.6} \\ {-4x-6y = 1.4} \end{array}$$</paragraph>
      </problem>
      <solution>
