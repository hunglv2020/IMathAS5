    <paragraph>For the following exercises, solve each rational equation for $$\frac{3}{x - 2} = \frac{1}{x - 1} + \frac{7}{(x - 1)(x - 2)}$$ State all x-values that are excluded from the solution set.</paragraph>
    <exercise number="16" has_solution="false">
      <problem>
        <paragraph>$$\frac{3x}{x - 1} + 2 = \frac{3}{x - 1}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="17" has_solution="true">
      <problem>
        <paragraph>$$\frac{5}{x + 1} + \frac{1}{x - 3} = \frac{- 6}{x^{2} - 2x - 3}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x\ne -4; x\ne -4;$$ $$x=-3 x=-3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="18" has_solution="false">
      <problem>
        <paragraph>$$\frac{1}{x} = \frac{1}{5} + \frac{3}{2x}$$</paragraph>
