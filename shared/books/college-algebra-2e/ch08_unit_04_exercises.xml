      <problem>
        <paragraph>$$\frac{x^{2}}{4} + \frac{y^{2}}{1} = 1,\theta = 45^{\circ}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$( x ′ - y ′ ) 2 8 + ( x ′ + y ′ ) 2 2 =1 ( x ′ - y ′ ) 2 8 + ( x ′ + y ′ ) 2 2 =1$$</paragraph>
      </solution>
    </exercise>
