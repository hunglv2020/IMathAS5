    <heading level="1">Real-World Applications</heading>
    <paragraph>For the following exercises, find the dimensions of the box described.</paragraph>
    <exercise number="71" has_solution="true">
      <problem>
        <paragraph>The length is twice as long as the width. The height is 2 inches greater than the width. The volume is 192 cubic inches.</paragraph>
      </problem>
      <solution>
        <paragraph>8 by 4 by 6 inches</paragraph>
      </solution>
    </exercise>
    <exercise number="72" has_solution="false">
