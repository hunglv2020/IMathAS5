    <heading level="1">Verbal</heading>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>Why does the domain differ for different functions?</paragraph>
      </problem>
      <solution>
        <paragraph>The domain of a function depends upon what values of the independent variable make the function undefined or imaginary.</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
