    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>How does one find the domain of the quotient of two functions, $$\frac{f}{g}?$$</paragraph>
      </problem>
      <solution>
        <paragraph>Find the numbers that make the function in the denominator $$g g$$ equal to zero, and check for any other domain restrictions on $$f f$$ and $$g, g,$$ such as an even-indexed root or zeros in the denominator.</paragraph>
      </solution>
    </exercise>
