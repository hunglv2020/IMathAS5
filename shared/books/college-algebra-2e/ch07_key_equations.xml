<?xml version='1.0' encoding='utf-8'?>
<key_equations chapter="7">
  <equation>
    <label>Identity matrix for a2×22×2matrix</label>
    <formula>$$I_{2} = \begin{bmatrix} 1 &amp; 0 \\ 0 &amp; 1 \end{bmatrix}$$</formula>
  </equation>
  <equation>
    <label>Identity matrix for a3×33×3matrix</label>
    <formula>$$I_{3} = \begin{bmatrix} 1 &amp; 0 &amp; 0 \\ 0 &amp; 1 &amp; 0 \\ 0 &amp; 0 &amp; 1 \end{bmatrix}$$</formula>
  </equation>
  <equation>
    <label>Multiplicative inverse of a2×22×2matrix</label>
    <formula>$$A^{-1} = \frac{1}{ad - bc}\begin{bmatrix} d &amp; {- b} \\ {- c} &amp; a \end{bmatrix},\mspace{9mu}\text{where~}ad - bc \neq 0$$</formula>
  </equation>
</key_equations>
