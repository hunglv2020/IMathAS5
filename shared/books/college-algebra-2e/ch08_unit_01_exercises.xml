<section>
  <exercises>
    <heading level="1">8.1 Section Exercises</heading>
    <heading level="1">Verbal</heading>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>Define an ellipse in terms of its foci.</paragraph>
      </problem>
      <solution>
        <paragraph>An ellipse is the set of all points in the plane the sum of whose distances from two fixed points, called the foci, is a constant.</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>Where must the foci of an ellipse lie?</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>What special case of the ellipse do we have when the major and minor axis are of the same length?</paragraph>
      </problem>
      <solution>
        <paragraph>This special case would be a circle.</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>For the special case mentioned in the previous question, what would be true about the foci of that ellipse?</paragraph>
      </problem>
    </exercise>
    <exercise number="5" has_solution="true">
      <problem>
        <paragraph>What can be said about the symmetry of the graph of an ellipse with center at the origin and foci along the y-axis?</paragraph>
      </problem>
      <solution>
        <paragraph>It is symmetric about the x-axis, y-axis, and the origin.</paragraph>
      </solution>
    </exercise>
