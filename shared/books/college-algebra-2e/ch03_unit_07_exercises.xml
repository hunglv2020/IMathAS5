    <exercise number="16" has_solution="true">
      <problem>
        <paragraph>Given $$f(x) = \frac{x}{2 + x}$$ and $$g(x) = \frac{2x}{1 - x}:$$</paragraph>
        <list type="ordered">
          <item>ⓐFind $$f(g(x))$$ and $$g(f(x)).$$</item>
          <item>ⓑWhat does the answer tell us about the relationship between $$f(x)$$ and $$g(x)?$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ $$f(g(x))=x f(g(x))=x$$ and $$g(f(x))=x. g(f(x))=x.$$</item>
          <item>ⓑThis tells us that $$f f$$ and $$g g$$ are inverse functions</item>
        </list>
      </solution>
    </exercise>
