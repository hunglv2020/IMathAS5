          <item>ⓑ $$h(2) = 350$$</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ The height of a rocket above ground after 1 second is 200 ft.</item>
          <item>ⓑ The height of a rocket above ground after 2 seconds is 350 ft.</item>
        </list>
      </solution>
