    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>Every number will have two square roots. What is the principal square root?</paragraph>
      </problem>
      <solution>
        <paragraph>The principal square root is the nonnegative root of the number.</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>Can a radical with a negative radicand have a real square root? Why or why not?</paragraph>
      </problem>
    </exercise>
