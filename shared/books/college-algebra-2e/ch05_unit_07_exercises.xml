<section>
  <exercises>
    <heading level="1">5.7 Section Exercises</heading>
    <heading level="1">Verbal</heading>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>Explain why we cannot find inverse functions for all polynomial functions.</paragraph>
      </problem>
      <solution>
        <paragraph>It can be too difficult or impossible to solve for $$x x$$ in terms of $$y. y.$$</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>Why must we restrict the domain of a quadratic function when finding its inverse?</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>When finding the inverse of a radical function, what restriction will we need to make?</paragraph>
      </problem>
      <solution>
        <paragraph>We will need a restriction on the domain of the answer.</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>The inverse of a quadratic function will always take what form?</paragraph>
      </problem>
    </exercise>
    <heading level="1">Algebraic</heading>
    <paragraph>For the following exercises, find the inverse of the function on the given domain.</paragraph>
    <exercise number="5" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \left( {x - 4} \right)^{2}, \lbrack 4,\infty)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= x +4 f -1 (x)= x +4$$</paragraph>
      </solution>
    </exercise>
    <exercise number="6" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \left( {x + 2} \right)^{2}, \lbrack-2,\infty)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="7" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \left( {x + 1} \right)^{2} - 3, \lbrack-1,\infty)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= x+3 -1 f -1 (x)= x+3 -1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="8" has_solution="false">
      <problem>
        <paragraph>$$f(x) = 3x^{2} + 5,\left( {\infty,0} \right\rbrack$$</paragraph>
      </problem>
    </exercise>
    <exercise number="9" has_solution="true">
      <problem>
        <paragraph>$$f(x) = 12 - x^{2}, \lbrack 0,\infty)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= 12-x f -1 (x)= 12-x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="10" has_solution="false">
      <problem>
        <paragraph>$$f(x) = 9 - x^{2}, \lbrack 0,\infty)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="11" has_solution="true">
      <problem>
        <paragraph>$$f(x) = 2x^{2} + 4, \lbrack 0,\infty)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= x-4 2 f -1 (x)= x-4 2$$</paragraph>
      </solution>
    </exercise>
    <paragraph>For the following exercises, find the inverse of the functions.</paragraph>
    <exercise number="12" has_solution="false">
      <problem>
