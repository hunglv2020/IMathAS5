      </solution>
    </exercise>
    <exercise number="36" has_solution="false">
      <problem>
        <paragraph>$$f(x) = 1 - x^{3}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="37" has_solution="true">
      <problem>
        <paragraph>$$f(x) = x^{2} + 4x, x \geq - 2$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= x+4 -2 f -1 (x)= x+4 -2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="38" has_solution="false">
      <problem>
        <paragraph>$$f(x) = x^{2} - 6x + 1, x \geq 3$$</paragraph>
      </problem>
    </exercise>
    <exercise number="39" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{2}{x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>39.</paragraph>
      </solution>
    </exercise>
