      </problem>
    </exercise>
    <exercise number="13" has_solution="true">
      <problem>
        <paragraph>$$f(x) = 3x^{3} + 1$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= x-1 3 3 f -1 (x)= x-1 3 3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="14" has_solution="false">
      <problem>
        <paragraph>$$f(x) = 4 - x^{3}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="15" has_solution="true">
      <problem>
        <paragraph>$$f(x) = 4 - 2x^{3}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= 4-x 2 3 f -1 (x)= 4-x 2 3$$</paragraph>
      </solution>
    </exercise>
    <paragraph>For the following exercises, find the inverse of the functions.</paragraph>
    <exercise number="16" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \sqrt{2x + 1}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="17" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \sqrt{3 - 4x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= 3-x2 4 ,[ 0,\infty ) f -1 (x)= 3-x2 4 ,[ 0,\infty )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="18" has_solution="false">
      <problem>
        <paragraph>$$f(x) = 9 + \sqrt{4x - 4}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="19" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \sqrt{6x - 8} + 5$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= (x-5)2+8 6 f -1 (x)= (x-5)2+8 6$$</paragraph>
      </solution>
    </exercise>
    <exercise number="20" has_solution="false">
      <problem>
        <paragraph>$$f(x) = 9 + 2\sqrt[3]{x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="21" has_solution="true">
      <problem>
        <paragraph>$$f(x) = 3 - \sqrt[3]{x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= (3-x)2 f -1 (x)=(3-x)2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="22" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{2}{x + 8}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="23" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{3}{x - 4}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= 4x+3 x f -1 (x)= 4x+3 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="24" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{x + 3}{x + 7}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="25" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{x - 2}{x + 7}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= 7x-3 1-x f -1 (x)= 7x-3 1-x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="26" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{3x + 4}{5 - 4x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="27" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{5x + 1}{2 - 5x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= 2x-1 5x+5 f -1 (x)= 2x-1 5x+5$$</paragraph>
      </solution>
    </exercise>
    <exercise number="28" has_solution="false">
      <problem>
        <paragraph>$$f(x) = x^{2} + 2x, \lbrack-1,\infty)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="29" has_solution="true">
      <problem>
        <paragraph>$$f(x) = x^{2} + 4x + 1, \lbrack-2,\infty)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= x+3 -2 f -1 (x)= x+3 -2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="30" has_solution="false">
      <problem>
        <paragraph>$$f(x) = x^{2} - 6x + 3, \lbrack 3,\infty)$$</paragraph>
      </problem>
    </exercise>
    <heading level="1">Graphical</heading>
    <paragraph>For the following exercises, find the inverse of the function and graph both the function and its inverse.</paragraph>
    <exercise number="31" has_solution="true">
      <problem>
        <paragraph>$$f(x) = x^{2} + 2, x \geq 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= x-2 f -1 (x)= x-2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="32" has_solution="false">
      <problem>
        <paragraph>$$f(x) = 4 - x^{2}, x \geq 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="33" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \left( {x + 3} \right)^{2}, x \geq - 3$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f -1 (x)= x-3 f -1 (x)= x-3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="34" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \left( {x - 4} \right)^{2}, x \geq 4$$</paragraph>
