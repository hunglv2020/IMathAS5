      <problem>
        <paragraph>$$f(x) = \frac{1}{x^{2}}, x \geq 0$$</paragraph>
      </problem>
    </exercise>
    <paragraph>For the following exercises, use a graph to help determine the domain of the functions.</paragraph>
    <exercise number="41" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \sqrt{\frac{(x + 1)(x - 1)}{x}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$[-1,0)\cup [1,\infty ) [-1,0)\cup [1,\infty )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="42" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \sqrt{\frac{(x + 2)(x - 3)}{x - 1}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="43" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \sqrt{\frac{x(x + 3)}{x - 4}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$[-3,0]\cup (4,\infty ) [-3,0]\cup (4,\infty )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="44" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \sqrt{\frac{x^{2} - x - 20}{x - 2}}$$</paragraph>
