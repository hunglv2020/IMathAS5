<?xml version="1.0" encoding="UTF-8"?>
<section>
  <exercises>
    <heading level="1">2.4 Section Exercises</heading>
    <heading level="1">Verbal</heading>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>Explain how to add complex numbers.</paragraph>
      </problem>
      <solution>
        <paragraph>Add the real parts together and the imaginary parts together.</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>What is the basic principle in multiplication of complex numbers?</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>Give an example to show that the product of two imaginary numbers is not always imaginary.</paragraph>
      </problem>
      <solution>
        <paragraph>Possible answer: $$i i$$ times $$i i$$ equals -1, which is not imaginary.</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>What is a characteristic of the plot of a real number in the complex plane?</paragraph>
      </problem>
    </exercise>
    <heading level="1">Algebraic</heading>
    <paragraph>For the following exercises, evaluate the algebraic expressions.</paragraph>
    <exercise number="5" has_solution="true">
      <problem>
        <paragraph>If $$y = x^{2} + x - 4,$$ evaluate $$y$$ given $$x = 2i.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-8+2i -8+2i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="6" has_solution="false">
      <problem>
        <paragraph>If $$y = x^{3} - 2,$$ evaluate $$y$$ given $$x = i.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="7" has_solution="true">
      <problem>
        <paragraph>If $$y = x^{2} + 3x + 5,$$ evaluate $$y$$ given $$x = 2 + i.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$14+7i 14+7i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="8" has_solution="false">
      <problem>
        <paragraph>If $$y = 2x^{2} + x - 3,$$ evaluate $$y$$ given $$x = 2 - 3i.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="9" has_solution="true">
      <problem>
        <paragraph>If $$y = \frac{x + 1}{2 - x},$$ evaluate $$y$$ given $$x = 5i.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$- 23 29 + 15 29 i - 23 29 + 15 29 i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="10" has_solution="false">
      <problem>
        <paragraph>If $$y = \frac{1 + 2x}{x + 3},$$ evaluate $$y$$ given $$x = 4i.$$</paragraph>
      </problem>
    </exercise>
    <heading level="1">Graphical</heading>
    <paragraph>For the following exercises, plot the complex numbers on the complex plane.</paragraph>
    <exercise number="11" has_solution="true">
      <problem>
        <paragraph>$$1 - 2i$$</paragraph>
      </problem>
      <solution/>
    </exercise>
    <exercise number="12" has_solution="false">
      <problem>
        <paragraph>$$-2 + 3i$$</paragraph>
      </problem>
    </exercise>
    <exercise number="13" has_solution="true">
      <problem>
        <paragraph>$$i$$</paragraph>
      </problem>
      <solution/>
    </exercise>
    <exercise number="14" has_solution="false">
      <problem>
        <paragraph>$$-3 - 4i$$</paragraph>
      </problem>
    </exercise>
    <heading level="1">Numeric</heading>
    <paragraph>For the following exercises, perform the indicated operation and express the result as a simplified complex number.</paragraph>
    <exercise number="15" has_solution="true">
      <problem>
        <paragraph>$$\left( {3 + 2i} \right) + (5 - 3i)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$8-i 8-i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="16" has_solution="false">
      <problem>
        <paragraph>$$\left( {-2 - 4i} \right) + \left( {1 + 6i} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="17" has_solution="true">
      <problem>
        <paragraph>$$\left( {-5 + 3i} \right) - (6 - i)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-11+4i -11+4i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="18" has_solution="false">
      <problem>
        <paragraph>$$\left( {2 - 3i} \right) - (3 + 2i)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="19" has_solution="true">
      <problem>
        <paragraph>$$(-4 + 4i) - (-6 + 9i)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2-5i 2-5i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="20" has_solution="false">
      <problem>
        <paragraph>$$\left( {2 + 3i} \right)(4i)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="21" has_solution="true">
      <problem>
        <paragraph>$$\left( {5 - 2i} \right)(3i)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$6+15i 6+15i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="22" has_solution="false">
      <problem>
        <paragraph>$$\left( {6 - 2i} \right)(5)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="23" has_solution="true">
      <problem>
        <paragraph>$$\left( {-2 + 4i} \right)(8)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-16+32i -16+32i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="24" has_solution="false">
      <problem>
        <paragraph>$$\left( {2 + 3i} \right)(4 - i)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="25" has_solution="true">
      <problem>
        <paragraph>$$\left( {-1 + 2i} \right)(-2 + 3i)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-4-7i -4-7i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="26" has_solution="false">
      <problem>
        <paragraph>$$\left( {4 - 2i} \right)(4 + 2i)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="27" has_solution="true">
      <problem>
        <paragraph>$$\left( {3 + 4i} \right)\left( {3 - 4i} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>25</paragraph>
      </solution>
    </exercise>
    <exercise number="28" has_solution="false">
      <problem>
        <paragraph>$$\frac{3 + 4i}{2}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="29" has_solution="true">
      <problem>
        <paragraph>$$\frac{6 - 2i}{3}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2- 2 3 i 2- 2 3 i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="30" has_solution="false">
      <problem>
        <paragraph>$$\frac{- 5 + 3i}{2i}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="31" has_solution="true">
      <problem>
        <paragraph>$$\frac{6 + 4i}{i}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$4-6i 4-6i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="32" has_solution="false">
      <problem>
        <paragraph>$$\frac{2 - 3i}{4 + 3i}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="33" has_solution="true">
      <problem>
        <paragraph>$$\frac{3 + 4i}{2 - i}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2 5 + 11 5 i 2 5 + 11 5 i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="34" has_solution="false">
      <problem>
        <paragraph>$$\frac{2 + 3i}{2 - 3i}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="35" has_solution="true">
      <problem>
        <paragraph>$$\sqrt{-9} + 3\sqrt{-16}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$15i 15i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="36" has_solution="false">
      <problem>
        <paragraph>$$- \sqrt{-4} - 4\sqrt{-25}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="37" has_solution="true">
      <problem>
        <paragraph>$$\frac{2 + \sqrt{- 12}}{2}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1+i 3 1+i 3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="38" has_solution="false">
      <problem>
        <paragraph>$$\frac{4 + \sqrt{- 20}}{2}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="39" has_solution="true">
      <problem>
        <paragraph>$$i^{8}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="40" has_solution="false">
      <problem>
        <paragraph>$$i^{15}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="41" has_solution="true">
      <problem>
        <paragraph>$$i^{22}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-1 -1$$</paragraph>
      </solution>
    </exercise>
    <heading level="1">Technology</heading>
    <paragraph>For the following exercises, use a calculator to help answer the questions.</paragraph>
    <exercise number="42" has_solution="false">
      <problem>
        <paragraph>Evaluate $${(1 + i)}^{k}$$ for $$k = 4,8,$$ and $$12$$ . Predict the value if $$k = 16.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="43" has_solution="true">
      <problem>
        <paragraph>Evaluate $${(1 - i)}^{k}$$ for $$k = 2,6,$$ and $$10$$ . Predict the value if $$k = 14.$$</paragraph>
      </problem>
      <solution>
        <paragraph>128i</paragraph>
      </solution>
    </exercise>
    <exercise number="44" has_solution="true">
      <problem>
        <paragraph>Evaluate $${( \text{l} + i)}^{k} - {( \text{l} - i)}^{k}$$ for $$k = 4,8,$$ and $$12$$ . Predict the value for $$k = 16.$$</paragraph>
      </problem>
      <solution>
        <paragraph>The x-intercept is $$( 2,0 ) ( 2,0 )$$ and the y-intercept is $$( 0,-3 ). ( 0,-3 ).$$</paragraph>
      </solution>
    </exercise>
    <exercise number="45" has_solution="true">
      <problem>
        <paragraph>Show that a solution of $$x^{6} + 1 = 0$$ is $$\frac{\sqrt{3}}{2} + \frac{1}{2}i.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$( 3 2 + 1 2 i ) 6 =-1 ( 3 2 + 1 2 i ) 6 =-1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="46" has_solution="false">
      <problem>
        <paragraph>Show that a solution of $$x^{8}-1 = 0$$ is $$\frac{\sqrt{2}}{2} + \frac{\sqrt{2}}{2}i.$$</paragraph>
      </problem>
    </exercise>
    <heading level="1">Extensions</heading>
    <paragraph>For the following exercises, evaluate the expressions, writing the result as a simplified complex number.</paragraph>
    <exercise number="47" has_solution="true">
      <problem>
        <paragraph>$$\frac{1}{i} + \frac{4}{i^{3}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$3i 3i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="48" has_solution="false">
      <problem>
        <paragraph>$$\frac{1}{i^{11}} - \frac{1}{i^{21}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="49" has_solution="true">
      <problem>
        <paragraph>$$i^{7}\left( {1 + i^{2}} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>0</paragraph>
      </solution>
    </exercise>
    <exercise number="50" has_solution="false">
      <problem>
        <paragraph>$$i^{-3} + 5i^{7}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="51" has_solution="true">
      <problem>
        <paragraph>$$\frac{\left( {2 + i} \right)\left( {4 - 2i} \right)}{(1 + i)}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$5-5i 5-5i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="52" has_solution="false">
      <problem>
        <paragraph>$$\frac{\left( {1 + 3i} \right)\left( {2 - 4i} \right)}{(1 + 2i)}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="53" has_solution="true">
      <problem>
        <paragraph>$$\frac{\left( {3 + i} \right)^{2}}{\left( {1 + 2i} \right)^{2}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-2i -2i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="54" has_solution="false">
      <problem>
        <paragraph>$$\frac{3 + 2i}{2 + i} + \left( {4 + 3i} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="55" has_solution="true">
      <problem>
        <paragraph>$$\frac{4 + i}{i} + \frac{3 - 4i}{1 - i}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$9 2 - 9 2 i 9 2 - 9 2 i$$</paragraph>
      </solution>
    </exercise>
    <exercise number="56" has_solution="false">
      <problem>
        <paragraph>$$\frac{3 + 2i}{1 + 2i} - \frac{2 - 3i}{3 + i}$$</paragraph>
      </problem>
    </exercise>
  </exercises>
</section>
