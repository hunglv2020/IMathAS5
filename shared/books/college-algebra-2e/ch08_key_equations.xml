<?xml version='1.0' encoding='utf-8'?>
<key_equations chapter="8">
  <equation>
    <label>Horizontal ellipse, center at origin</label>
    <formula>$$\frac{x^{2}}{a^{2}} + \frac{y^{2}}{b^{2}} = 1,\mspace{9mu} a &gt; b$$</formula>
  </equation>
  <equation>
    <label>Vertical ellipse, center at origin</label>
    <formula>$$\frac{x^{2}}{b^{2}} + \frac{y^{2}}{a^{2}} = 1,\mspace{9mu} a &gt; b$$</formula>
  </equation>
  <equation>
    <label>Horizontal ellipse, center(h,k)(h,k)</label>
    <formula>$$\frac{\left( {x - h} \right)^{2}}{a^{2}} + \frac{\left( {y - k} \right)^{2}}{b^{2}} = 1,\mspace{9mu} a &gt; b$$</formula>
  </equation>
  <equation>
    <label>Vertical ellipse, center(h,k)(h,k)</label>
    <formula>$$\frac{\left( {x - h} \right)^{2}}{b^{2}} + \frac{\left( {y - k} \right)^{2}}{a^{2}} = 1,\mspace{9mu} a &gt; b$$</formula>
  </equation>
  <equation>
    <label>Hyperbola, center at origin, transverse axis onx-axis</label>
    <formula>$$\frac{x^{2}}{a^{2}} - \frac{y^{2}}{b^{2}} = 1$$</formula>
  </equation>
  <equation>
    <label>Hyperbola, center at origin, transverse axis ony-axis</label>
    <formula>$$\frac{y^{2}}{a^{2}} - \frac{x^{2}}{b^{2}} = 1$$</formula>
  </equation>
  <equation>
    <label>Hyperbola, center at(h,k),(h,k),transverse axis parallel tox-axis</label>
    <formula>$$\frac{\left( {x - h} \right)^{2}}{a^{2}} - \frac{\left( {y - k} \right)^{2}}{b^{2}} = 1$$</formula>
  </equation>
  <equation>
    <label>Hyperbola, center at(h,k),(h,k),transverse axis parallel toy-axis</label>
    <formula>$$\frac{\left( {y - k} \right)^{2}}{a^{2}} - \frac{\left( {x - h} \right)^{2}}{b^{2}} = 1$$</formula>
  </equation>
  <equation>
    <label>Parabola, vertex at origin, axis of symmetry onx-axis</label>
    <formula>$$y^{2} = 4px$$</formula>
  </equation>
  <equation>
    <label>Parabola, vertex at origin, axis of symmetry ony-axis</label>
    <formula>$$x^{2} = 4py$$</formula>
  </equation>
  <equation>
    <label>Parabola, vertex at(h,k),(h,k),axis of symmetry onx-axis</label>
    <formula>$$\left( {y - k} \right)^{2} = 4p\left( {x - h} \right)$$</formula>
  </equation>
  <equation>
    <label>Parabola, vertex at(h,k),(h,k),axis of symmetry ony-axis</label>
    <formula>$$\left( {x - h} \right)^{2} = 4p\left( {y - k} \right)$$</formula>
  </equation>
  <equation>
    <label>General Form equation of a conic section</label>
    <formula>$$Ax^{2} + Bxy + Cy^{2} + Dx + Ey + F = 0$$</formula>
  </equation>
  <equation>
    <label>Rotation of a conic section</label>
    <formula>$$\begin{array}{l} {x = x^{\prime}\cos\mspace{9mu}\theta - y^{\prime}\sin\mspace{9mu}\theta} \\ {y = x^{\prime}\sin\mspace{9mu}\theta + y^{\prime}\cos\mspace{9mu}\theta} \end{array}$$</formula>
  </equation>
  <equation>
    <label>Angle of rotation</label>
    <formula>$$\theta,\text{where~}\cot\left( {2\theta} \right) = \frac{A - C}{B}$$</formula>
  </equation>
</key_equations>
