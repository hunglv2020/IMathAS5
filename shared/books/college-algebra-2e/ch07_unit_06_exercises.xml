      </problem>
      <solution>
        <paragraph>$$4x+5y-2z=12 y+58z=2 8x+7y-3z=-5 4x+5y-2z=12 y+58z=2 8x+7y-3z=-5$$</paragraph>
      </solution>
    </exercise>
