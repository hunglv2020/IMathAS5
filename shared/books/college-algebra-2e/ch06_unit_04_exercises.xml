    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>What type(s) of translation(s), if any, affect the domain of a logarithmic function?</paragraph>
      </problem>
      <solution>
        <paragraph>Shifting the function right or left and reflecting the function about the y-axis will affect its domain.</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
