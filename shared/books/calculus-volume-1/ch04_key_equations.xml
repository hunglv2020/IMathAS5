<key_equations chapter="4">
  <equation>
    <label>Linear approximation</label>
    <formula>$$L(x) = f(a) + f\prime(a)(x - a)$$</formula>
  </equation>
  <equation>
    <label>A differential</label>
    <formula>$$dy = f\prime(x)dx.$$</formula>
  </equation>
</key_equations>
