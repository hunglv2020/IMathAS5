      <problem>
        <paragraph>$$y = 4 - x^{2} \text{and} y = 2 - x$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$108\pi 5108\pi 5$$ units3</paragraph>
      </solution>
    </exercise>
    <exercise number="94" has_solution="false">
      <problem>
        <paragraph>[T] $$y = \cos x,y = e^{-x},x = 0, \text{and} x = 1.2927$$</paragraph>
