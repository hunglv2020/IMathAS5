      <problem>
        <paragraph>$$y = x^{2} \text{and} y = x + 2$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$72\pi 572\pi 5$$ units3</paragraph>
      </solution>
    </exercise>
    <exercise number="92" has_solution="false">
      <problem>
        <paragraph>$$x^{2} = y^{3} \text{and} x^{3} = y^{2}$$</paragraph>
      </problem>
    </exercise>
