      </solution>
    </exercise>
    <exercise number="370" has_solution="false">
      <problem>
        <paragraph>$$\underset{x\rightarrow{\pi/2}}{\lim }\frac{\cos x}{\frac{\pi}{2} - x}$$</paragraph>
