    </exercise>
    <exercise number="373" has_solution="true">
      <problem>
        <paragraph>$$\underset{x\rightarrow 0}{\lim }\frac{\left( {1 + x} \right)^{n} - 1}{x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$n n$$</paragraph>
      </solution>
    </exercise>
    <exercise number="374" has_solution="true">
      <problem>
        <paragraph>$$\underset{x\rightarrow 0}{\lim }\frac{\left( {1 + x} \right)^{n} - 1 - nx}{x^{2}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$limx\to \infty f(x)=35,limx\to \infty f(x)=35,$$ $$limx\to -\infty f(x)=-2limx\to -\infty f(x)=-2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="375" has_solution="true">
      <problem>
        <paragraph>$$\underset{x\rightarrow 0}{\lim }\frac{\sin x - \tan x}{x^{3}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$- 1 2 - 1 2$$</paragraph>
      </solution>
    </exercise>
