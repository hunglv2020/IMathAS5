<?xml version='1.0' encoding='utf-8'?>
<key_equations chapter="2">
  <equation>
    <label>Slope of a Secant Line</label>
    <formula>$$m_{\text{sec}} = \frac{f(x) - f(a)}{x - a}$$</formula>
  </equation>
  <equation>
    <label>Average Velocity over Interval[a,t][a,t]</label>
    <formula>$$v_{\text{ave}} = \frac{s(t) - s(a)}{t - a}$$</formula>
  </equation>
  <equation>
    <label>Intuitive Definition of the Limit</label>
    <formula>$$\underset{x\rightarrow a}{\text{lim}}f(x) = L$$</formula>
  </equation>
  <equation>
    <label>Two Important Limits</label>
    <formula>$$\underset{x\rightarrow a}{\text{lim}}x = a\quad\underset{x\rightarrow a}{\text{lim}}c = c$$</formula>
  </equation>
  <equation>
    <label>One-Sided Limits</label>
    <formula>$$\underset{x\rightarrow a^{-}}{\text{lim}}f(x) = L\quad\underset{x\rightarrow a^{+}}{\text{lim}}f(x) = L$$</formula>
  </equation>
  <equation>
    <label>Infinite Limits from the Left</label>
    <formula>$$\underset{x\rightarrow a^{-}}{\text{lim}}f(x) = \text{+}\infty\quad\underset{x\rightarrow a^{-}}{\text{lim}}f(x) = \text{−}\infty$$</formula>
  </equation>
  <equation>
    <label>Infinite Limits from the Right</label>
    <formula>$$\underset{x\rightarrow a^{+}}{\text{lim}}f(x) = \text{+}\infty\quad\underset{x\rightarrow a^{+}}{\text{lim}}f(x) = \text{−}\infty$$</formula>
  </equation>
  <equation>
    <label>Two-Sided Infinite Limits</label>
    <formula>$$\underset{x\rightarrow a}{\text{lim}}f(x) = \text{+}\infty:\underset{x\rightarrow a^{-}}{\text{lim}}f(x) = \text{+}\infty$$ and $$\underset{x\rightarrow a^{+}}{\text{lim}}f(x) = \text{+}\infty$$
$$\underset{x\rightarrow a}{\text{lim}}f(x) = \text{−}\infty:\underset{x\rightarrow a^{-}}{\text{lim}}f(x) = \text{−}\infty$$ and $$\underset{x\rightarrow a^{+}}{\text{lim}}f(x) = \text{−}\infty$$</formula>
  </equation>
  <equation>
    <label>Basic Limit Results</label>
    <formula>$$\underset{x\rightarrow a}{\text{lim}}x = a\ \underset{x\rightarrow a}{\text{lim}}c = c$$</formula>
  </equation>
  <equation>
    <label>Important Limits</label>
    <formula>$$\underset{\theta\rightarrow 0}{\text{lim}}\text{sin}\mspace{2mu}\theta = 0$$
$$\underset{\theta\rightarrow 0}{\text{lim}}\text{cos}\mspace{2mu}\theta = 1$$
$$\underset{\theta\rightarrow 0}{\text{lim}}\frac{\text{sin}\mspace{2mu}\theta}{\theta} = 1$$
$$\underset{\theta\rightarrow 0}{\text{lim}}\frac{1 - \text{cos}\mspace{2mu}\theta}{\theta} = 0$$</formula>
  </equation>
</key_equations>
