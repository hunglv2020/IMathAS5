      <problem>
        <paragraph>$$f(x) = \frac{x\sin (x)}{x^{2} - 1}$$</paragraph>
      </problem>
      <solution>
        <paragraph>Horizontal: $$y=0,y=0,$$ vertical: $$x=\pm 1x=\pm 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="278" has_solution="false">
