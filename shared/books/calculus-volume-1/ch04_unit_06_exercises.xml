    <exercise number="279" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{1}{x^{3} + x^{2}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>Horizontal: $$y=0,y=0,$$ vertical: $$x=0x=0$$ and $$x=-1x=-1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="280" has_solution="false">
