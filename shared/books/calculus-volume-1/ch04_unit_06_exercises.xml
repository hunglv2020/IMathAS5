    <paragraph>For the following exercises, find the horizontal and vertical asymptotes.</paragraph>
    <exercise number="271" has_solution="true">
      <problem>
        <paragraph>$$f(x) = x - \frac{9}{x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>Horizontal: none, vertical: $$x=0x=0$$</paragraph>
      </solution>
    </exercise>
    <exercise number="272" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{1}{1 - x^{2}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="273" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{x^{3}}{4 - x^{2}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>Horizontal: none, vertical: $$x=\pm 2x=\pm 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="274" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{x^{2} + 3}{x^{2} + 1}$$</paragraph>
