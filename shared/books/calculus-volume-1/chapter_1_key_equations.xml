<?xml version='1.0' encoding='utf-8'?>
<key_equations chapter="1">
  <equation>
    <label>Composition of two functions</label>
    <formula>$$\left( {g \circ f} \right)(x) = g\left( {f(x)} \right)$$</formula>
  </equation>
  <equation>
    <label>Absolute value function</label>
    <formula>$$f(x) = \left\{ \begin{matrix} {\text{−}x,x &lt; 0} \\ {x,x \geq 0} \end{matrix} \right.$$</formula>
  </equation>
  <equation>
    <label>Point-slope equation of a line</label>
    <formula>$$y - y_{1} = m\left( {x - x_{1}} \right)$$</formula>
  </equation>
  <equation>
    <label>Slope-intercept form of a line</label>
    <formula>$$y = mx + b$$</formula>
  </equation>
  <equation>
    <label>Standard form of a line</label>
    <formula>$$ax + by = c$$</formula>
  </equation>
  <equation>
    <label>Polynomial function</label>
    <formula>$$f(x) = a_{n}x^{n} + a_{n - 1}x^{n - 1} + \text{⋯} + a_{1}x + a_{0}$$</formula>
  </equation>
  <equation>
    <label>Generalized sine function</label>
    <formula>$$f(x) = A\mspace{2mu}\text{sin}\left( {B\left( {x - \alpha} \right)} \right) + C$$</formula>
  </equation>
  <equation>
    <label>Inverse functions</label>
    <formula>$$f^{-1}\left( {f(x)} \right) = x\ \text{for all}\ x\ \text{in}\ D,\text{and}\ f\left( {f^{-1}(y)} \right) = y\ \text{for all}\ y\ \text{in}\ R.$$</formula>
  </equation>
</key_equations>
