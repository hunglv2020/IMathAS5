<section>
  <exercises>
    <heading level="1">Section 3.3 Exercises</heading>
    <paragraph>For the following exercises, find $$f(x) = x^{7} + 10$$ for each function.</paragraph>
    <exercise number="106" has_solution="false">
      <problem>
        <paragraph>$$f(x) = 5x^{3} - x + 1$$</paragraph>
      </problem>
    </exercise>
    <exercise number="107" has_solution="true">
      <problem>
        <paragraph>$$f(x) = 4x^{2} - 7x$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f ′ ( x ) = 15 x 2 - 1 f ′ ( x ) = 15 x 2 - 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="108" has_solution="false">
      <problem>
        <paragraph>$$f(x) = 8x^{4} + 9x^{2} - 1$$</paragraph>
      </problem>
    </exercise>
    <exercise number="109" has_solution="true">
      <problem>
        <paragraph>$$f(x) = x^{4} + \frac{2}{x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$f ′ ( x ) = 32 x 3 + 18 x f ′ ( x ) = 32 x 3 + 18 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="110" has_solution="false">
      <problem>
        <paragraph>$$f(x) = 3x\left( {18x^{4} + \frac{13}{x + 1}} \right)$$</paragraph>
