    <exercise number="143" has_solution="true">
      <problem>
        <paragraph>Find a quadratic polynomial such that $$f^{''}(1) = -6.$$ and $$s(t) = t^{3} - 6t^{2} + 9t$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = -3 x 2 + 9 x - 1 y = -3 x 2 + 9 x - 1$$</paragraph>
