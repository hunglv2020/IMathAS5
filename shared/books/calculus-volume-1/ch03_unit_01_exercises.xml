      <problem>
        <paragraph>$$f(x) = \left\{ \begin{matrix} {1,x &lt; 1} \\ {x,x \geq 1} \end{matrix} \right.,x = 1$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$lim x \to 1 - 1 - 1 x - 1 = 0 \ne 1 = lim x \to 1 + x - 1 x - 1 lim x \to 1 - 1 - 1 x - 1 = 0 \ne 1 = lim x \to 1 + x - 1 x - 1$$</paragraph>
      </solution>
    </exercise>
