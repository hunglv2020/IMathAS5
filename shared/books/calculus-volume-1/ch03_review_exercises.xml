  <exercise number="377" has_solution="true">
    <problem>
      <p>$$f(x) = x^{2}\text{cos}\mspace{2mu} x + x\mspace{2mu}\text{tan}\mspace{2mu}(x)$$</p>
    </problem>
    <solution>
      <p>$$x\mspace{2mu}\text{sec}^{2}(x) + 2x\mspace{2mu}\text{cos}\mspace{2mu}(x) + \text{tan}\mspace{2mu}(x) - x^{2}\text{sin}\mspace{2mu}(x)$$</p>
