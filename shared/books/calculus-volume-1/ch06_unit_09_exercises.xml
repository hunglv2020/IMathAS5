    <exercise number="377" has_solution="true">
      <problem>
        <paragraph>[T] Find expressions for $$\cosh x + \sinh x$$ and $$\cosh x - \sinh x.$$ Use a calculator to graph these functions and ensure your expression is correct.</paragraph>
      </problem>
      <solution>
        <paragraph>$$e x and e - x e x and e - x$$</paragraph>
      </solution>
    </exercise>
