<review_exercises chapter="5">
  <exercise number="439" has_solution="true">
    <problem>
      <p>If $$f(x) &gt; 0,f^{\prime}\text{(}x) &gt; 0$$ for all $$x,$$ then the right-hand rule underestimates the integral $${\int_{a}^{b}{f(x)}}.$$ Use a graph to justify your answer.</p>
    </problem>
    <solution>
      <p>False</p>
    </solution>
  </exercise>
  <exercise number="440" has_solution="false">
    <problem>
      <p>$${\int_{a}^{b}{f{(x)}^{2}dx =}}{\int_{a}^{b}{f(x)dx}}{\int_{a}^{b}{f(x)dx}}$$</p>
    </problem>
  </exercise>
  <exercise number="441" has_solution="true">
    <problem>
      <p>If $$f(x) \leq g(x)$$ for all $$x \in \left\lbrack {a,b} \right\rbrack,$$ then $${\int_{a}^{b}{f(x)}} \leq {\int_{a}^{b}{g(x)}}.$$</p>
    </problem>
    <solution>
      <p>True</p>
    </solution>
  </exercise>
