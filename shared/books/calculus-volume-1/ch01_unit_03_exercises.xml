    <exercise number="137" has_solution="true">
      <problem>
        <paragraph>$$P\left( {x,\frac{\sqrt{7}}{3}} \right),x &lt; 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>a. $$x=-23x=-23$$ b. $$sin\theta =73,cos\theta =-23,tan\theta =-142,csc\theta =377,sec\theta =-322,cot\theta =-147sin\theta =73,cos\theta =-23,tan\theta =-142,csc\theta =377,sec\theta =-322,cot\theta =-147$$</paragraph>
      </solution>
    </exercise>
