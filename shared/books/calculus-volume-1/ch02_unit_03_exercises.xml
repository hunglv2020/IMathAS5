    <exercise number="99" has_solution="true">
      <problem>
        <paragraph>$$\underset{\theta\rightarrow\pi}{\lim }\frac{\sin \theta}{\tan \theta}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$lim\theta \to \pi sin\theta tan\theta =sin\pi tan\pi =00;lim\theta \to \pi sin\theta tan\theta =sin\pi tan\pi =00;$$ then, $$lim\theta \to \pi sin\theta tan\theta =lim\theta \to \pi sin\theta sin\theta cos\theta =lim\theta \to \pi cos\theta =-1lim\theta \to \pi sin\theta tan\theta =lim\theta \to \pi sin\theta sin\theta cos\theta =lim\theta \to \pi cos\theta =-1$$</paragraph>
      </solution>
    </exercise>
