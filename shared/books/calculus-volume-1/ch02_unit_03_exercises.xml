    </exercise>
    <exercise number="85" has_solution="true">
      <problem>
        <paragraph>$$\underset{x\rightarrow-2}{\lim }\sqrt{x^{2} - 6x + 3}$$</paragraph>
      </problem>
      <solution>
        <paragraph>Use root law: $$limx\to -2x2-6x+3=limx\to -2(x2-6x+3)=19limx\to -2x2-6x+3=limx\to -2(x2-6x+3)=19$$</paragraph>
      </solution>
    </exercise>
