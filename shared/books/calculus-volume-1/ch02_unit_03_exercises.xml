    <exercise number="95" has_solution="true">
      <problem>
        <paragraph>$$\underset{x\rightarrow 6}{\lim }\frac{3x - 18}{2x - 12}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$limx\to 63x-182x-12=18-1812-12=00;limx\to 63x-182x-12=18-1812-12=00;$$ then, $$limx\to 63x-182x-12=limx\to 63(x-6)2(x-6)=32limx\to 63x-182x-12=limx\to 63(x-6)2(x-6)=32$$</paragraph>
      </solution>
    </exercise>
