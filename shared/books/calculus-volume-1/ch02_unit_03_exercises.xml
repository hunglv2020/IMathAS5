    <exercise number="97" has_solution="true">
      <problem>
        <paragraph>$$\underset{t\rightarrow 9}{\lim }\frac{t - 9}{\sqrt{t} - 3}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$limx\to 9t-9t-3=9-93-3=00;limx\to 9t-9t-3=9-93-3=00;$$ then, $$limt\to 9t-9t-3=limt\to 9t-9t-3t+3t+3=limt\to 9(t+3)=6limt\to 9t-9t-3=limt\to 9t-9t-3t+3t+3=limt\to 9(t+3)=6$$</paragraph>
      </solution>
    </exercise>
