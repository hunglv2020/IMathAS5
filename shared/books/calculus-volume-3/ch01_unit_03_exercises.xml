<section>
  <exercises>
    <heading level="1">Section 1.3 Exercises</heading>
    <paragraph>In the following exercises, plot the point whose polar coordinates are given by first constructing the angle $$\theta$$ and then marking off the distance r along the ray.</paragraph>
    <exercise number="125" has_solution="true">
      <problem>
        <paragraph>$$\left( {3,\frac{\pi}{6}} \right)$$</paragraph>
      </problem>
      <solution/>
    </exercise>
    <exercise number="126" has_solution="false">
      <problem>
        <paragraph>$$\left( {-2,\frac{5\pi}{3}} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="127" has_solution="true">
      <problem>
        <paragraph>$$\left( {0,\frac{7\pi}{6}} \right)$$</paragraph>
      </problem>
      <solution/>
    </exercise>
    <exercise number="128" has_solution="false">
      <problem>
        <paragraph>$$\left( {-4,\frac{3\pi}{4}} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="129" has_solution="true">
      <problem>
        <paragraph>$$\left( {1,\frac{\pi}{4}} \right)$$</paragraph>
      </problem>
      <solution/>
    </exercise>
    <exercise number="130" has_solution="false">
      <problem>
        <paragraph>$$\left( {2,\frac{5\pi}{6}} \right)$$</paragraph>
