  <exercise number="227" has_solution="true">
    <problem>
      <p>Find the position vector $$\mathbf{\text{r}}(t)$$ and the parametric representation for the position.</p>
    </problem>
    <solution>
      <p>$$\mathbf{\text{r}}(t) = \textbf{v}_{0}t - \frac{g}{2}t^{2}\mspace{2mu}\mathbf{\text{j}},$$ $$\mathbf{\text{r}}(t) = \left\langle {\textbf{v}_{0}(\text{cos}\mspace{2mu}\theta)t,\textbf{v}_{0}(\text{sin}\mspace{2mu}\theta)t, - \frac{g}{2}t^{2}} \right\rangle$$</p>
    </solution>
  </exercise>
