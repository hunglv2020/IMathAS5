  <equation>
    <label>Vector Equation of a Plane</label>
    <formula>$$a\left( {x - x_{0}} \right) + b\left( {y - y_{0}} \right) + c\left( {z - z_{0}} \right) = 0$$</formula>
  </equation>
  <equation>
    <label>Scalar Equation of a Plane</label>
    <formula>$$d = \left\| {\text{proj}_{\mathbf{\text{n}}}\overset{\rightarrow}{QP}} \right\| = \left| {\text{comp}_{\mathbf{\text{n}}}\overset{\rightarrow}{QP}} \right| = \frac{\left| {\overset{\rightarrow}{QP} \cdot \mathbf{\text{n}}} \right|}{\left\| \mathbf{\text{n}} \right\|}$$</formula>
  </equation>
