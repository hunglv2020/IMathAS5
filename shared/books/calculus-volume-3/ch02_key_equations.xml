  <equation>
    <label>Distance between two points in space:</label>
    <formula>$$d = \sqrt{\left( {x_{2} - x_{1}} \right)^{2} + \left( {y_{2} - y_{1}} \right)^{2} + \left( {z_{2} - z_{1}} \right)^{2}}$$</formula>
  </equation>
