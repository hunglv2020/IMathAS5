  <exercise number="407" has_solution="true">
    <problem>
      <p>$$h\left( {x,y,z} \right) = \frac{x^{3}e^{2y}}{z}$$</p>
    </problem>
    <solution>
      <p>$$h_{xx}\left( {x,y,z} \right) = \frac{6xe^{2y}}{z},$$ $$h_{xy}(x,y,z) = \frac{6x^{2}e^{2y}}{z},$$ $$h_{xz}\left( {x,y,z} \right) = - \frac{3x^{2}e^{2y}}{z^{2}},$$ $$h_{yx}\left( {x,y,z} \right) = \frac{6x^{2}e^{2y}}{z},$$ $$h_{yy}\left( {x,y,z} \right) = \frac{4x^{3}e^{2y}}{z},$$ $$h_{yz}\left( {x,y,z} \right) = - \frac{2x^{3}e^{2y}}{z^{2}},$$ $$h_{zx}\left( {x,y,z} \right) = - \frac{3x^{2}e^{2y}}{z^{2}},$$ $$h_{zy}\left( {x,y,z} \right) = - \frac{2x^{3}e^{2y}}{z^{2}},$$ $$h_{zz}\left( {x,y,z} \right) = \frac{2x^{3}e^{2y}}{z^{3}}$$</p>
    </solution>
  </exercise>
