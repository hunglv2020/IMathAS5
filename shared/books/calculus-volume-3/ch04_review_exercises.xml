  <exercise number="415" has_solution="true">
    <problem>
      <p>$$f\left( {x,y} \right) = \frac{\sqrt{x} + y^{2}}{xy}$$</p>
    </problem>
    <solution>
      <p>$$\nabla f\left( {x,y} \right) = - \frac{\sqrt{x} + 2y^{2}}{2x^{2}y}\text{i} + \left( {\frac{1}{x} - \frac{1}{\sqrt{x}y^{2}}} \right)\text{j}$$</p>
    </solution>
