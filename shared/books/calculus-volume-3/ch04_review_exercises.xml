  <exercise number="411" has_solution="true">
    <problem>
      <p>Find the differential $$dz$$ of $$h\left( {x,y} \right) = 4x^{2} + 2xy - 3y$$ and approximate $$\text{Δ}z$$ at the point $$\left( {1,-2} \right).$$ Let $$\text{Δ}x = 0.1$$ and $$\text{Δ}y = 0.01.$$</p>
    </problem>
    <solution>
      <p>$$dz = 4dx - dy,$$ $$dz(0.1,0.01) = 0.39,$$ $$\text{Δ}z = 0.432$$</p>
    </solution>
  </exercise>
