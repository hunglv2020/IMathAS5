  <exercise number="129" has_solution="true">
    <problem>
      <p>$$y^{\operatorname{''}} + 5y\prime + 4y = x + e^{2x}$$</p>
    </problem>
    <solution>
      <p>$$y = c_{1}e^{\text{−}x} + c_{2}e^{-4x} + \frac{x}{4} + \frac{e^{2x}}{18} - \frac{5}{16}$$</p>
    </solution>
  </exercise>
