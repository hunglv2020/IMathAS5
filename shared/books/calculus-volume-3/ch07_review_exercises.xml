  <exercise number="135" has_solution="true">
    <problem>
      <p>$$4y^{\prime} = -6y + 2y^{''},$$ $$y(0) = 0,$$ $$y(1) = 1$$</p>
    </problem>
    <solution>
      <p>$$y = \frac{e^{1 - x}}{e^{4} - 1}\left( {e^{4x} - 1} \right)$$</p>
    </solution>
  </exercise>
