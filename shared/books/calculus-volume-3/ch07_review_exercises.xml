<review_exercises chapter="7">
  <exercise number="117" has_solution="true">
    <problem>
      <p>If $$y$$ and $$z$$ are both solutions to $$y^{''} + 2y^{\prime} + y = 0,$$ then $$y + z$$ is also a solution.</p>
    </problem>
    <solution>
      <p>True</p>
    </solution>
  </exercise>
