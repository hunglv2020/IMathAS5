<?xml version='1.0' encoding='utf-8'?>
<key_equations chapter="1">
  <equation>
    <label>Derivative of parametric equations</label>
    <formula>$$\frac{dy}{dx} = \frac{{dy}\text{/}{dt}}{{dx}\text{/}{dt}} = \frac{y^{\prime}(t)}{x^{\prime}(t)}$$</formula>
  </equation>
  <equation>
    <label>Second-order derivative of parametric equations</label>
    <formula>$$\frac{d^{2}y}{dx^{2}} = \frac{d}{dx}\left( \frac{dy}{dx} \right) = \frac{\left( {d\text{/}{dt}} \right)\left( {{dy}\text{/}{dx}} \right)}{{dx}\text{/}{dt}}$$</formula>
  </equation>
  <equation>
    <label>Area under a parametric curve</label>
    <formula>$$A = {\int_{a}^{b}{y(t)x^{\prime}(t)\ dt}}$$</formula>
  </equation>
  <equation>
    <label>Arc length of a parametric curve</label>
    <formula>$$s = {\int_{t_{1}}^{t_{2}}{\sqrt{\left( \frac{dx}{dt} \right)^{2} + \left( \frac{dy}{dt} \right)^{2}}dt}}$$</formula>
  </equation>
  <equation>
    <label>Surface area generated by a parametric curve</label>
    <formula>$$S = 2\pi{\int_{a}^{b}{y(t)\sqrt{\left( {x^{\prime}(t)} \right)^{2} + \left( {y^{\prime}(t)} \right)^{2}}dt}}$$</formula>
  </equation>
  <equation>
    <label>Area of a region bounded by a polar curve</label>
    <formula>$$A = \frac{1}{2}{\int_{\alpha}^{\beta}{\left\lbrack {f(\theta)} \right\rbrack^{2}d\theta}} = \frac{1}{2}{\int_{\alpha}^{\beta}{r^{2}d\theta}}$$</formula>
  </equation>
  <equation>
    <label>Arc length of a polar curve</label>
    <formula>$$L = {\int_{\alpha}^{\beta}\sqrt{\left\lbrack {f(\theta)} \right\rbrack^{2} + \left\lbrack {f^{\prime}(\theta)} \right\rbrack^{2}}}d\theta = {\int_{\alpha}^{\beta}{\sqrt{r^{2} + \left( \frac{dr}{d\theta} \right)^{2}}d\theta}}$$</formula>
  </equation>
</key_equations>
