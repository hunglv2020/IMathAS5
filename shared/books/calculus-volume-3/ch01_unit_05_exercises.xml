      </problem>
    </exercise>
    <exercise number="321" has_solution="true">
      <problem>
        <paragraph>Jupiter: length of major axis = 10.408, eccentricity = 0.0484</paragraph>
      </problem>
      <solution>
        <paragraph>$$r = 5.192 1 + 0.0484 cos \theta r = 5.192 1 + 0.0484 cos \theta$$</paragraph>
      </solution>
    </exercise>
