    <paragraph>For the following equations, determine which of the conic sections is described.</paragraph>
    <exercise number="306" has_solution="false">
      <problem>
        <paragraph>$$12x = 5y^{2}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="307" has_solution="true">
      <problem>
        <paragraph>$$xy = 4$$</paragraph>
      </problem>
      <solution>
        <paragraph>Hyperbola</paragraph>
      </solution>
    </exercise>
    <exercise number="308" has_solution="false">
      <problem>
        <paragraph>$$x^{2} + 4xy - 2y^{2} - 6 = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="309" has_solution="true">
      <problem>
        <paragraph>$$x^{2} + 2\sqrt{3}xy + 3y^{2} - 6 = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>Ellipse</paragraph>
      </solution>
    </exercise>
    <exercise number="310" has_solution="false">
      <problem>
        <paragraph>$$x^{2} - xy + y^{2} - 2 = 0$$</paragraph>
      </problem>
    </exercise>
