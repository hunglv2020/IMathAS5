<?xml version="1.0" encoding="UTF-8"?>
<section>
  <exercises>
    <heading level="1">Section 7.1 Exercises</heading>
    <paragraph>Classify each of the following equations as linear or nonlinear. If the equation is linear, determine whether it is homogeneous or nonhomogeneous.</paragraph>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>$$x^{3}y^{''} + \left( {x - 1} \right)y^{\prime} - 8y = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>linear, homogenous</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>$$\left( {1 + y^{2}} \right)y^{''} + xy^{\prime} - 3y = \cos x$$</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>$$xy^{''} + e^{y}y^{\prime} = x$$</paragraph>
      </problem>
      <solution>
        <paragraph>nonlinear</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>$$y^{''} + \frac{4}{x}y^{\prime} - 8xy = 5x^{2} + 1$$</paragraph>
      </problem>
    </exercise>
    <exercise number="5" has_solution="true">
      <problem>
        <paragraph>$$y^{''} + \left( {\sin x} \right)y^{\prime} - xy = 4y$$</paragraph>
      </problem>
      <solution>
        <paragraph>linear, homogeneous</paragraph>
      </solution>
    </exercise>
    <exercise number="6" has_solution="false">
      <problem>
        <paragraph>$$y^{''} + \left( \frac{x + 3}{y} \right)y^{\prime} = 0$$</paragraph>
      </problem>
    </exercise>
    <paragraph>For each of the following problems, verify that the given function is a solution to the differential equation. Use a graphing utility to graph the particular solutions for several values of c1 and c2. What do the solutions have in common?</paragraph>
    <exercise number="7" has_solution="false">
      <problem>
        <paragraph>[T] $$y^{''} + 2y^{\prime} - 3y = 0;$$ $$y(x) = c_{1}e^{x} + c_{2}e^{-3x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="8" has_solution="false">
      <problem>
        <paragraph>[T] $$x^{2}y^{''} - 2y - 3x^{2} + 1 = 0;$$ $$y(x) = c_{1}x^{2} + c_{2}x^{-1} + x^{2}\ln (x) + \frac{1}{2}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="9" has_solution="false">
      <problem>
        <paragraph>[T] $$y^{''} + 14y^{\prime} + 49y = 0;$$ $$y(x) = c_{1}e^{-7x} + c_{2}xe^{-7x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="10" has_solution="false">
      <problem>
        <paragraph>[T] $$6y^{''} - 49y^{\prime} + 8y = 0;$$ $$y(x) = c_{1}e^{x/6} + c_{2}e^{8x}$$</paragraph>
        <paragraph>Find the general solution to the linear differential equation.</paragraph>
      </problem>
    </exercise>
    <exercise number="11" has_solution="true">
      <problem>
        <paragraph>$$y^{''} - 3y^{\prime} - 10y = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = c 1 e 5 x + c 2 e -2 x y = c 1 e 5 x + c 2 e -2 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="12" has_solution="false">
      <problem>
        <paragraph>$$y^{''} - 7y^{\prime} + 12y = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="13" has_solution="true">
      <problem>
        <paragraph>$$y^{''} + 4y^{\prime} + 4y = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = c 1 e -2 x + c 2 x e -2 x y = c 1 e -2 x + c 2 x e -2 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="14" has_solution="false">
      <problem>
        <paragraph>$$4y^{''} - 12y^{\prime} + 9y = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="15" has_solution="true">
      <problem>
        <paragraph>$$2y^{''} - 3y^{\prime} - 5y = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = c 1 e 5 x / 2 + c 2 e - x y = c 1 e 5 x / 2 + c 2 e - x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="16" has_solution="false">
      <problem>
        <paragraph>$$3y^{''} - 14y^{\prime} + 8y = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="17" has_solution="true">
      <problem>
        <paragraph>$$y^{''} + y^{\prime} + y = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = e - x / 2 ( c 1 cos 3 x 2 + c 2 sin 3 x 2 ) y = e - x / 2 ( c 1 cos 3 x 2 + c 2 sin 3 x 2 )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="18" has_solution="false">
      <problem>
        <paragraph>$$5y^{''} + 2y^{\prime} + 4y = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="19" has_solution="true">
      <problem>
        <paragraph>$$y^{''} - 121y = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = c 1 e -11 x + c 2 e 11 x y = c 1 e -11 x + c 2 e 11 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="20" has_solution="false">
      <problem>
        <paragraph>$$8y^{''} + 14y^{\prime} - 15y = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="21" has_solution="true">
      <problem>
        <paragraph>$$y^{''} + 81y = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = c 1 cos 9 x + c 2 sin 9 x y = c 1 cos 9 x + c 2 sin 9 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="22" has_solution="false">
      <problem>
        <paragraph>$$y^{''} - y^{\prime} + 11y = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="23" has_solution="true">
      <problem>
        <paragraph>$$2y^{''} = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = c 1 + c 2 x y = c 1 + c 2 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="24" has_solution="false">
      <problem>
        <paragraph>$$y^{''} - 6y^{\prime} + 9y = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="25" has_solution="true">
      <problem>
        <paragraph>$$3y^{''} - 2y^{\prime} - 7y = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = c 1 e ( ( 1 + 22 ) / 3 ) x + c 2 e ( ( 1 - 22 ) / 3 ) x y = c 1 e ( ( 1 + 22 ) / 3 ) x + c 2 e ( ( 1 - 22 ) / 3 ) x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="26" has_solution="false">
      <problem>
        <paragraph>$$4y^{''} - 10y^{\prime} = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="27" has_solution="true">
      <problem>
        <paragraph>$$36\frac{d^{2}y}{dx^{2}} + 12\frac{dy}{dx} + y = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = c 1 e - x / 6 + c 2 x e - x / 6 y = c 1 e - x / 6 + c 2 x e - x / 6$$</paragraph>
      </solution>
    </exercise>
    <exercise number="28" has_solution="false">
      <problem>
        <paragraph>$$25\frac{d^{2}y}{dx^{2}} - 80\frac{dy}{dx} + 64y = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="29" has_solution="true">
      <problem>
        <paragraph>$$\frac{d^{2}y}{dx^{2}} - 9\frac{dy}{dx} = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = c 1 + c 2 e 9 x y = c 1 + c 2 e 9 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="30" has_solution="false">
      <problem>
        <paragraph>$$4\frac{d^{2}y}{dx^{2}} + 8y = 0$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Solve the initial-value problem.</paragraph>
    <exercise number="31" has_solution="true">
      <problem>
        <paragraph>$$y^{''} + 5y^{\prime} + 6y = 0, y(0) = 0, y^{\prime}(0) = -2$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = -2 e -2 x + 2 e -3 x y = -2 e -2 x + 2 e -3 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="32" has_solution="false">
      <problem>
        <paragraph>$$y^{''} + 2y^{\prime} - 8y = 0, y(0) = 5, y^{\prime}(0) = 4$$</paragraph>
      </problem>
    </exercise>
    <exercise number="33" has_solution="true">
      <problem>
        <paragraph>$$y^{''} + 4y = 0, y(0) = 3, y^{\prime}(0) = 10$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = 3 cos ( 2 x ) + 5 sin ( 2 x ) y = 3 cos ( 2 x ) + 5 sin ( 2 x )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="34" has_solution="false">
      <problem>
        <paragraph>$$y^{''} - 18y^{\prime} + 81y = 0, y(0) = 1, y^{\prime}(0) = 5$$</paragraph>
      </problem>
    </exercise>
    <exercise number="35" has_solution="true">
      <problem>
        <paragraph>$$y^{''} - y^{\prime} - 30y = 0, y(0) = 1, y^{\prime}(0) = -16$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = - e 6 x + 2 e -5 x y = - e 6 x + 2 e -5 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="36" has_solution="false">
      <problem>
        <paragraph>$$4y^{''} + 4y^{\prime} - 8y = 0, y(0) = 2, y^{\prime}(0) = 1$$</paragraph>
      </problem>
    </exercise>
    <exercise number="37" has_solution="true">
      <problem>
        <paragraph>$$25y^{''} + 10y^{\prime} + y = 0, y(0) = 2, y^{\prime}(0) = 1$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = 2 e - x / 5 + 7 5 x e - x / 5 y = 2 e - x / 5 + 7 5 x e - x / 5$$</paragraph>
      </solution>
    </exercise>
    <exercise number="38" has_solution="false">
      <problem>
        <paragraph>$$y^{''} + y = 0, y(\pi) = 1, y^{\prime}(\pi) = -5$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Solve the boundary-value problem, if possible.</paragraph>
    <exercise number="39" has_solution="true">
      <problem>
        <paragraph>$$y^{''} + y^{\prime} - 42y = 0, y(0) = 0, y(1) = 2$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = ( 2 e 6 - e -7 ) e 6 x - ( 2 e 6 - e -7 ) e -7 x y = ( 2 e 6 - e -7 ) e 6 x - ( 2 e 6 - e -7 ) e -7 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="40" has_solution="false">
      <problem>
        <paragraph>$$9y^{''} + y = 0, y(\frac{3\pi}{2}) = 6, y(0) = -8$$</paragraph>
      </problem>
    </exercise>
    <exercise number="41" has_solution="true">
      <problem>
        <paragraph>$$y^{''} + 10y^{\prime} + 34y = 0, y(0) = 6, y(\pi) = 2$$</paragraph>
      </problem>
      <solution>
        <paragraph>No solutions exist.</paragraph>
      </solution>
    </exercise>
    <exercise number="42" has_solution="false">
      <problem>
        <paragraph>$$y^{''} + 7y^{\prime} - 60y = 0, y(0) = 4, y(2) = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="43" has_solution="true">
      <problem>
        <paragraph>$$y^{''} - 4y^{\prime} + 4y = 0, y(0) = 2, y(1) = -1$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = 2 e 2 x - 2 e 2 + 1 e 2 x e 2 x y = 2 e 2 x - 2 e 2 + 1 e 2 x e 2 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="44" has_solution="false">
      <problem>
        <paragraph>$$y^{''} - 5y^{\prime} = 0, y(0) = 3, y(-1) = 2$$</paragraph>
      </problem>
    </exercise>
    <exercise number="45" has_solution="true">
      <problem>
        <paragraph>$$y^{''} + 9y = 0, y(0) = 4, y\left( \frac{\pi}{3} \right) = -4$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = 4 cos 3 x + c 2 sin 3 x , infinitely many solutions y = 4 cos 3 x + c 2 sin 3 x , infinitely many solutions$$</paragraph>
      </solution>
    </exercise>
    <exercise number="46" has_solution="false">
      <problem>
        <paragraph>$$4y^{''} + 25y = 0, y(0) = 2, y(2\pi) = -2$$</paragraph>
      </problem>
    </exercise>
    <exercise number="47" has_solution="true">
      <problem>
        <paragraph>Find a differential equation with a general solution that is $$y = c_{1}e^{x/5} + c_{2}e^{-4x}.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$5 y ″ + 19 y ′ - 4 y = 0 5 y ″ + 19 y ′ - 4 y = 0$$</paragraph>
      </solution>
    </exercise>
    <exercise number="48" has_solution="false">
      <problem>
        <paragraph>Find a differential equation with a general solution that is $$y = c_{1}e^{x} + c_{2}e^{-4x/3}.$$</paragraph>
      </problem>
    </exercise>
    <paragraph>For each of the following differential equations:</paragraph>
    <list type="ordered">
      <item>Solve the initial value problem.</item>
      <item>[T] Use a graphing utility to graph the particular solution.</item>
    </list>
    <exercise number="49" has_solution="true">
      <problem>
        <paragraph>$$y^{''} + 64y = 0; y(0) = 3, y^{\prime}(0) = -24$$</paragraph>
      </problem>
      <solution>
        <paragraph>a. $$y=3cos(8x)y=3cos(8x)$$ b.</paragraph>
      </solution>
    </exercise>
    <exercise number="50" has_solution="false">
      <problem>
        <paragraph>$$y^{''} - 2y^{\prime} + 10y = 0 y(0) = 1, y^{\prime}(0) = 13$$</paragraph>
      </problem>
    </exercise>
    <exercise number="51" has_solution="true">
      <problem>
        <paragraph>$$y^{''} + 5y^{\prime} + 15y = 0 y(0) = -2, y^{\prime}(0) = 7$$</paragraph>
      </problem>
      <solution>
        <paragraph>a. $$y=e(-5/2)x[-2cos(352x)+43535sin(352x)]y=e(-5/2)x[-2cos(352x)+43535sin(352x)]$$ b.</paragraph>
      </solution>
    </exercise>
    <exercise number="52" has_solution="false">
      <problem>
        <paragraph>(Principle of superposition) Prove that if $$y_{1}(x)$$ and $$y_{2}(x)$$ are solutions to a linear homogeneous differential equation, $$y^{''} + p(x)y^{\prime} + q(x)y = 0,$$ then the function $$y(x) = c_{1}y_{1}(x) + c_{2}y_{2}(x),$$ where $$c_{1}$$ and $$c_{2}$$ are constants, is also a solution.</paragraph>
      </problem>
    </exercise>
    <exercise number="53" has_solution="false">
      <problem>
        <paragraph>Prove that if a, b, and c are positive constants, then all solutions to the second-order linear differential equation $$ay^{''} + by^{\prime} + cy = 0$$ approach zero as $$x\rightarrow\infty.$$ (Hint: Consider three cases: two distinct roots, repeated real roots, and complex conjugate roots.)</paragraph>
      </problem>
    </exercise>
  </exercises>
</section>
