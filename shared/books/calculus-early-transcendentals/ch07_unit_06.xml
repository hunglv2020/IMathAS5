          </statement>
        </problem>
        <problem number="41">
          <statement>
            <paragraph>
              <math display="inline">$${\int{x^{2}\sqrt{x^{2} + 4}}}dx$$</math>
            </paragraph>
          </statement>
          <answer>
            <paragraph>
              <math display="inline">$$\frac{1}{4}x\left( {x^{2} + 2} \right)\sqrt{x^{2} + 4^{}} - 2\ln\left( {\sqrt{x^{2} + 4^{}} + x} \right) + C$$</math>
            </paragraph>
          </answer>
        </problem>
        <problem number="42">
          <statement>
            <paragraph>
              <math display="inline">$$\int\frac{dx}{e^{ x}\left( {3e^{ x} + 2} \right)}$$</math>
