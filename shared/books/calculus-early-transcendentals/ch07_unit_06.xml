              <math display="inline">$${\int{\sec^{4}x}}dx$$</math>
            </paragraph>
          </statement>
          <answer>
            <paragraph>
              <math display="inline">$$\frac{1}{3}\tan x\sec^{2}x + \frac{2}{3}\tan x + C$$</math>
            </paragraph>
