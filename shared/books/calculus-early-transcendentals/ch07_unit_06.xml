              <math display="inline">$${\int{x^{3}\arcsin{(x^{2})}}}dx$$</math>
            </paragraph>
          </statement>
        </problem>
        <problem number="27">
          <statement>
            <paragraph>
              <math display="inline">$${\int\cos^{5}y}\mathit{dy}$$</math>
            </paragraph>
          </statement>
          <answer>
            <paragraph>
              <math display="inline">$$\frac{1}{15}\sin y\left( 3\cos^{4}y + 4\cos^{2}y + 8 \right) + C$$</math>
            </paragraph>
          </answer>
        </problem>
        <problem number="28">
