    <heading level="1">7.4. Exercises</heading>
    <instruction>1, 2, 3, 4, 5, and 6 Write out the form of the partial fraction decomposition of the function (as in Example 7). Do not determine the numerical values of the coefficients.</instruction>
    <exercise number="1" has_solution="true">
      <problem>
        <list type="ordered">
          <item>$$\frac{1}{(x - 3)(x + 5)}$$</item>
          <item>$$\frac{2x + 5}{{(x - 2)}^{2}(x^{2} + 2)}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$\frac{A}{x - 3} + \frac{B}{x + 5}$$</paragraph>
        <paragraph>$$\frac{A}{x - 2} + \frac{B}{{(x - 2)}^{2}} + \frac{\mathit{Cx} + D}{x^{2} + 2}$$</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <list type="ordered">
          <item>$$\frac{x - 6}{x^{2} + x - 6}$$</item>
          <item>$$\frac{1}{x^{2} + x^{4}}$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <list type="ordered">
          <item>$$\frac{x^{2} + 4}{x^{3} - 3x^{2} + 2x}$$</item>
          <item>$$\frac{x^{3} + x}{x{(2x - 1)}^{2}{(x^{2} + 3)}^{2}}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$\frac{A}{x} + \frac{B}{x - 1} + \frac{C}{x - 2}$$</paragraph>
        <paragraph>$$\frac{A}{x} + \frac{B}{2x - 1} + \frac{C}{{(2x - 1)}^{2}} + \frac{Dx + E}{x^{2} + 3} + \frac{Fx + G}{{({x^{2} + 3})}^{2}}$$</paragraph>
      </solution>
    </exercise>
