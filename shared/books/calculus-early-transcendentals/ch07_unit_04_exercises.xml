          <item>$$\frac{x^{2}}{x^{2} + x - 6}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$\frac{A}{x} + \frac{B}{x - 1} + \frac{Cx + D}{x^{2} + 1} + \frac{Ex + F}{{({x^{2} + 1})}^{2}}$$</paragraph>
        <paragraph>$$1 + \frac{A}{x - 2} + \frac{B}{x + 3}$$</paragraph>
      </solution>
    </exercise>
