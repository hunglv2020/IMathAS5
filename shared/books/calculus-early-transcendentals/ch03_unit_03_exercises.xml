    <paragraph>61–62 Find the given derivative by finding the first few derivatives and observing the pattern that occurs.</paragraph>
    <exercise number="61" has_solution="true">
      <problem>
        <paragraph>$$\frac{d^{99}}{{dx}^{99}}\left( {\sin x} \right)$$</paragraph>
      </problem>
      <solution>
