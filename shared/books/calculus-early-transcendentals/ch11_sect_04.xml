        <problem number="1">
          <statement>
            <paragraph>
              Suppose <math display="inline">$$\sum a_{n}$$</math> and <math display="inline">$$\sum b_{n}$$</math> are series with positive terms and <math display="inline">$$\sum b_{n}$$</math> is known to be convergent.
            </paragraph>
            <list ordered="true">
              <item>
                <paragraph>
                  If <math display="inline">$$a_{n} &gt; b_{n}$$</math> for all <math display="inline">$$n$$</math> , what can you say about <math display="inline">$$\sum a_{n}$$</math> ? Why?
                </paragraph>
                <paragraph>
                  Nothing
                </paragraph>
              </item>
              <item>
                <paragraph>
                  If <math display="inline">$$a_{n} &lt; b_{n}$$</math> for all <math display="inline">$$n$$</math> , what can you say about <math display="inline">$$\sum a_{n}$$</math> ? Why?
                </paragraph>
                <paragraph>
                  C
                </paragraph>
              </item>
            </list>
          </statement>
        </problem>
