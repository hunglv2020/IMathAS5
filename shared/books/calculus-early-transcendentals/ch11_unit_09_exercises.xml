<?xml version="1.0" encoding="UTF-8"?>
<section>
  <exercises>
    <heading level="1">11.9. Exercises</heading>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>If the radius of convergence of the power series $$\sum_{n = 0}^{\infty}{c_{n}x^{n}}$$ is $$10$$ , what is the radius of convergence of the series $$\sum_{n = 1}^{\infty}{nc_{n}x^{n - 1}}$$ ? Why?</paragraph>
      </problem>
      <solution>
        <paragraph>$$10$$</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>Suppose you know that the series $$\sum_{n = 0}^{\infty}b_{n}x^{n}$$ converges for $$|x| &lt; 2$$ . What can you say about the following series? Why?</paragraph>
        <paragraph math="block">$$\overset{\infty}{\sum\limits_{n = 0}}\frac{b_{n}}{n + 1}x^{n + 1}$$</paragraph>
      </problem>
    </exercise>
    <instruction>3, 4, 5, 6, 7, 8, 9, 10, 11 and 12 Find a power series representation for the function and determine the interval of convergence.</instruction>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{1}{1 + x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 0}^{\infty}{\left( {- 1} \right)^{n}x^{n}}$$ , $$( - 1,1)$$</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{x}{1 + x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="5" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{1}{1 - x^{2}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 0}^{\infty}x^{2n}$$ , $$( - 1,1)$$</paragraph>
      </solution>
    </exercise>
    <exercise number="6" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{5}{1 - 4x^{2}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="7" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{2}{3 - x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2\sum\limits_{n = 0}^{\infty}{\frac{1}{3^{n + 1}}x^{n}}$$ , $$( - 3,3)$$</paragraph>
      </solution>
    </exercise>
    <exercise number="8" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{4}{2x + 3}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="9" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{x^{2}}{x^{4} + 16}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 0}^{\infty}\frac{\left( {- 1} \right)^{n}x^{4n + 2}}{2^{4n + 4}}$$ , $$\left( {- 2,2} \right)$$</paragraph>
      </solution>
    </exercise>
    <exercise number="10" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{x}{2x^{2} + 1}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="11" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{x - 1}{x + 2}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$- \frac{1}{2} - {\sum\limits_{n = 1}^{\infty}\frac{{( - 1)}^{n}3x^{n}}{2^{n + 1}}}$$ , $$( - 2,2)$$</paragraph>
      </solution>
    </exercise>
    <exercise number="12" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{x + a}{x^{2} + a^{2}}, a &gt; 0$$</paragraph>
      </problem>
    </exercise>
    <instruction>13 and 14 Express the function as the sum of a power series by first using partial fractions. Find the interval of convergence.</instruction>
    <exercise number="13" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{2x - 4}{x^{2} - 4x + 3}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 0}^{\infty}{\left( {- 1 - \frac{1}{3^{n + 1}}} \right)x^{n}}$$ , $$\left( {- 1,1} \right)$$</paragraph>
      </solution>
    </exercise>
    <exercise number="14" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{2x + 3}{x^{2} + 3x + 2}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="15" has_solution="true">
      <problem>
        <list type="ordered">
          <item>Use differentiation to find a power series representation for $$f(x) = \frac{1}{\left( {1 + x} \right)^{2}}$$ What is the radius of convergence?</item>
          <item>Use part (a) to find a power series for $$f(x) = \frac{1}{\left( {1 + x} \right)^{3}}$$</item>
          <item>Use part (b) to find a power series for $$f(x) = \frac{x^{2}}{\left( {1 + x} \right)^{3}}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 0}^{\infty}{\left( {- 1} \right)^{n}\left( {n + 1} \right)x^{n}}$$ , $$R = 1$$</paragraph>
        <paragraph>$$\frac{1}{2}\sum\limits_{n = 0}^{\infty}{\left( {- 1} \right)^{n}\left( {n + 2} \right)\left( {n + 1} \right)x^{n}}$$ , $$R = 1$$</paragraph>
        <paragraph>$$\frac{1}{2}\sum\limits_{n = 2}^{\infty}{\left( {- 1} \right)^{n}n\left( {n - 1} \right)x^{n}}$$ , $$R = 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="16" has_solution="false">
      <problem>
        <list type="ordered">
          <item>Use Equation 1 to find a power series representation for $$f(x) = \ln\left( {1 - x} \right)$$ . What is the radius of convergence?</item>
          <item>Use part (a) to find a power series for $$f(x) = x\ln\left( {1 - x} \right)$$ .</item>
          <item>By putting $$x = \frac{1}{2}$$ in your result from part (a), express $$\ln 2$$ as the sum of an infinite series.</item>
        </list>
      </problem>
    </exercise>
    <instruction>17, 18, 19, 20, 21 and 22 Find a power series representation for the function and determine the radius of convergence.</instruction>
    <exercise number="17" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{x}{\left( {1 + 4x} \right)^{2}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 0}^{\infty}{\left( {- 1} \right)^{n}4^{n}\left( {n + 1} \right)x^{n + 1}}$$ , $$R = \frac{1}{4}$$</paragraph>
      </solution>
    </exercise>
    <exercise number="18" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \left( \frac{x}{2 - x} \right)^{3}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="19" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{1 + x}{\left( {1 - x} \right)^{2}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 0}^{\infty}{\left( {2n + 1} \right)x^{n}}$$ , $$R = 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="20" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \frac{x^{2} + x}{\left( {1 - x} \right)^{3}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="21" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \ln\left( {5 - x} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\ln 5 - \sum\limits_{n = 1}^{\infty}\frac{x^{n}}{n5^{n}}$$ , $$R = 5$$</paragraph>
      </solution>
    </exercise>
    <exercise number="22" has_solution="false">
      <problem>
        <paragraph>$$f(x) = x^{2}\tan^{- 1}\left( x^{3} \right)$$</paragraph>
      </problem>
    </exercise>
    <instruction>23, 24, 25 and 26 Find a power series representation for $$f$$ , and graph $$f$$ and several partial sums $$s_{n}(x)$$ on the same screen. What happens as $$n$$ increases?</instruction>
    <exercise number="23" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{x^{2}}{x^{2} + 1}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 0}^{\infty}{\left( {- 1} \right)^{n}x^{2n + 2}}$$ , $$R = 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="24" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \ln\left( 1 + x^{4} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="25" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \ln\left( \frac{1 + x}{1 - x} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 0}^{\infty}\frac{2x^{2n + 1}}{2n + 1}$$ , $$R = 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="26" has_solution="false">
      <problem>
        <paragraph>$$f(x) = \tan^{- 1}(2x)$$</paragraph>
      </problem>
    </exercise>
    <instruction>27, 28, 29 and 30 Evaluate the indefinite integral as a power series. What is the radius of convergence?</instruction>
    <exercise number="27" has_solution="true">
      <problem>
        <paragraph>$$\int\frac{t}{1 - t^{8}}dt$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$C + \sum\limits_{n = 0}^{\infty}\frac{t^{8n + 2}}{8n + 2}$$ , $$R = 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="28" has_solution="false">
      <problem>
        <paragraph>$$\int\frac{t}{1 + t^{3}}dt$$</paragraph>
      </problem>
    </exercise>
    <exercise number="29" has_solution="true">
      <problem>
        <paragraph>$$\int x^{2}\ln({1 + x})dx$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$C + \sum\limits_{n = 1}^{\infty}{\left( {- 1} \right)^{n - 1}\frac{x^{n + 3}}{n\left( {n + 3} \right)}}$$ , $$R = 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="30" has_solution="false">
      <problem>
        <paragraph>$$\int\frac{\tan^{- 1}x}{x}dx$$</paragraph>
      </problem>
    </exercise>
    <instruction>31, 32, 33 and 34 Use a power series to approximate the definite integral to six decimal places.</instruction>
    <exercise number="31" has_solution="true">
      <problem>
        <paragraph>$$\int_{0}^{0.3}\frac{x}{1 + x^{3}}dx$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$0.044522$$</paragraph>
      </solution>
    </exercise>
    <exercise number="32" has_solution="false">
      <problem>
        <paragraph>$$\int_{0}^{1/2}\arctan\frac{x}{2}dx$$</paragraph>
      </problem>
    </exercise>
    <exercise number="33" has_solution="true">
      <problem>
        <paragraph>$$\int_{0}^{0.2}x\ln{\left( {1 + x^{2}} \right)}dx$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$0.000395$$</paragraph>
      </solution>
    </exercise>
    <exercise number="34" has_solution="false">
      <problem>
        <paragraph>$$\int_{0}^{0.3}\frac{x^{2}}{1 + x^{4}}dx$$</paragraph>
      </problem>
    </exercise>
    <exercise number="35" has_solution="true">
      <problem>
        <paragraph>Use the result of Example 6 to compute $$\arctan 0.2$$ correct to five decimal places.</paragraph>
      </problem>
      <solution>
        <paragraph>$$0.19740$$</paragraph>
      </solution>
    </exercise>
    <exercise number="36" has_solution="false">
      <problem>
        <paragraph>Use the result of Example 5 to compute $$\ln 1.1$$ correct to four decimal places.</paragraph>
      </problem>
    </exercise>
    <exercise number="37" has_solution="false">
      <problem>
        <list type="ordered">
          <item>Show that the function $$f(x) = \overset{\infty}{\sum\limits_{n = 0}}\frac{x^{n}}{n!}$$ is a solution of the differential equation $$f^{\prime}(x) = f(x)$$</item>
          <item>Show that $$f(x) = e^{x}$$ .</item>
        </list>
      </problem>
    </exercise>
    <exercise number="38" has_solution="false">
      <problem>
        <paragraph>Show that the function</paragraph>
        <paragraph math="block">$$f(x) = \overset{\infty}{\sum\limits_{n = 0}}\frac{\left( {- 1} \right)^{n}x^{2n}}{\left( {2n} \right)!}$$</paragraph>
        <paragraph>is a solution of the differential equation</paragraph>
        <paragraph math="block">$$f^{''}(x) + f(x) = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="39" has_solution="true">
      <problem>
        <list type="ordered">
          <item>Show that $$J_{0}$$ (the Bessel function of order $$0$$ given in Example 8) satisfies the differential equation $$x^{2}J_{0}^{''}(x) + xJ_{0}^{\prime}(x) + x^{2}J_{0}(x) = 0$$</item>
          <item>Evaluate $$\int_{0}^{1}J_{0}(x)dx$$ correct to three decimal places.</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$0.920$$</paragraph>
      </solution>
    </exercise>
    <exercise number="40" has_solution="false">
      <problem>
        <paragraph>The Bessel function of order $$1$$ is defined by</paragraph>
        <paragraph math="block">$$J_{1}(x) = \overset{\infty}{\sum\limits_{n = 0}}\frac{\left( {- 1} \right)^{n}x^{2n + 1}}{n!\left( {n + 1} \right)!2^{2n + 1}}$$</paragraph>
        <list type="ordered">
          <item>Find the domain of $$J_{1}$$ .</item>
          <item>Show that $$J_{1}$$ satisfies the differential equation $$x^{2}J_{1}^{''}(x) + xJ_{1}^{\prime}(x) + {({x^{2} - 1})}J_{1}(x) = 0$$</item>
          <item>Show that $$J_{0}^{\prime}(x) = - J_{1}(x)$$ .</item>
        </list>
      </problem>
    </exercise>
    <exercise number="41" has_solution="true">
      <problem>
        <paragraph>The function A defined by</paragraph>
        <paragraph math="block">$$A(x) = 1 + \frac{x^{3}}{2 \cdot 3} + \frac{x^{6}}{2 \cdot 3 \cdot 5 \cdot 6} + \frac{x^{9}}{2 \cdot 3 \cdot 5 \cdot 6 \cdot 8 \cdot 9} + \cdots$$</paragraph>
        <paragraph>is called an Airy function after the English mathematician and astronomer Sir George Airy (1801–1892).</paragraph>
        <list type="ordered">
          <item>Find the domain of the Airy function.</item>
          <item>Graph the first several partial sums on a common screen.</item>
          <item>Use a computer algebra system that has built-in Airy functions to graph $$A$$ on the same screen as the partial sums in part (b) and observe how the partial sums approximate $$A$$ .</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$( - \infty,\infty)$$</paragraph>
      </solution>
    </exercise>
    <exercise number="42" has_solution="false">
      <problem>
        <paragraph>If $$f(x) = \sum_{n = 0}^{\infty}c_{n}x^{n}$$ , where $$c_{n + 4} = c_{n}$$ for all $$n \geq 0$$ , find the interval of convergence of the series and a formula for $$f(x)$$ .</paragraph>
      </problem>
    </exercise>
    <exercise number="43" has_solution="true">
      <problem>
        <paragraph>A function $$f$$ is defined by</paragraph>
        <paragraph math="block">$$f(x) = 1 + 2x + x^{2} + 2x^{3} + x^{4} + \cdots$$</paragraph>
        <paragraph>that is, its coefficients are $$c_{2n} = 1$$ and $$c_{2n + 1} = 2$$ for all $$n \geq 0$$ . Find the interval of convergence of the series and find an explicit formula for $$f(x)$$ .</paragraph>
      </problem>
      <solution>
        <paragraph>$$( - 1,1)$$ , $$f(x) = (1 + 2x)/\left( 1 - x^{2} \right)$$</paragraph>
      </solution>
    </exercise>
    <exercise number="44" has_solution="false">
      <problem>
        <paragraph>Let $$f_{n}(x) = (\sin nx)/n^{2}$$ . Show that the series $$\sum f_{n}(x)$$ converges for all values of $$x$$ but the series of derivatives $$\sum f_{n}^{\prime}(x)$$ diverges when $$x = 2n\pi$$ , $$n$$ an integer. For what values of $$x$$ does the series $$\sum f_{n}^{''}(x)$$ converge?</paragraph>
      </problem>
    </exercise>
    <exercise number="45" has_solution="true">
      <problem>
        <paragraph>Let</paragraph>
        <paragraph math="block">$$f(x) = \overset{\infty}{\sum\limits_{n = 1}}\frac{x^{n}}{n^{2}}$$</paragraph>
        <paragraph>Find the intervals of convergence for $$f$$ , $$f^{\prime}$$ , and $$f^{''}$$ .</paragraph>
      </problem>
      <solution>
        <paragraph>$$\lbrack - 1,1\rbrack$$ , $$\lbrack - 1,1)$$ , $$\left( - 1,1) \right.$$</paragraph>
      </solution>
    </exercise>
    <exercise number="46" has_solution="false">
      <problem>
        <list type="ordered">
          <item>Starting with the geometric series $$\sum_{n = 0}^{\infty}x^{n}$$ , find the sum of the series $$\overset{\infty}{\sum\limits_{n = 1}}nx^{n - 1} |x| &lt; 1$$</item>
          <item>Find the sum of each of the following series. $${\sum\limits_{n = 1}^{\infty}nx^{n}, |x|} &lt; 1$$ $$\sum\limits_{n = 1}^{\infty}\frac{n}{2^{n}}$$</item>
          <item>Find the sum of each of the following series. $$\sum\limits_{n = 2}^{\infty}n\left( {n - 1} \right)x^{n}, |x| &lt; 1$$ $$\sum\limits_{n = 2}^{\infty}\frac{n^{2} - n}{2^{n}}$$ $$\sum\limits_{n = 1}^{\infty}\frac{n^{2}}{2^{n}}$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="47" has_solution="true">
      <problem>
        <paragraph>If $$f(x) = 1/(1 - x)$$ , find a power series representation for $$h(x) = xf^{\prime}(x) + x^{2}f^{''}(x)$$ and determine the radius of convergence. Use this to show that</paragraph>
        <paragraph math="block">$$\overset{\infty}{\sum\limits_{n = 1}}\frac{n^{2}}{2^{n}} = 6$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 1}^{\infty}n^{2}x^{n}$$ , $$R = 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="48" has_solution="false">
      <problem>
        <paragraph>Use the power series representation of $$f(x) = 1/{(1 - x)}^{2}$$ and the fact that $$9801 = 99^{2}$$ to show that $$1/9801$$ is a repeating decimal that contains every two digit number in order, except for $$98$$ , as shown.</paragraph>
        <paragraph math="block">$$\frac{1}{9801} = 0.\overline{00 01 02 03 . . . 96 97 99}$$</paragraph>
        <paragraph>[Hint: Consider $$x = \frac{1}{100}$$ .]</paragraph>
      </problem>
    </exercise>
    <exercise number="49" has_solution="false">
      <problem>
        <paragraph>Use the power series for $$\tan^{- 1}x$$ to prove the following expression for $$\pi$$ as the sum of an infinite series:</paragraph>
        <paragraph math="block">$$\pi = 2\sqrt{3}\overset{\infty}{\sum\limits_{n = 0}}\frac{\left( {- 1} \right)^{n}}{\left( {2n + 1} \right)3^{n}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="50" has_solution="false">
      <problem>
        <list type="ordered">
          <item>By completing the square, show that $$\int_{0}^{1/2}\frac{dx}{x^{2} - x + 1} = \frac{\pi}{3\sqrt{3}}$$</item>
          <item>By factoring $$x^{3} + 1$$ as a sum of cubes, rewrite the integral in part (a). Then express $$1/\left( {x^{3} + 1} \right)$$ as the sum of a power series and use it to prove the following formula for $$\pi$$ : $$\pi = \frac{3\sqrt{3}}{4}\overset{\infty}{\sum\limits_{n = 0}}\frac{\left( {- 1} \right)^{n}}{8^{n}}\left( {\frac{2}{3n + 1} + \frac{1}{3n + 2}} \right)$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="51" has_solution="false">
      <problem>
        <paragraph>Use the Ratio Test to show that if the series $$\sum_{n = 0}^{\infty}c_{n}x^{n}$$ has radius of convergence $$R$$ , then each of the series</paragraph>
        <paragraph math="block">$$\overset{\infty}{\sum\limits_{n = 1}}nc_{n}x^{n - 1}$$</paragraph>
        <paragraph>and</paragraph>
        <paragraph math="block">$$\overset{\infty}{\sum\limits_{n = 0}}c_{n}\frac{x^{n + 1}}{n + 1}$$</paragraph>
        <paragraph>also has radius of convergence $$R$$ .</paragraph>
      </problem>
    </exercise>
  </exercises>
</section>
