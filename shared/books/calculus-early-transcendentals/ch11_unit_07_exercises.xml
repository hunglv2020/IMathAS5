<section>
  <exercises>
    <heading level="1">11.7. Exercises</heading>
    <paragraph>1, 2, 3, 4, 5, 6, 7, and 8 Two similar-looking series are given. Test each one for convergence or divergence.</paragraph>
    <exercise number="1" has_solution="true">
      <problem>
        <list type="ordered">
          <item>$$\sum\limits_{n = 1}^{\infty}\frac{1}{5^{n}}$$</item>
          <item>$$\sum\limits_{n = 1}^{\infty}\frac{1}{5^{n} + n}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>C</paragraph>
        <paragraph>C</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <list type="ordered">
          <item>$$\sum\limits_{n = 1}^{\infty}\frac{( - 1)^{n}}{n^{3/2}}$$</item>
          <item>$$\sum\limits_{n = 1}^{\infty}\frac{1}{n^{3/2}}$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <list type="ordered">
          <item>$$\sum\limits_{n = 1}^{\infty}\frac{n}{3^{n}}$$</item>
          <item>$$\sum\limits_{n = 1}^{\infty}\frac{3^{n}}{n}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>C</paragraph>
        <paragraph>D</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <list type="ordered">
          <item>$$\sum\limits_{n = 1}^{\infty}\frac{n + 1}{n}$$</item>
          <item>$$\sum\limits_{n = 1}^{\infty}( - 1)^{n}\frac{n + 1}{n}$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="5" has_solution="true">
      <problem>
        <list type="ordered">
          <item>$$\sum\limits_{n = 1}^{\infty}\frac{n}{n^{2} + 1}$$</item>
          <item>$$\sum\limits_{n = 1}^{\infty}\left( \frac{n}{n^{2} + 1} \right)^{n}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>D</paragraph>
        <paragraph>C</paragraph>
      </solution>
    </exercise>
    <exercise number="6" has_solution="false">
