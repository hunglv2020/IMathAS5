    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>$$y = x^{3} + 3x^{2}$$</paragraph>
      </problem>
      <solution>
        <list type="ordered">
          <item>$$\mathbb{R}$$</item>
          <item>$$y$$ -int $$0$$ ; $$x$$ -int $$- 3$$ , $$0$$</item>
          <item>None</item>
          <item>None</item>
          <item>Inc on $$\left( {- \infty, - 2} \right)$$ , $$\left( {0,\infty} \right)$$ ; dec on $$\left( {- 2,0} \right)$$</item>
          <item>Loc max $$f( - 2) = 4$$ ; loc min $$f(0) = 0$$</item>
          <item>CU on $$\left( {- 1,\infty} \right)$$ ; CD on $$( - \infty, - 1)$$ ; IP $$( - 1,2)$$</item>
          <item>See graph below.</item>
        </list>
      </solution>
    </exercise>
