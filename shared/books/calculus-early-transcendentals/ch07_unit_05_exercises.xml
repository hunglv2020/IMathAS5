      <solution>
        <paragraph>$$\frac{1}{3}e^{x^{3}} + C$$</paragraph>
        <paragraph>$$e^{x}\left( x^{2} - 2x + 2 \right) + C$$</paragraph>
        <paragraph>$$\frac{1}{2}e^{x^{2}}(x^{2} - 1) + C$$</paragraph>
      </solution>
    </exercise>
