<section>
  <exercises>
    <heading level="1">7.5. Exercises</heading>
    <instruction>1, 2, 3, 4, 5, 6, 7, and 8 Three integrals are given that, although they look similar, may require different techniques of integration. Evaluate the integrals.</instruction>
    <exercise number="1" has_solution="true">
      <problem>
        <list type="ordered">
          <item>$${\int\frac{x}{1 + x^{2}}}\mathit{dx}$$</item>
          <item>$${\int\frac{1}{1 + x^{2}}}\mathit{dx}$$</item>
          <item>$${\int\frac{1}{1 - x^{2}}}\mathit{dx}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$\frac{1}{2}\ln(1 + x^{2}) + C$$</paragraph>
        <paragraph>$$\tan^{- 1}x + C$$</paragraph>
        <paragraph>$$\frac{1}{2}\ln|1 + x| - \frac{1}{2}\ln|1 - x| + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <list type="ordered">
          <item>$$\int x\sqrt{x^{2} - 1}\mathit{dx}$$</item>
          <item>$${\int\frac{1}{x\sqrt{x^{2} - 1}}}\mathit{dx}$$</item>
          <item>$${\int\frac{\sqrt{x^{2} - 1}}{x}}\mathit{dx}$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <list type="ordered">
          <item>$${\int\frac{\ln x}{x}}\mathit{dx}$$</item>
          <item>$$\int\ln(2x)\mathit{dx}$$</item>
          <item>$$\int x\ln x\mathit{dx}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$\frac{1}{2}\left( \ln x \right)^{2} + C$$</paragraph>
        <paragraph>$$x\ln(2x) - x + C$$</paragraph>
        <paragraph>$$\frac{1}{2}x^{2}\ln x - \frac{1}{4}x^{2} + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
