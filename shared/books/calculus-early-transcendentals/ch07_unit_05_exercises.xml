          <item>$${\int\frac{1}{x^{2} - 4x + 4}}\mathit{dx}$$</item>
          <item>$${\int\frac{1}{x^{2} - 4x + 5}}\mathit{dx}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$\frac{1}{2}\ln|x - 3| - \frac{1}{2}\ln|x - 1| + C$$</paragraph>
        <paragraph>$$- \frac{1}{x - 2} + C$$</paragraph>
        <paragraph>$$\tan^{- 1}(x - 2) + C$$</paragraph>
      </solution>
    </exercise>
