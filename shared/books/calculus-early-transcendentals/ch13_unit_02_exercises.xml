        <paragraph>$$\mathbf{r}{(t)} = {\langle{t - 2,t^{2} + 1}\rangle}, t = - 1$$</paragraph>
      </problem>
      <solution>
        <paragraph>(a), (c)</paragraph>
        <paragraph>(b) $$\mathbf{r}^{\prime}{(t)} = {\langle{1,2t}\rangle}$$</paragraph>
      </solution>
    </exercise>
