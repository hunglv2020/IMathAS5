        <paragraph>$$\mathbf{r}{(t)} = {\langle{\tan^{- 1}t,2e^{2t},8te^{ t}}\rangle}$$ , $$t = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="19" has_solution="true">
      <problem>
        <paragraph>$$\mathbf{r}{(t)} = \cos t\mathbf{i} + 3t\mathbf{j} + 2\sin 2t\mathbf{k}$$ , $$t = 0$$</paragraph>
      </problem>
