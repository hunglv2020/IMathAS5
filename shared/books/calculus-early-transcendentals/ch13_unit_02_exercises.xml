      <problem>
        <paragraph>$$\mathbf{r}{(t)} = t^{2}\mathbf{i} + \cos{(t^{2})}\mathbf{j} + \sin^{2}t\mathbf{k}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\mathbf{r}^{\prime}{(t)} = 2t\mathbf{i} - 2t\sin{(t^{2})}\mathbf{j} + 2\sin t\cos t\mathbf{k}$$</paragraph>
      </solution>
