      <problem>
        <paragraph>$$x = t^{2} + 1, y = 4\sqrt{t}, z = e^{t^{2} - t}; {({2,4,1})}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x = 2 + 2t$$ , $$y = 4 + 2t$$ , $$z = 1 + t$$</paragraph>
      </solution>
    </exercise>
