    <instruction>37, 38, 39, 40, 41, and 42 Evaluate the integral.</instruction>
    <exercise number="37" has_solution="true">
      <problem>
        <paragraph>$$\int_{0}^{2}{({t\mathbf{i} - t^{3}\mathbf{j} + 3t^{5}\mathbf{k}})}dt$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2\mathbf{i} - 4\mathbf{j} + 32\mathbf{k}$$</paragraph>
      </solution>
    </exercise>
