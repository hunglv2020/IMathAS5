      <problem>
        <paragraph>$$\mathbf{r}{(t)} = {\langle{\sqrt{t - 2},3,1 \slash t^{2}}\rangle}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\mathbf{r}^{\prime}{(t)} = {\langle{\frac{1}{2\sqrt{t - 2}},0, - \frac{2}{t^{3}}}\rangle}$$</paragraph>
      </solution>
    </exercise>
    <exercise number="10" has_solution="false">
