      <problem>
        <paragraph>$${x = t}, {y = e^{- t}}, {z = 2t - t^{2}}; {({0,1,0})}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x = t$$ , $$y = 1 - t$$ , $$z = 2t$$</paragraph>
      </solution>
