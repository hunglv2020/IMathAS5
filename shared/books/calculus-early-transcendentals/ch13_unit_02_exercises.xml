      <problem>
        <paragraph>If $$\mathbf{r}{(t)} = {\langle{t^{4},t,t^{2}}\rangle}$$ , find $$\mathbf{r}^{\prime}{(t)}$$ , $$\mathbf{T}{(1)}$$ , $$\mathbf{r}^{''}{(t)}$$ , and $$\mathbf{r}^{\prime}{(t)} \times \mathbf{r}^{''}{(t)}$$ .</paragraph>
      </problem>
      <solution>
        <paragraph>$$\langle 4t^{3},{1,2t}\rangle$$ , $$\langle{4 \slash \sqrt{21},1 \slash \sqrt{21},2 \slash \sqrt{21}}\rangle$$ , $$\langle{12t^{2},0,2}\rangle$$ , $$\langle 2,16t^{3}, - 12t^{2}\rangle$$</paragraph>
      </solution>
    </exercise>
    <exercise number="24" has_solution="false">
      <problem>
        <paragraph>If $$\mathbf{r}{(t)} = {\langle{e^{2t},e^{- 3t},t}\rangle}$$ , find $$\mathbf{r}^{\prime}{(0)}$$ , $$\mathbf{T}{(0)}$$ , $$\mathbf{r}^{''}{(0)}$$ , and $$\mathbf{r}^{\prime}{(0)} \times \mathbf{r}^{''}{(0)}$$ .</paragraph>
      </problem>
