    <exercise number="13" has_solution="true">
      <problem>
        <paragraph>$$\mathbf{r}{(t)} = t\sin t\mathbf{i} + e^{ t}\cos t\mathbf{j} + \sin t\cos t\mathbf{k}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\mathbf{r}^{\prime}{(t)} = {({t\cos t + \sin t})}\mathbf{i} + e^{ t}{({\cos t - \sin t})}\mathbf{j} + {({\cos^{2}t - \sin^{2}t})}\mathbf{k}$$</paragraph>
      </solution>
    </exercise>
