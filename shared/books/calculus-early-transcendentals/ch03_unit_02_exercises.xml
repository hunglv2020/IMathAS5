    <exercise number="53" has_solution="true">
      <problem>
        <paragraph>If $$g$$ is a differentiable function, find an expression for the derivative of each of the following functions.</paragraph>
        <list type="ordered">
          <item>$$y = xg(x)$$</item>
          <item>$$y = \frac{x}{g(x)}$$</item>
          <item>$$y = \frac{g(x)}{x}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$y^{\prime} = xg^{\prime}(x) + g(x)$$</paragraph>
        <paragraph>$$y^{\prime} = \frac{g(x) - xg^{\prime}(x)}{\left\lbrack {g(x)} \right\rbrack^{2}}$$</paragraph>
        <paragraph>$$y^{\prime} = \frac{xg^{\prime}(x) - g(x)}{x^{2}}$$</paragraph>
      </solution>
    </exercise>
