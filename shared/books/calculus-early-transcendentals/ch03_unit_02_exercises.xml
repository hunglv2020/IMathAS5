    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>Find the derivative of $$f(x) = \left( {1 + 2x^{2}} \right)\left( {x - x^{2}} \right)$$ in two ways: by using the Product Rule and by performing the multiplication first. Do your answers agree?</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 - 2x + 6x^{2} - 8x^{3}$$</paragraph>
      </solution>
    </exercise>
