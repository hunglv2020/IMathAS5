        <paragraph>$${\int{x}}\sin^{2}{(x^{2})}dx$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\frac{1}{4}x^{2} - \frac{1}{4}\sin{(x^{2})}\cos{(x^{2})} + C$$</paragraph>
      </solution>
    </exercise>
