    <exercise number="61" has_solution="true">
      <problem>
        <paragraph>If $${\int_{0}^{\pi \slash 4}{\tan^{6}}}x\sec xdx = I$$ , express the value of $${\int_{0}^{\pi \slash 4}{\tan^{8}x}}\sec xdx$$ in terms of $$I$$ .</paragraph>
      </problem>
      <solution>
        <paragraph>$$\frac{1}{8}(\sqrt{2} - 7I)$$</paragraph>
      </solution>
    </exercise>
