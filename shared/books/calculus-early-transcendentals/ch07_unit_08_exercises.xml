    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>Explain why each of the following integrals is improper.</paragraph>
        <list type="ordered">
          <item>$$\int_{1}^{4}\frac{\mathit{dx}}{x - 3}$$</item>
          <item>$$\int_{3}^{\infty}\frac{\mathit{dx}}{x^{2} - 4}$$</item>
          <item>$${\int_{0}^{1}{\tan\pi x}}dx$$</item>
          <item>$${\int_{- \infty}^{- 1}\frac{e^{x}}{x}}dx$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>Infinite discontinuity</paragraph>
        <paragraph>Infinite interval</paragraph>
        <paragraph>Infinite interval</paragraph>
        <paragraph>Infinite discontinuity</paragraph>
      </solution>
    </exercise>
