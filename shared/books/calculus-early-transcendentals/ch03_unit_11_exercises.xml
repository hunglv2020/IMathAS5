    <exercise number="25" has_solution="true">
      <problem>
        <paragraph>If $$\cosh x = \frac{5}{3}$$ and $$x &gt; 0$$ , find the values of the other hyperbolic functions at $$x$$ .</paragraph>
      </problem>
      <solution>
        <paragraph>$${sech}x = \frac{3}{5}$$ , $$\sinh x = \frac{4}{3}$$ , $${csch}x = \frac{3}{4}$$ , $$\tanh x = \frac{4}{5}$$ , $$\coth x = \frac{5}{4}$$</paragraph>
      </solution>
