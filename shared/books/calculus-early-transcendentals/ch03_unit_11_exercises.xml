    <heading level="1">3.11. Exercises</heading>
    <paragraph>1, 2, 3, 4, 5, and 6 Find the numerical value of each expression.</paragraph>
    <exercise number="1" has_solution="true">
      <problem>
        <list type="ordered">
          <item>$$\sinh 0$$</item>
          <item>$$\cosh 0$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$0$$</paragraph>
        <paragraph>$$1$$</paragraph>
      </solution>
    </exercise>
