    </exercise>
    <exercise number="27" has_solution="true">
      <problem>
        <paragraph>Use the definitions of the hyperbolic functions to find each of the following limits.</paragraph>
        <list type="ordered">
          <item>$$\lim\limits_{x\rightarrow\infty}\tanh x$$</item>
          <item>$$\lim\limits_{x\rightarrow - \infty}\tanh x$$</item>
          <item>$$\lim\limits_{x\rightarrow\infty}\sinh x$$</item>
          <item>$$\lim\limits_{x\rightarrow - \infty}\sinh x$$</item>
          <item>$$\lim\limits_{x\rightarrow\infty}{sech}x$$</item>
          <item>$$\lim\limits_{x\rightarrow\infty}\coth x$$</item>
          <item>$$\lim\limits_{x\rightarrow 0^{+}}\coth x$$</item>
          <item>$$\lim\limits_{x\rightarrow 0^{-}}\coth x$$</item>
          <item>$$\lim\limits_{x\rightarrow - \infty}{csch}x$$</item>
          <item>$$\lim\limits_{x\rightarrow\infty}\frac{\sinh x}{e^{ x}}$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$1$$</paragraph>
        <paragraph>$$- 1$$</paragraph>
        <paragraph>$$\infty$$</paragraph>
        <paragraph>$$- \infty$$</paragraph>
        <paragraph>$$0$$</paragraph>
        <paragraph>$$1$$</paragraph>
        <paragraph>$$\infty$$</paragraph>
        <paragraph>$$- \infty$$</paragraph>
        <paragraph>$$0$$</paragraph>
        <paragraph>$$\frac{1}{2}$$</paragraph>
      </solution>
    </exercise>
