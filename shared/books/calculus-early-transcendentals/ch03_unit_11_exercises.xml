      <problem>
        <list type="ordered">
          <item>$$\cosh\left( {\ln 5} \right)$$</item>
          <item>$$\cosh 5$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>$$\frac{13}{5}$$</paragraph>
        <paragraph>$$\frac{1}{2}{({e^{5} + e^{- 5}})} \approx 74.20995$$</paragraph>
      </solution>
    </exercise>
