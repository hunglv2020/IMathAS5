    </exercise>
    <exercise number="36" has_solution="false">
      <problem>
        <paragraph>In the evening the temperature was 3 °C. By morning, the temperature had fallen 4 °C. What is the temperature now?</paragraph>
      </problem>
    </exercise>
    <exercise number="37" has_solution="false">
      <problem>
        <paragraph>An 8,000 BTU air conditioner can cool a room 1 °C every 5 minutes. If the temperature in the room is 24 °C, how long will it take the air conditioner to cool the room to 20 °C?</paragraph>
      </problem>
    </exercise>
