    <exercise number="28" has_solution="false">
      <problem>
        <paragraph>A cup of tea is 30 °C. After adding ice, the temperature of the tea decreased 3 °C. What is the temperature of the tea now?</paragraph>
      </problem>
    </exercise>
    <exercise number="29" has_solution="false">
      <problem>
        <paragraph>A liquid with a temperature of 15 °C is placed on a stovetop. The liquid is heated at the rate of 1.5 °C per minute. What is the temperature of the liquid after 10 minutes?</paragraph>
      </problem>
    </exercise>
    <exercise number="30" has_solution="false">
      <problem>
        <paragraph>The temperature inside a store is 22 °C. Outside the temperature is 37 °C. How much cooler is it in the store than outside?</paragraph>
      </problem>
    </exercise>
    <exercise number="31" has_solution="false">
      <problem>
        <paragraph>A boiling pan of water is 212 °F. As the water cools the temperature drops 6 °C every 2 minutes. How many minutes until the temperature of the water reaches 40 °C?</paragraph>
      </problem>
    </exercise>
    <exercise number="32" has_solution="false">
      <problem>
        <paragraph>On May 1 the temperature was 79 °F. On June 1 the temperature was 25 °C. Which day was warmer?</paragraph>
      </problem>
    </exercise>
    <exercise number="33" has_solution="false">
      <problem>
        <paragraph>For each log placed on a fire, the temperature increases 45 °C. How many logs are needed for the campfire to increase 315 °C?</paragraph>
      </problem>
    </exercise>
    <exercise number="34" has_solution="false">
      <problem>
        <paragraph>The temperature of a Bunsen burner flame increases 572 °F each minute. About how many minutes does it take for the flame to increase 1,200 °C?</paragraph>
      </problem>
    </exercise>
    <exercise number="35" has_solution="false">
      <problem>
        <paragraph>The instructions to cook a pizza say to set the oven at 425 °F. To the nearest degree, what is the temperature in degrees Celsius?</paragraph>
