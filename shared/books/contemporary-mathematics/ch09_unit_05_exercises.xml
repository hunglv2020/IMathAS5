<section>
  <exercises>
    <heading level="1">Section 9.5 Exercises</heading>
    <paragraph>For the following exercises, determine the most reasonable value for each temperature.</paragraph>
    <exercise number="1" has_solution="false">
      <problem>
        <paragraph>Human body: 37 °C or 37 °F</paragraph>
      </problem>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>An ice cube: 32 °C or 0 °C</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="false">
      <problem>
        <paragraph>Boiling water: 212 °C or 212 °F</paragraph>
      </problem>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>Summer day: 8 °C, 23 °C, or 75 °C</paragraph>
      </problem>
    </exercise>
