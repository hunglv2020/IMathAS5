        <paragraph>Winter day: 33 °C, 30 °C, or 3 °C</paragraph>
      </problem>
    </exercise>
    <exercise number="6" has_solution="false">
      <problem>
        <paragraph>Lava: 700 °C, 70 °C, or 7 °C</paragraph>
      </problem>
    </exercise>
