<section>
  <exercises>
    <heading level="1">Section 2.3 Exercises</heading>
    <paragraph>For the following exercises, find the truth value of each statement.</paragraph>
    <exercise number="1" has_solution="false">
      <problem>
        <paragraph>$$p$$ : $$7 \times 3 = 21$$ . What is the truth value of $$\text{\textasciitilde} p$$ ?</paragraph>
      </problem>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>$$q$$ : The sun revolves around the Earth. What is the truth value of $$\text{\textasciitilde} q$$ ?</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="false">
      <problem>
        <paragraph>$$\text{\textasciitilde} r$$ : The acceleration of gravity is $$9.81$$ m/sec2. What is the truth value of $$r$$ ?</paragraph>
      </problem>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>$$s$$ : Dan Brown is not the author of the book, The Davinci Code. What is the truth value of $$\text{\textasciitilde} {( \text{\textasciitilde} s)}$$ ?</paragraph>
      </problem>
    </exercise>
    <exercise number="5" has_solution="false">
      <problem>
        <paragraph>$$t$$ : Broccoli is a vegetable. What is the truth value of $$\text{\textasciitilde} {( \text{\textasciitilde} t)}$$ ?</paragraph>
      </problem>
    </exercise>
