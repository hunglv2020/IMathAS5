<?xml version="1.0" encoding="UTF-8"?>
<section>
  <exercises>
    <heading level="1">Section 5.1 Exercises</heading>
    <paragraph>For the following exercises, translate from algebra to words.</paragraph>
    <exercise number="1" has_solution="false">
      <problem>
        <paragraph>$$50 - 15$$</paragraph>
      </problem>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>(10)( $$x$$ )</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="false">
      <problem>
        <paragraph>$$2a - b$$</paragraph>
      </problem>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>$$100 \div 33$$</paragraph>
      </problem>
    </exercise>
    <exercise number="5" has_solution="false">
      <problem>
        <paragraph>$$3x + 5$$</paragraph>
      </problem>
    </exercise>
    <paragraph>For the following exercises, translate from words to algebra.</paragraph>
    <exercise number="6" has_solution="false">
      <problem>
        <paragraph>15 divided by 3.</paragraph>
      </problem>
    </exercise>
    <exercise number="7" has_solution="false">
      <problem>
        <paragraph>The sum of 13 and 13.</paragraph>
      </problem>
    </exercise>
    <exercise number="8" has_solution="false">
      <problem>
        <paragraph>120 minus 12.</paragraph>
      </problem>
    </exercise>
    <exercise number="9" has_solution="false">
      <problem>
        <paragraph>The product of 5 and 4.</paragraph>
      </problem>
    </exercise>
    <exercise number="10" has_solution="false">
      <problem>
        <paragraph>The sum of double $$x$$ and 5.</paragraph>
      </problem>
    </exercise>
    <paragraph>For the following exercises, translate from an English phrase to an expression.</paragraph>
    <exercise number="11" has_solution="false">
      <problem>
        <paragraph>Three times $$y$$ minus 7.</paragraph>
      </problem>
    </exercise>
    <exercise number="12" has_solution="false">
      <problem>
        <paragraph>$$a$$ divided by 2; then add 4.</paragraph>
      </problem>
    </exercise>
    <exercise number="13" has_solution="false">
      <problem>
        <paragraph>$$x$$ squared minus 3.</paragraph>
      </problem>
    </exercise>
    <exercise number="14" has_solution="false">
      <problem>
        <paragraph>A rental car company charges \$0.15 per mile $$m$$ , plus a \$40 flat fee for the rental.</paragraph>
      </problem>
    </exercise>
    <exercise number="15" has_solution="false">
      <problem>
        <paragraph>A parking garage in New York City charges \$20 for the first hour, then \$5 per hour $$h$$ .</paragraph>
      </problem>
    </exercise>
    <paragraph>For the following exercises, use parentheses to make the statements true.</paragraph>
    <exercise number="16" has_solution="false">
      <problem>
        <paragraph>$$16 \div 4 \cdot 2 + 5 = 13$$</paragraph>
      </problem>
    </exercise>
    <exercise number="17" has_solution="false">
      <problem>
        <paragraph>$$2^{2} - 5 + 3 \cdot 2 = 5$$</paragraph>
      </problem>
    </exercise>
    <exercise number="18" has_solution="false">
      <problem>
        <paragraph>$$x - 3 \cdot x - 2 = x^{2} - 5x + 6$$</paragraph>
      </problem>
    </exercise>
    <exercise number="19" has_solution="false">
      <problem>
        <paragraph>$$20x \div 5 - 1 - 5x = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="20" has_solution="false">
      <problem>
        <paragraph>$$5x + 3x \div 3 - 7x + 1 \cdot x = 0$$</paragraph>
      </problem>
    </exercise>
    <paragraph>For the following exercises, evaluate and simplify the expression.</paragraph>
    <exercise number="21" has_solution="false">
      <problem>
        <paragraph>$$x^{2}$$ when $$x = 9$$</paragraph>
      </problem>
    </exercise>
    <exercise number="22" has_solution="false">
      <problem>
        <paragraph>$$2x + 5$$ when $$x = 3$$</paragraph>
      </problem>
    </exercise>
    <exercise number="23" has_solution="false">
      <problem>
        <paragraph>$$\left( {3x + 1} \right)\left( {4x - 6} \right)$$ when $$x = 2$$</paragraph>
      </problem>
    </exercise>
    <exercise number="24" has_solution="false">
      <problem>
        <paragraph>$$x^{2} + 3x + 8$$ when $$x = 3$$</paragraph>
      </problem>
    </exercise>
    <exercise number="25" has_solution="false">
      <problem>
        <paragraph>$$\left( {x^{2} + 5x - 4} \right)(2x)$$ when $$x = 4$$</paragraph>
      </problem>
    </exercise>
    <exercise number="26" has_solution="false">
      <problem>
        <paragraph>$$4a + 5 - 2a - 8$$ when $$a = 6$$</paragraph>
      </problem>
    </exercise>
    <exercise number="27" has_solution="false">
      <problem>
        <paragraph>$$8a^{2} + 4a + 9 - a^{2} - 1$$ when $$a = 5$$</paragraph>
      </problem>
    </exercise>
    <exercise number="28" has_solution="false">
      <problem>
        <paragraph>Yasenia is 3 years older than Xavier. How old is Yasenia when Xavier is 18 years old?</paragraph>
      </problem>
    </exercise>
    <exercise number="29" has_solution="false">
      <problem>
        <paragraph>A rental car company charges \$0.15 per mile $$m$$ , plus a \$40 flat fee for the rental. What is the cost of the car rental if one drives 100 miles?</paragraph>
      </problem>
    </exercise>
    <exercise number="30" has_solution="false">
      <problem>
        <paragraph>A parking garage in New York City charges \$20 for the first hour, then \$5 per hour $$h$$ . What is the cost of parking for 10 hours?</paragraph>
      </problem>
    </exercise>
    <paragraph>For the following exercises, perform the indicated operation for the expressions.</paragraph>
    <exercise number="31" has_solution="false">
      <problem>
        <paragraph>Add $$\left( {4x - 9} \right) + \left( {x + 12} \right)$$ .</paragraph>
      </problem>
    </exercise>
    <exercise number="32" has_solution="false">
      <problem>
        <paragraph>Add $$\left( {3x^{2} + 2x + 1} \right) + \left( {x^{2} - 2x + 2} \right)$$ .</paragraph>
      </problem>
    </exercise>
    <exercise number="33" has_solution="false">
      <problem>
        <paragraph>Subtract $$\left( {4x - 9} \right) - \left( {- x + 2} \right)$$ .</paragraph>
      </problem>
    </exercise>
    <exercise number="34" has_solution="false">
      <problem>
        <paragraph>Subtract $$\left( {3x^{2} + 5x} \right) - \left( {x^{2} - 3x + 11} \right)$$ .</paragraph>
      </problem>
    </exercise>
    <exercise number="35" has_solution="false">
      <problem>
        <paragraph>Multiply $$4\left( {x + 2} \right)$$ .</paragraph>
      </problem>
    </exercise>
    <exercise number="36" has_solution="false">
      <problem>
        <paragraph>Multiply $$2\left( {3x^{2} - 2x + 1} \right)$$ .</paragraph>
      </problem>
    </exercise>
    <exercise number="37" has_solution="false">
      <problem>
        <paragraph>Multiply $$\left( {3x} \right)\left( {x - 1} \right)$$ .</paragraph>
      </problem>
    </exercise>
    <exercise number="38" has_solution="false">
      <problem>
        <paragraph>Multiply $$\left( {2x - 1} \right)\left( {x + 3} \right)$$ .</paragraph>
      </problem>
    </exercise>
    <exercise number="39" has_solution="false">
      <problem>
        <paragraph>$$\left( {125x^{2} + 35x - 5} \right) \div (5)$$ .</paragraph>
      </problem>
    </exercise>
    <exercise number="40" has_solution="false">
      <problem>
        <paragraph>$$\left( {9x^{2} + 18x - 27} \right) \div \left( {3x} \right)$$ .</paragraph>
      </problem>
    </exercise>
  </exercises>
</section>
