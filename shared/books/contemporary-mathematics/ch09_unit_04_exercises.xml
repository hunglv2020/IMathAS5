<section>
  <exercises>
    <heading level="1">Section 9.4 Exercises</heading>
    <paragraph>For the following exercises, determine the most reasonable value for each weight.</paragraph>
    <exercise number="1" has_solution="false">
      <problem>
        <paragraph>Aspirin tablet: 300 kg, 300 g, or 300 mg</paragraph>
      </problem>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>Elephant: 5,000 kg, 5,000 g, or 5,000 mg</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="false">
      <problem>
        <paragraph>Baseball: 145 kg, 145 g, or 145 mg</paragraph>
      </problem>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>Orange: 115 kg, 115 g, or 115 mg</paragraph>
      </problem>
    </exercise>
    <exercise number="5" has_solution="false">
      <problem>
        <paragraph>Pencil: 6 kg, 6 g, or 6 mg</paragraph>
      </problem>
    </exercise>
    <exercise number="6" has_solution="false">
      <problem>
        <paragraph>Automobile: 1,300 kg, 1,300 g, or 1,300 mg</paragraph>
      </problem>
    </exercise>
    <paragraph>For the following exercises, convert the given weight to the units shown.</paragraph>
