    <paragraph>For the following exercises, determine the total weight in the units shown.</paragraph>
    <exercise number="19" has_solution="false">
      <problem>
        <paragraph>Three 350 mg tablets ________ g</paragraph>
      </problem>
    </exercise>
    <exercise number="20" has_solution="false">
      <problem>
        <paragraph>Seven 115 g soap bars ________ kg</paragraph>
      </problem>
    </exercise>
    <exercise number="21" has_solution="false">
      <problem>
        <paragraph>Six 24 g batteries ________ mg</paragraph>
      </problem>
    </exercise>
    <exercise number="22" has_solution="false">
      <problem>
        <paragraph>Fifty 3.56 g pennies ________ mg</paragraph>
      </problem>
    </exercise>
    <exercise number="23" has_solution="false">
      <problem>
        <paragraph>Eight 2.25 kg bags of potatoes ________ g</paragraph>
      </problem>
    </exercise>
    <exercise number="24" has_solution="false">
      <problem>
        <paragraph>Four 23 kg sacks of flour ________ g</paragraph>
      </problem>
    </exercise>
    <exercise number="25" has_solution="false">
      <problem>
        <paragraph>Ten 2.5 kg laptops ________ g</paragraph>
      </problem>
    </exercise>
    <exercise number="26" has_solution="false">
      <problem>
        <paragraph>Seven 1,150 g chickens ________ kg</paragraph>
      </problem>
    </exercise>
    <exercise number="27" has_solution="false">
      <problem>
        <paragraph>Ninety 4,500 mg marbles ________ kg</paragraph>
      </problem>
    </exercise>
    <exercise number="28" has_solution="false">
      <problem>
        <paragraph>There are 26 bags of flour. Each bag weighs 5 kg. What is the total weight of the flour?</paragraph>
      </problem>
    </exercise>
    <exercise number="29" has_solution="false">
      <problem>
        <paragraph>The average female hippopotamus weighs 1,496 kg. The average male hippopotamus weighs 1,814 kg. How much heavier, in grams, is the male hippopotamus than the female hippopotamus?</paragraph>
      </problem>
    </exercise>
    <exercise number="30" has_solution="false">
      <problem>
        <paragraph>Twelve pieces of cardboard weigh 72 grams. What is the weight of one piece of cardboard?</paragraph>
      </problem>
    </exercise>
    <exercise number="31" has_solution="false">
      <problem>
        <paragraph>Miguel’s backpack weighs 2.4 kg and Shanayl’s backpack weighs 2,535 grams. Whose backpack is heavier and by how much?</paragraph>
      </problem>
    </exercise>
    <exercise number="32" has_solution="false">
      <problem>
        <paragraph>A souvenir chocolate bar weighs 1.815 kg. If you share the candy bar equally with two friends, how many grams of chocolate does each person get?</paragraph>
      </problem>
    </exercise>
    <exercise number="33" has_solution="false">
      <problem>
        <paragraph>You purchase 10 bananas that weigh 50 grams each. If bananas cost \$5.50 per kilogram, how much did you pay?</paragraph>
      </problem>
    </exercise>
    <exercise number="34" has_solution="false">
      <problem>
        <paragraph>A family-size package of ground meat costs \$15.75. The package weighs 4.5 kg. What is the cost per gram of the meat?</paragraph>
      </problem>
    </exercise>
    <exercise number="35" has_solution="false">
      <problem>
        <paragraph>A box containing 6 identical books weighs 7.2 kg. The box weighs 600 g. What is the weight of each book in grams?</paragraph>
      </problem>
    </exercise>
    <exercise number="36" has_solution="false">
      <problem>
        <paragraph>A 2.316 kg bag of candy is equally divided into 12 party bags. What is the weight of the candy, in grams, in each party bag?</paragraph>
      </problem>
    </exercise>
    <exercise number="37" has_solution="false">
      <problem>
        <paragraph>A store has 450 kg of flour at the beginning of the day. At the end of the day the store has 341 kg of flour. If flour costs \$0.35 per kilogram, how much flour, in dollars, did the store sell that day?</paragraph>
      </problem>
    </exercise>
    <exercise number="38" has_solution="false">
      <problem>
        <paragraph>A local restaurant offers lobster for \$110 per kilogram. What is the price for a lobster that weighs 450 grams?</paragraph>
      </problem>
    </exercise>
    <exercise number="39" has_solution="false">
      <problem>
        <paragraph>A student’s backpack weighs 575 grams. Their books weigh 3.5 kg. If the student’s weight while wearing their backpack is 58.25 kg, how much does the student weigh in kilograms?</paragraph>
      </problem>
    </exercise>
    <exercise number="40" has_solution="false">
      <problem>
        <paragraph>The weight of a lamb is 41 kg 340 g. What is the total weight, in kilograms, of four lambs of the same weight?</paragraph>
      </problem>
    </exercise>
