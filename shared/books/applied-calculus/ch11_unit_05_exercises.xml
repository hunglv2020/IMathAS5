        <paragraph>$$f(x) = e^{2x}$$ ; $$x = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 0}^{\infty}{\frac{2^{n}}{n!}x^{n}}$$ ; $$R = \infty$$ ; $$( - \infty,\infty)$$</paragraph>
      </solution>
    </exercise>
    <exercise number="10" has_solution="false">
      <problem>
        <paragraph>$$f(x) = e^{2x}$$ ; $$x = 1$$</paragraph>
      </problem>
    </exercise>
    <exercise number="11" has_solution="true">
      <problem>
        <paragraph>$$f(x) = \frac{1}{\sqrt{x + 1}}$$ ; $$x = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\sum\limits_{n = 0}^{\infty}{( - 1)^{n}\frac{1 \cdot 3 \cdot 5\cdots(2n - 1)}{n!2^{n}}x^{n}}$$ ; $$R = 1$$ ; $$( - 1,1)$$</paragraph>
      </solution>
    </exercise>
    <exercise number="12" has_solution="false">
