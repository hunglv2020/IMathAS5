        <paragraph>$$\sum\limits_{n = 0}^{\infty}(x - 1)^{n}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$R = 1$$ ; $$(0,2)$$</paragraph>
      </solution>
    </exercise>
