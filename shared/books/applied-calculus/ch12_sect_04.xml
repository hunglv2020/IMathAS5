            </paragraph>
          </item>
          <item>
            <paragraph>
              <math display="inline">$$\int{\csc^{2}xdx = - \cot x + C}$$</math>
            </paragraph>
          </item>
          <item>
            <paragraph>
              <math display="inline">$$\int{\sec x\tan xdx = \sec x + C}$$</math>
            </paragraph>
          </item>
          <item>
            <paragraph>
              <math display="inline">$$\int{\csc x\cot xdx = - \csc x + C}$$</math>
            </paragraph>
          </item>
        </list>
      </note>
