<?xml version="1.0" encoding="UTF-8"?>
<section>
  <exercises>
    <heading level="1">Section 2.7 Exercises</heading>
    <paragraph>For the following exercises, find the derivative $$\frac{dy}{dx}.$$</paragraph>
    <exercise number="295" has_solution="true">
      <problem>
        <paragraph>$$y = \ln \left( {2x} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 x 1 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="296" has_solution="false">
      <problem>
        <paragraph>$$y = \ln \left( {2x + 1} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="297" has_solution="true">
      <problem>
        <paragraph>$$y = \frac{1}{\ln x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$- 1 x ( ln x ) 2 - 1 x ( ln x ) 2$$</paragraph>
      </solution>
    </exercise>
    <paragraph>For the following exercises, find the indefinite integral.</paragraph>
    <exercise number="298" has_solution="false">
      <problem>
        <paragraph>$$\int\frac{dt}{3t}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="299" has_solution="true">
      <problem>
        <paragraph>$$\int\frac{dx}{1 + x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$ln ( x + 1 ) + C ln ( x + 1 ) + C$$</paragraph>
      </solution>
    </exercise>
    <paragraph>For the following exercises, find the derivative $$dy/dx.$$ (You can use a calculator to plot the function and the derivative to confirm that it is correct.)</paragraph>
    <exercise number="300" has_solution="false">
      <problem>
        <paragraph>[T] $$y = \frac{\ln (x)}{x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="301" has_solution="true">
      <problem>
        <paragraph>[T] $$y = x \ln (x)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$ln ( x ) + 1 ln ( x ) + 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="302" has_solution="false">
      <problem>
        <paragraph>[T] $$y = \log_{10}x$$</paragraph>
      </problem>
    </exercise>
    <exercise number="303" has_solution="true">
      <problem>
        <paragraph>[T] $$y = \ln \left( {\sin x} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$cot ( x ) cot ( x )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="304" has_solution="false">
      <problem>
        <paragraph>[T] $$y = \ln \left( {\ln x} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="305" has_solution="true">
      <problem>
        <paragraph>[T] $$y = 7 \ln \left( {4x} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$7 x 7 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="306" has_solution="false">
      <problem>
        <paragraph>[T] $$y = \ln \left( \left( {4x} \right)^{7} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="307" has_solution="true">
      <problem>
        <paragraph>[T] $$y = \ln \left( {\tan x} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$csc ( x ) sec x csc ( x ) sec x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="308" has_solution="false">
      <problem>
        <paragraph>[T] $$y = \ln \left( {\tan \left( {3x} \right)} \right)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="309" has_solution="true">
      <problem>
        <paragraph>[T] $$y = \ln \left( {\cos^{2}x} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$-2 tan x -2 tan x$$</paragraph>
      </solution>
    </exercise>
    <paragraph>For the following exercises, find the definite or indefinite integral.</paragraph>
    <exercise number="310" has_solution="false">
      <problem>
        <paragraph>$$\int_{0}^{1}\frac{dx}{3 + x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="311" has_solution="true">
      <problem>
        <paragraph>$$\int_{0}^{1}\frac{dt}{3 + 2t}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 2 ln ( 5 3 ) 1 2 ln ( 5 3 )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="312" has_solution="false">
      <problem>
        <paragraph>$$\int_{0}^{2}\frac{x dx}{x^{2} + 1}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="313" has_solution="true">
      <problem>
        <paragraph>$$\int_{0}^{2}\frac{x^{3}dx}{x^{2} + 1}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2 - 1 2 ln ( 5 ) 2 - 1 2 ln ( 5 )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="314" has_solution="false">
      <problem>
        <paragraph>$$\int_{2}^{e}\frac{dx}{x \ln x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="315" has_solution="true">
      <problem>
        <paragraph>$$\int_{2}^{e}\frac{dx}{{x (\ln { x)}}^{2}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 ln ( 2 ) - 1 1 ln ( 2 ) - 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="316" has_solution="false">
      <problem>
        <paragraph>$$\int\frac{\cos x dx}{\sin x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="317" has_solution="true">
      <problem>
        <paragraph>$$\int_{0}^{\pi/4}{\tan x dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 2 ln ( 2 ) 1 2 ln ( 2 )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="318" has_solution="false">
      <problem>
        <paragraph>$$\int{\cot \left( {3x} \right)dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="319" has_solution="true">
      <problem>
        <paragraph>$$\int\frac{\left( {\ln x} \right)^{2}dx}{x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 3 ( ln x ) 3 1 3 ( ln x ) 3$$</paragraph>
      </solution>
    </exercise>
    <paragraph>For the following exercises, compute $$dy/dx$$ by differentiating $$\ln y.$$</paragraph>
    <exercise number="320" has_solution="false">
      <problem>
        <paragraph>$$y = \sqrt{x^{2} + 1}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="321" has_solution="true">
      <problem>
        <paragraph>$$y = \sqrt{x^{2} + 1}\sqrt{x^{2} - 1}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2 x 3 x 2 + 1 x 2 - 1 2 x 3 x 2 + 1 x 2 - 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="322" has_solution="false">
      <problem>
        <paragraph>$$y = e^{\sin x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="323" has_solution="true">
      <problem>
        <paragraph>$$y = x^{-1/x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x -2 - ( 1 / x ) ( ln x - 1 ) x -2 - ( 1 / x ) ( ln x - 1 )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="324" has_solution="false">
      <problem>
        <paragraph>$$y = e^{({ex})}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="325" has_solution="true">
      <problem>
        <paragraph>$$y = x^{e}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$e x e - 1 e x e - 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="326" has_solution="false">
      <problem>
        <paragraph>$$y = x^{({ex})}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="327" has_solution="true">
      <problem>
        <paragraph>$$y = \sqrt{x} \sqrt[3]{x} \sqrt[6]{x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="328" has_solution="false">
      <problem>
        <paragraph>$$y = x^{-1/\ln x}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="329" has_solution="true">
      <problem>
        <paragraph>$$y = e^{-\ln x}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$- 1 x 2 - 1 x 2$$</paragraph>
      </solution>
    </exercise>
    <paragraph>For the following exercises, evaluate by any method.</paragraph>
    <exercise number="330" has_solution="false">
      <problem>
        <paragraph>$$\int_{5}^{10}{\frac{dt}{t} - {\int_{5x}^{10x}\frac{dt}{t}}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="331" has_solution="true">
      <problem>
        <paragraph>$${\int_{1}^{e^{\pi}}\frac{dx}{x}} + {\int_{-2}^{-1}\frac{dx}{x}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\pi - ln ( 2 ) \pi - ln ( 2 )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="332" has_solution="false">
      <problem>
        <paragraph>$$\frac{d}{dx}{\int_{x}^{1}\frac{dt}{t}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="333" has_solution="true">
      <problem>
        <paragraph>$$\frac{d}{dx}{\int_{x}^{x^{2}}\frac{dt}{t}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 x 1 x$$</paragraph>
      </solution>
    </exercise>
    <exercise number="334" has_solution="false">
      <problem>
        <paragraph>$$\frac{d}{dx}\ln \left( {\sec x + \tan x} \right)$$</paragraph>
      </problem>
    </exercise>
    <paragraph>For the following exercises, use the function $$\ln x.$$ If you are unable to find intersection points analytically, use a calculator.</paragraph>
    <exercise number="335" has_solution="true">
      <problem>
        <paragraph>Find the area of the region enclosed by $$x = 1$$ and $$y = 5$$ above $$y = \ln x.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$e 5 - 6 units 2 e 5 - 6 units 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="336" has_solution="false">
      <problem>
        <paragraph>[T] Find the arc length of $$\ln x$$ from $$x = 1$$ to $$x = 2.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="337" has_solution="true">
      <problem>
        <paragraph>Find the area between $$\ln x$$ and the x-axis from $$x = 1 \text{to} x = 2.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$ln ( 4 ) - 1 units 2 ln ( 4 ) - 1 units 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="338" has_solution="false">
      <problem>
        <paragraph>Find the volume of the shape created when rotating this curve from $$x = 1 \text{to} x = 2$$ around the x-axis, as pictured here.</paragraph>
      </problem>
    </exercise>
    <exercise number="339" has_solution="true">
      <problem>
        <paragraph>[T] Find the surface area of the shape created when rotating the curve in the previous exercise from $$x = 1$$ to $$x = 2$$ around the x-axis.</paragraph>
      </problem>
      <solution>
        <paragraph>$$2.8656 2.8656$$</paragraph>
      </solution>
    </exercise>
    <paragraph>If you are unable to find intersection points analytically in the following exercises, use a calculator.</paragraph>
    <exercise number="340" has_solution="false">
      <problem>
        <paragraph>Find the area of the hyperbolic quarter-circle enclosed by $$x = 2 \text{and} y = 2$$ above $$y = 1/x.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="341" has_solution="true">
      <problem>
        <paragraph>[T] Find the arc length of $$y = 1/x$$ from $$x = 1 \text{to} x = 4.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$3.1502 3.1502$$</paragraph>
      </solution>
    </exercise>
    <exercise number="342" has_solution="false">
      <problem>
        <paragraph>Find the area under $$y = 1/x$$ and above the x-axis from $$x = 1 \text{to} x = 4.$$</paragraph>
      </problem>
    </exercise>
    <paragraph>For the following exercises, verify the derivatives and antiderivatives.</paragraph>
    <exercise number="343" has_solution="false">
      <problem>
        <paragraph>$$\frac{d}{dx}\ln \left( {x + \sqrt{x^{2} + 1}} \right) = \frac{1}{\sqrt{1 + x^{2}}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="344" has_solution="false">
      <problem>
        <paragraph>$$\frac{d}{dx}\ln \left( \frac{x - a}{x + a} \right) = \frac{2a}{\left( {x^{2} - a^{2}} \right)}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="345" has_solution="false">
      <problem>
        <paragraph>$$\frac{d}{dx}\ln \left( \frac{1 + \sqrt{1 - x^{2}}}{x} \right) = - \frac{1}{x\sqrt{1 - x^{2}}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="346" has_solution="false">
      <problem>
        <paragraph>$$\frac{d}{dx}\ln \left( {x + \sqrt{x^{2} - a^{2}}} \right) = \frac{1}{\sqrt{x^{2} - a^{2}}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="347" has_solution="false">
      <problem>
        <paragraph>$${\int\frac{dx}{x \ln (x)\ln \left( {\ln x} \right)}} = \ln \left( {\ln \left( {\ln x} \right)} \right) + C$$</paragraph>
      </problem>
    </exercise>
  </exercises>
</section>
