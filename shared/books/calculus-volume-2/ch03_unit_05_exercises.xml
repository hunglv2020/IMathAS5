<?xml version="1.0" encoding="UTF-8"?>
<section>
  <exercises>
    <heading level="1">Section 3.5 Exercises</heading>
    <paragraph>Use a table of integrals to evaluate the following integrals.</paragraph>
    <exercise number="244" has_solution="false">
      <problem>
        <paragraph>$$\int\limits_{0}^{4}{\frac{x}{\sqrt{1 + 2x}}dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="245" has_solution="true">
      <problem>
        <paragraph>$$\int{\frac{x + 3}{x^{2} + 2x + 2}dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 2 ln | x 2 + 2 x + 2 | + 2 arctan ( x + 1 ) + C 1 2 ln | x 2 + 2 x + 2 | + 2 arctan ( x + 1 ) + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="246" has_solution="false">
      <problem>
        <paragraph>$$\int{x^{3}\sqrt{1 + 2x^{2}} dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="247" has_solution="true">
      <problem>
        <paragraph>$$\int{\frac{1}{\sqrt{x^{2} + 6x}}dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$cosh -1 ( x + 3 3 ) + C cosh -1 ( x + 3 3 ) + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="248" has_solution="false">
      <problem>
        <paragraph>$$\int{\frac{x}{x + 1}dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="249" has_solution="true">
      <problem>
        <paragraph>$$\int{x \cdot 2^{x^{2}}dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2 x 2 - 1 ln 2 + C 2 x 2 - 1 ln 2 + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="250" has_solution="false">
      <problem>
        <paragraph>$$\int{\frac{1}{4x^{2} + 25}dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="251" has_solution="true">
      <problem>
        <paragraph>$$\int\frac{dy}{\sqrt{4 - y^{2}}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$arcsin ( y 2 ) + C arcsin ( y 2 ) + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="252" has_solution="false">
      <problem>
        <paragraph>$$\int{\sin^{3}(2x)\cos (2x)dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="253" has_solution="true">
      <problem>
        <paragraph>$$\int{\csc (2w)\cot (2w)dw}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$- 1 2 csc ( 2 w ) + C - 1 2 csc ( 2 w ) + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="254" has_solution="false">
      <problem>
        <paragraph>$$\int{2^{y}dy}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="255" has_solution="true">
      <problem>
        <paragraph>$$\int_{0}^{1}\frac{3x dx}{\sqrt{x^{2} + 8}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$9 - 6 2 9 - 6 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="256" has_solution="false">
      <problem>
        <paragraph>$$\int_{-1/4}^{1/4}{\sec^{2}(\pi x)\tan \left( {\pi x} \right)dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="257" has_solution="true">
      <problem>
        <paragraph>$$\int_{0}^{\pi/2}{\tan^{2}\left( \frac{x}{2} \right)dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2 - \pi 2 2 - \pi 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="258" has_solution="false">
      <problem>
        <paragraph>$$\int{\cos^{3}x dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="259" has_solution="true">
      <problem>
        <paragraph>$$\int{\tan^{5}\left( {3x} \right)dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 12 tan 4 ( 3 x ) - 1 6 tan 2 ( 3 x ) + 1 3 ln | sec ( 3 x ) | + C 1 12 tan 4 ( 3 x ) - 1 6 tan 2 ( 3 x ) + 1 3 ln | sec ( 3 x ) | + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="260" has_solution="false">
      <problem>
        <paragraph>$$\int{\sin^{2}y\cos^{3}ydy}$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Use a CAS to evaluate the following integrals. Tables can also be used to verify the answers.</paragraph>
    <exercise number="261" has_solution="true">
      <problem>
        <paragraph>[T] $$\int\frac{dw}{1 + \sec \left( \frac{w}{2} \right)}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2 cot ( w 2 ) - 2 csc ( w 2 ) + w + C 2 cot ( w 2 ) - 2 csc ( w 2 ) + w + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="262" has_solution="false">
      <problem>
        <paragraph>[T] $$\int\frac{dw}{1 - \cos \left( {7w} \right)}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="263" has_solution="true">
      <problem>
        <paragraph>[T] $$\int_{0}^{t}\frac{dt}{4\cos t + 3\sin t}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 5 ln | 2 ( 5 + 4 sin t - 3 cos t ) 4 cos t + 3 sin t | 1 5 ln | 2 ( 5 + 4 sin t - 3 cos t ) 4 cos t + 3 sin t |$$</paragraph>
      </solution>
    </exercise>
    <exercise number="264" has_solution="false">
      <problem>
        <paragraph>[T] $$\int{\frac{\sqrt{x^{2} - 9}}{3x}dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="265" has_solution="true">
      <problem>
        <paragraph>[T] $$\int\frac{dx}{x^{1/2} + x^{1/3}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$6 x 1 / 6 - 3 x 1 / 3 + 2 x - 6 ln [ 1 + x 1 / 6 ] + C 6 x 1 / 6 - 3 x 1 / 3 + 2 x - 6 ln [ 1 + x 1 / 6 ] + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="266" has_solution="false">
      <problem>
        <paragraph>[T] $$\int\frac{dx}{x\sqrt{x - 1}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="267" has_solution="true">
      <problem>
        <paragraph>[T] $$\int{x^{3}\sin x dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$- x 3 cos x + 3 x 2 sin x + 6 x cos x - 6 sin x + C - x 3 cos x + 3 x 2 sin x + 6 x cos x - 6 sin x + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="268" has_solution="false">
      <problem>
        <paragraph>[T] $$\int{x\sqrt{x^{4} - 9} dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="269" has_solution="true">
      <problem>
        <paragraph>[T] $$\int{\frac{x}{1 + e^{-x^{2}}}dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 2 ( x 2 + ln | 1 + e - x 2 | ) + C 1 2 ( x 2 + ln | 1 + e - x 2 | ) + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="270" has_solution="false">
      <problem>
        <paragraph>[T] $$\int{\frac{\sqrt{3 - 5x}}{2x}dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="271" has_solution="true">
      <problem>
        <paragraph>[T] $$\int\frac{dx}{x\sqrt{x - 1}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$2 arctan ( x - 1 ) + C 2 arctan ( x - 1 ) + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="272" has_solution="false">
      <problem>
        <paragraph>[T] $$\int{e^{x}\cos^{-1}(e^{x})dx}$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Use a calculator or CAS to evaluate the following integrals.</paragraph>
    <exercise number="273" has_solution="true">
      <problem>
        <paragraph>[T] $$\int_{0}^{\pi/4}{\cos (2x)dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$0.5 = 1 2 0.5 = 1 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="274" has_solution="false">
      <problem>
        <paragraph>[T] $$\int_{0}^{1}{x \cdot e^{-x^{2}}dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="275" has_solution="true">
      <problem>
        <paragraph>[T] $$\int_{0}^{8}{\frac{2x}{\sqrt{x^{2} + 36}}dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>8.0</paragraph>
      </solution>
    </exercise>
    <exercise number="276" has_solution="false">
      <problem>
        <paragraph>[T] $$\int_{0}^{2/\sqrt{3}}{\frac{1}{4 + 9x^{2}}dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="277" has_solution="true">
      <problem>
        <paragraph>[T] $$\int\frac{dx}{x^{2} + 4x + 13}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 3 arctan ( 1 3 ( x + 2 ) ) + C 1 3 arctan ( 1 3 ( x + 2 ) ) + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="278" has_solution="false">
      <problem>
        <paragraph>[T] $$\int\frac{dx}{1 + \sin x}$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Use tables to evaluate the integrals. You may need to complete the square or change variables to put the integral into a form given in the table.</paragraph>
    <exercise number="279" has_solution="true">
      <problem>
        <paragraph>$$\int\frac{dx}{x^{2} + 2x + 10}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 3 arctan ( x + 1 3 ) + C 1 3 arctan ( x + 1 3 ) + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="280" has_solution="false">
      <problem>
        <paragraph>$$\int\frac{dx}{\sqrt{x^{2} - 6x}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="281" has_solution="true">
      <problem>
        <paragraph>$$\int{\frac{e^{x}}{\sqrt{e^{2x} - 4}}dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$ln ( e x + -4 + e 2 x ) + C ln ( e x + -4 + e 2 x ) + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="282" has_solution="false">
      <problem>
        <paragraph>$$\int{\frac{\cos x}{\sin^{2}x + 2\sin x}dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="283" has_solution="true">
      <problem>
        <paragraph>$$\int{\frac{\arctan \left( x^{3} \right)}{x^{4}}dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$ln x - 1 6 ln ( x 6 + 1 ) - arctan ( x 3 ) 3 x 3 + C ln x - 1 6 ln ( x 6 + 1 ) - arctan ( x 3 ) 3 x 3 + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="284" has_solution="false">
      <problem>
        <paragraph>$$\int{\frac{\ln |x|\arcsin \left( {\ln |x|} \right)}{x}dx}$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Use tables to perform the integration.</paragraph>
    <exercise number="285" has_solution="true">
      <problem>
        <paragraph>$$\int\frac{dx}{\sqrt{x^{2} + 16}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$ln | x + 16 + x 2 | + C ln | x + 16 + x 2 | + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="286" has_solution="false">
      <problem>
        <paragraph>$$\int{\frac{3x}{2x + 7}dx}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="287" has_solution="true">
      <problem>
        <paragraph>$$\int\frac{dx}{1 - \cos \left( {4x} \right)}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$- 1 4 cot ( 2 x ) + C - 1 4 cot ( 2 x ) + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="288" has_solution="false">
      <problem>
        <paragraph>$$\int\frac{dx}{\sqrt{4x + 1}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="289" has_solution="true">
      <problem>
        <paragraph>Find the area bounded by $$y = \frac{5}{4 + 25x^{2}},x = 0,y = 0, \text{and} x = 4.$$ Use a table of integrals or a CAS.</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 2 arctan 10 1 2 arctan 10$$</paragraph>
      </solution>
    </exercise>
    <exercise number="290" has_solution="false">
      <problem>
        <paragraph>The region bounded between the curve $$y = \frac{1}{\sqrt{1 + \cos x}},0.3 \leq x \leq 1.1,$$ and the x-axis is revolved about the x-axis to generate a solid. Use a table of integrals to find the volume of the solid generated. (Round the answer to two decimal places.)</paragraph>
      </problem>
    </exercise>
    <exercise number="291" has_solution="true">
      <problem>
        <paragraph>Use substitution and a table of integrals to find the area of the surface generated by revolving the curve $$y = e^{x},0 \leq x \leq 3,$$ about the x-axis. (Round the answer to two decimal places.)</paragraph>
      </problem>
      <solution>
        <paragraph>1276.14</paragraph>
      </solution>
    </exercise>
    <exercise number="292" has_solution="false">
      <problem>
        <paragraph>[T] Use an integral table and a calculator to find the area of the surface generated by revolving the curve $$y = \frac{x^{2}}{2},0 \leq x \leq 1,$$ about the x-axis. (Round the answer to two decimal places.)</paragraph>
      </problem>
    </exercise>
    <exercise number="293" has_solution="true">
      <problem>
        <paragraph>[T] Use a CAS or tables to find the area of the surface generated by revolving the curve $$y = \cos x,0 \leq x \leq \frac{\pi}{2},$$ about the x-axis. (Round the answer to two decimal places.)</paragraph>
      </problem>
      <solution>
        <paragraph>7.21</paragraph>
      </solution>
    </exercise>
    <exercise number="294" has_solution="false">
      <problem>
        <paragraph>Find the length of the curve $$y = \frac{x^{2}}{4}$$ over $$\left\lbrack {0,8} \right\rbrack.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="295" has_solution="true">
      <problem>
        <paragraph>Find the length of the curve $$y = e^{x}$$ over $$\left\lbrack {0,\ln (2)} \right\rbrack.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$5 - 2 + ln | 2 + 2 2 1 + 5 | 5 - 2 + ln | 2 + 2 2 1 + 5 |$$</paragraph>
      </solution>
    </exercise>
    <exercise number="296" has_solution="false">
      <problem>
        <paragraph>Find the area of the surface formed by revolving the graph of $$y = 2\sqrt{x}$$ over the interval $$\left\lbrack {0,9} \right\rbrack$$ about the x-axis.</paragraph>
      </problem>
    </exercise>
    <exercise number="297" has_solution="true">
      <problem>
        <paragraph>Find the average value of the function $$f(x) = \frac{1}{x^{2} + 1}$$ over the interval $$\left\lbrack {-3,3} \right\rbrack.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 3 arctan ( 3 ) \approx 0.416 1 3 arctan ( 3 ) \approx 0.416$$</paragraph>
      </solution>
    </exercise>
    <exercise number="298" has_solution="false">
      <problem>
        <paragraph>Approximate the arc length of the curve $$y = \tan \left( {\pi x} \right)$$ over the interval $$\left\lbrack {0,\frac{1}{4}} \right\rbrack.$$ (Round the answer to three decimal places.)</paragraph>
      </problem>
    </exercise>
  </exercises>
</section>
