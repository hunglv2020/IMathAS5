<?xml version='1.0' encoding='utf-8'?>
<review_exercises chapter="5">
  <exercise number="379" has_solution="true">
    <problem>
      <p>If $$\underset{n\rightarrow\infty}{\text{lim}}a_{n} = 0,$$ then $$\sum\limits_{n = 1}^{\infty}a_{n}$$ converges.</p>
    </problem>
    <solution>
      <p>false</p>
    </solution>
  </exercise>
  <exercise number="380" has_solution="false">
    <problem>
      <p>If $$\underset{n\rightarrow\infty}{\text{lim}}a_{n} \neq 0,$$ then $$\sum\limits_{n = 1}^{\infty}a_{n}$$ diverges.</p>
    </problem>
  </exercise>
  <exercise number="381" has_solution="true">
    <problem>
      <p>If $$\sum\limits_{n = 1}^{\infty}\left| a_{n} \right|$$ converges, then $$\sum\limits_{n = 1}^{\infty}a_{n}$$ converges.</p>
    </problem>
    <solution>
      <p>true</p>
    </solution>
  </exercise>
  <exercise number="382" has_solution="false">
    <problem>
      <p>If $$\sum\limits_{n = 1}^{\infty}{2^{n}a_{n}}$$ converges, then $$\sum\limits_{n = 1}^{\infty}{(-2)^{n}a_{n}}$$ converges.</p>
    </problem>
  </exercise>
  <exercise number="383" has_solution="true">
    <problem>
      <p>$$a_{n} = \frac{3 + n^{2}}{1 - n}$$</p>
    </problem>
    <solution>
      <p>unbounded, not monotone, divergent</p>
    </solution>
  </exercise>
  <exercise number="384" has_solution="false">
    <problem>
      <p>$$a_{n} = \text{ln}\left( \frac{1}{n} \right)$$</p>
    </problem>
  </exercise>
  <exercise number="385" has_solution="true">
    <problem>
      <p>$$a_{n} = \frac{\text{ln}\left( {n + 1} \right)}{\sqrt{n + 1}}$$</p>
    </problem>
    <solution>
      <p>bounded, monotone, convergent, $$0$$</p>
    </solution>
  </exercise>
  <exercise number="386" has_solution="false">
    <problem>
      <p>$$a_{n} = \frac{2^{n + 1}}{5^{n}}$$</p>
    </problem>
  </exercise>
  <exercise number="387" has_solution="true">
    <problem>
      <p>$$a_{n} = \frac{\text{ln}\left( {\text{cos}\mspace{2mu} n} \right)}{n}$$</p>
    </problem>
    <solution>
      <p>unbounded, not monotone, divergent</p>
    </solution>
  </exercise>
  <exercise number="388" has_solution="false">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}\frac{1}{n^{2} + 5n + 4}$$</p>
    </problem>
  </exercise>
  <exercise number="389" has_solution="true">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}{\text{ln}\left( \frac{n + 1}{n} \right)}$$</p>
    </problem>
    <solution>
      <p>diverges</p>
    </solution>
  </exercise>
  <exercise number="390" has_solution="false">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}\frac{2^{n}}{n^{4}}$$</p>
    </problem>
  </exercise>
  <exercise number="391" has_solution="true">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}\frac{e^{n}}{n\text{!}}$$</p>
    </problem>
    <solution>
      <p>converges</p>
    </solution>
  </exercise>
  <exercise number="392" has_solution="false">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}n^{\text{−}{({n + 1\text{/}n})}}$$</p>
    </problem>
  </exercise>
  <exercise number="393" has_solution="true">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}\frac{(-1)^{n}}{\sqrt{n}}$$</p>
    </problem>
    <solution>
      <p>converges, but not absolutely</p>
    </solution>
  </exercise>
  <exercise number="394" has_solution="false">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}\frac{(-1)^{n}n\text{!}}{3^{n}}$$</p>
    </problem>
  </exercise>
  <exercise number="395" has_solution="true">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}\frac{(-1)^{n}n\text{!}}{n^{n}}$$</p>
    </problem>
    <solution>
      <p>converges absolutely</p>
    </solution>
  </exercise>
  <exercise number="396" has_solution="false">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}{\text{sin}\left( \frac{n\pi}{2} \right)}$$</p>
    </problem>
  </exercise>
  <exercise number="397" has_solution="true">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}{\text{cos}\left( {\pi n} \right)e^{\text{−}n}}$$</p>
    </problem>
    <solution>
      <p>converges absolutely</p>
    </solution>
  </exercise>
  <exercise number="398" has_solution="false">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}\frac{2^{n + 4}}{7^{n}}$$</p>
    </problem>
  </exercise>
  <exercise number="399" has_solution="true">
    <problem>
      <p>$$\sum\limits_{n = 1}^{\infty}\frac{1}{(n + 1)(n + 2)}$$</p>
    </problem>
    <solution>
      <p>$$\frac{1}{2}$$</p>
    </solution>
  </exercise>
  <exercise number="400" has_solution="false">
    <problem>
      <p>A legend from India tells that a mathematician invented chess for a king. The king enjoyed the game so much he allowed the mathematician to demand any payment. The mathematician asked for one grain of rice for the first square on the chessboard, two grains of rice for the second square on the chessboard, four grains of rice for the third square on the chessboard, and so on. Find an exact expression for the total payment (in grains of rice) requested by the mathematician. Assuming there are $$30,000$$ grains of rice in $$1$$ pound, and $$2000$$ pounds in $$1$$ ton, how many tons of rice did the mathematician attempt to receive?</p>
    </problem>
  </exercise>
  <exercise number="401" has_solution="true">
    <problem>
      <p>Find $$\underset{n\rightarrow\infty}{\text{lim}}x_{n}$$ if $$b &gt; 1,$$ $$b &lt; 1,$$ and $$b = 1.$$</p>
    </problem>
    <solution>
      <p>$$\infty,$$ $$0,$$ $$x_{0}$$</p>
    </solution>
  </exercise>
  <exercise number="402" has_solution="false">
    <problem>
      <p>Find an expression for $$S_{n} = {\sum\limits_{i = 0}^{n}x_{i}}$$ in terms of $$b$$ and $$x_{0}.$$ What does it physically represent?</p>
    </problem>
  </exercise>
  <exercise number="403" has_solution="true">
    <problem>
      <p>If $$b = \frac{3}{4}$$ and $$x_{0} = 100,$$ find $$S_{10}$$ and $$\underset{n\rightarrow\infty}{\text{lim}}S_{n}$$</p>
    </problem>
    <solution>
      <p>$$S_{10} \approx 383,$$ $$\underset{n\rightarrow\infty}{\text{lim}}S_{n} = 400$$</p>
    </solution>
  </exercise>
  <exercise number="404" has_solution="false">
    <problem>
      <p>For what values of $$b$$ will the series converge and diverge? What does the series converge to?</p>
    </problem>
  </exercise>
</review_exercises>
