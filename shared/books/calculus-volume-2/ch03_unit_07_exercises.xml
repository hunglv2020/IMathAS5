    <paragraph>Determine the convergence of each of the following integrals by comparison with the given integral. If the integral converges, find the number to which it converges.</paragraph>
    <exercise number="372" has_solution="false">
      <problem>
        <paragraph>$$\int_{-\infty}^{\infty}{\frac{e^{x}}{1 + e^{2x}}dx}$$ compare with $$\int_{0}^{1}\frac{dx}{\sqrt[3]{x}}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="373" has_solution="true">
      <problem>
        <paragraph>$$\int_{0}^{2}\frac{dx}{x^{3}}$$ compare with $$\int_{-1}^{2}\frac{dx}{x^{3}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>Both integrals diverge.</paragraph>
      </solution>
    </exercise>
