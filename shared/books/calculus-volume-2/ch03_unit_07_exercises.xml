<section>
  <exercises>
    <heading level="1">Section 3.7 Exercises</heading>
    <paragraph>Evaluate the following integrals. If the integral is not convergent, answer “divergent.”</paragraph>
    <exercise number="347" has_solution="true">
      <problem>
        <paragraph>$$g(t) = {\int_{0}^{t}f}(u)du.$$</paragraph>
      </problem>
      <solution>
        <paragraph>divergent</paragraph>
      </solution>
    </exercise>
    <exercise number="348" has_solution="false">
      <problem>
        <paragraph>$$L\left\{ {g(t)} \right\} = {\int_{0}^{\infty}{e^{-st}g(t)dt}} = \underset{z\rightarrow\infty}{\lim }{\int_{0}^{z}{e^{-st}g(t)dt}}.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="349" has_solution="true">
      <problem>
        <paragraph>$$\underset{z\rightarrow\infty}{\lim }{\int_{0}^{z}{e^{-st}g(t)dt}}.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$\pi 2 \pi 2$$</paragraph>
      </solution>
    </exercise>
