  <exercise number="413" has_solution="true">
    <problem>
      <p>$$\int{\frac{1}{x^{2}\sqrt{x^{2} + 16}}dx}$$ using trigonometric substitution</p>
    </problem>
    <solution>
      <p>$$- \frac{\sqrt{x^{2} + 16}}{16x} + C$$</p>
    </solution>
  </exercise>
