  </exercise>
  <exercise number="421" has_solution="true">
    <problem>
      <p>$$\int{\frac{1}{x^{4} + 4}dx}$$</p>
    </problem>
    <solution>
      <p>$$\frac{1}{16}\text{ln}\left( \frac{x^{2} + 2x + 2}{x^{2} - 2x + 2} \right) - \frac{1}{8}\text{tan}^{-1}\left( {1 - x} \right) + \frac{1}{8}\text{tan}^{-1}\left( {x + 1} \right) + C$$</p>
    </solution>
  </exercise>
