    <paragraph>In the following exercises, use the substitutions $$\int\frac{dx}{x^{2}\sqrt{x^{2} + 1}}$$ or $$\int\frac{x^{2}dx}{\sqrt{1 + x^{2}}}$$ Express the final answers in terms of the variable x.</paragraph>
    <exercise number="154" has_solution="false">
      <problem>
        <paragraph>$$\int\left( 1 - x^{2} \right)^{3/2}dx$$</paragraph>
      </problem>
    </exercise>
    <exercise number="155" has_solution="true">
      <problem>
        <paragraph>$$x = \sinh \theta,\cosh \theta,$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$ln x - ln | 1 + 1 - x 2 | + C ln x - ln | 1 + 1 - x 2 | + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="156" has_solution="false">
      <problem>
        <paragraph>$$\tanh \theta.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="157" has_solution="true">
      <problem>
        <paragraph>$$\int\frac{dx}{\sqrt{x^{2} - 1}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$- -1 + x 2 x + ln | x + -1 + x 2 | + C - -1 + x 2 x + ln | x + -1 + x 2 | + C$$</paragraph>
      </solution>
    </exercise>
    <exercise number="158" has_solution="false">
