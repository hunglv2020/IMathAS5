      <problem>
        <paragraph>$$a^{2} + a^{2}\tan^{2}\theta$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$4 ( x - 1 2 ) 2 4 ( x - 1 2 ) 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="132" has_solution="false">
      <problem>
        <paragraph>$$a^{2} + a^{2}\sinh^{2}\theta$$</paragraph>
