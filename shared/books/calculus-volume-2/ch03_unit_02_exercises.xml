    </exercise>
    <exercise number="99" has_solution="true">
      <problem>
        <paragraph>$$\int{\cos^{2}3x dx}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x 2 + 1 12 sin ( 6 x ) + C x 2 + 1 12 sin ( 6 x ) + C$$</paragraph>
      </solution>
    </exercise>
