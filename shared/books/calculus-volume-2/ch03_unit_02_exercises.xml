    <exercise number="112" has_solution="false">
      <problem>
        <paragraph>Find the area of the region bounded by the graphs of the equations $$y = \sin x,y = \sin^{3}x,x = 0, \text{and} x = \frac{\pi}{2}.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="113" has_solution="true">
