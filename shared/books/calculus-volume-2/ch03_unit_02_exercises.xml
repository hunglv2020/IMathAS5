    <exercise number="114" has_solution="false">
      <problem>
        <paragraph>A particle moves in a straight line with the velocity function $$v(t) = \sin (\omega t)\cos^{2}\left( {\omega t} \right).$$ Find its position function $$x = f(t)$$ if $$f(0) = 0.$$</paragraph>
      </problem>
    </exercise>
