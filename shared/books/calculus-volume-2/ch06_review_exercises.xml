  <exercise number="261" has_solution="true">
    <problem>
      <p>$$f(x) = \frac{x^{2}}{x + 3}$$</p>
    </problem>
    <solution>
      <p>$$\sum\limits_{n = 0}^{\infty}\frac{(-1)^{n}}{3^{n + 1}}x^{n + 2};$$ ROC: $$3;$$ IOC: $$\left( {-3,3} \right)$$</p>
    </solution>
  </exercise>
