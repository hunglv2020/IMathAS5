  <exercise number="257" has_solution="true">
    <problem>
      <p>$${\sum\limits_{n = 0}^{\infty}n^{2}}\left( {x - 1} \right)^{n}$$</p>
    </problem>
    <solution>
      <p>ROC: $$1;$$ IOC: $$\left( {0,2} \right)$$</p>
    </solution>
  </exercise>
