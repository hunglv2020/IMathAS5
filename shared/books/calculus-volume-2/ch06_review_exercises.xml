  <exercise number="263" has_solution="true">
    <problem>
      <p>$$f(x) = \text{tan}^{-1}\left( {2x} \right)$$</p>
    </problem>
    <solution>
      <p>integration: $${\sum\limits_{n = 0}^{\infty}\frac{(-1)^{n}}{2n + 1}}\left( {2x} \right)^{2n + 1}$$</p>
    </solution>
