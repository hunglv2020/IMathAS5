  <exercise number="265" has_solution="true">
    <problem>
      <p>$$f(x) = x^{3} - 2x^{2} + 4,a = -3$$</p>
    </problem>
    <solution>
      <p>$$p_{4}(x) = \left( {x + 3} \right)^{3} - 11\left( {x + 3} \right)^{2} + 39\left( {x + 3} \right) - 41;$$ exact</p>
    </solution>
  </exercise>
