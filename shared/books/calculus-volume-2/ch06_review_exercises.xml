  <exercise number="267" has_solution="true">
    <problem>
      <p>$$f(x) = \text{cos}\left( {3x} \right)$$</p>
    </problem>
    <solution>
      <p>$$\sum\limits_{n = 0}^{\infty}\frac{(-1)^{n}\left( {3x} \right)^{2n}}{2n\text{!}}$$</p>
    </solution>
