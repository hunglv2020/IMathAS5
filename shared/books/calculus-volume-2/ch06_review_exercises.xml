  <exercise number="259" has_solution="true">
    <problem>
      <p>$$\sum\limits_{n = 0}^{\infty}\frac{3nx^{n}}{12^{n}}$$</p>
    </problem>
    <solution>
      <p>ROC: $$12;$$ IOC: $$\left( {-12,12} \right)$$</p>
