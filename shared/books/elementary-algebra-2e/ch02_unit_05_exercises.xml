<section>
  <exercises>
    <heading level="1">Section 2.5 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Solve Equations with Fraction Coefficients</paragraph>
    <paragraph>In the following exercises, solve each equation with fraction coefficients.</paragraph>
    <exercise number="318" has_solution="false">
      <problem>
        <paragraph>$$\frac{1}{4}x - \frac{1}{2} = - \frac{3}{4}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="319" has_solution="true">
      <problem>
        <paragraph>$$\frac{3}{4}x - \frac{1}{2} = \frac{1}{4}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x = 1 x = 1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="320" has_solution="false">
      <problem>
        <paragraph>$$\frac{5}{6}y - \frac{2}{3} = - \frac{3}{2}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="321" has_solution="true">
      <problem>
        <paragraph>$$\frac{5}{6}y - \frac{1}{3} = - \frac{7}{6}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = -1 y = -1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="322" has_solution="false">
      <problem>
        <paragraph>$$\frac{1}{2}a + \frac{3}{8} = \frac{3}{4}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="323" has_solution="true">
      <problem>
        <paragraph>$$\frac{5}{8}b + \frac{1}{2} = - \frac{3}{4}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$b = -2 b = -2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="324" has_solution="false">
      <problem>
        <paragraph>$$2 = \frac{1}{3}x - \frac{1}{2}x + \frac{2}{3}x$$</paragraph>
      </problem>
    </exercise>
    <exercise number="325" has_solution="true">
      <problem>
        <paragraph>$$2 = \frac{3}{5}x - \frac{1}{3}x + \frac{2}{5}x$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x = 3 x = 3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="326" has_solution="false">
      <problem>
        <paragraph>$$\frac{1}{4}m - \frac{4}{5}m + \frac{1}{2}m = -1$$</paragraph>
      </problem>
    </exercise>
    <exercise number="327" has_solution="true">
      <problem>
        <paragraph>$$\frac{5}{6}n - \frac{1}{4}n - \frac{1}{2}n = -2$$</paragraph>
