      <solution>
        <paragraph>$$n = -24 n = -24$$</paragraph>
      </solution>
    </exercise>
    <exercise number="328" has_solution="false">
      <problem>
        <paragraph>$$x + \frac{1}{2} = \frac{2}{3}x - \frac{1}{2}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="329" has_solution="true">
      <problem>
        <paragraph>$$x + \frac{3}{4} = \frac{1}{2}x - \frac{5}{4}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x = -4 x = -4$$</paragraph>
      </solution>
    </exercise>
    <exercise number="330" has_solution="false">
      <problem>
        <paragraph>$$\frac{1}{3}w + \frac{5}{4} = w - \frac{1}{4}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="331" has_solution="true">
      <problem>
        <paragraph>$$\frac{3}{2}z + \frac{1}{3} = z - \frac{2}{3}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$z = -2 z = -2$$</paragraph>
