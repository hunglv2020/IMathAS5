    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Use Negatives and Opposites of Integers</paragraph>
    <paragraph>In the following exercises, order each of the following pairs of numbers, using &lt; or &gt;.</paragraph>
    <exercise number="185" has_solution="true">
      <problem>
        <paragraph>ⓐ $$9 \text{\_\_\_} 4$$ ⓑ $$-3 \text{\_\_\_} 6$$ ⓒ $$-8 \text{\_\_\_} -2$$ ⓓ $$1 \text{\_\_\_} -10$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ &gt; ⓑ &lt; ⓒ &lt; ⓓ &gt;</paragraph>
      </solution>
    </exercise>
    <exercise number="186" has_solution="false">
      <problem>
        <paragraph>ⓐ $$-7 \text{\_\_\_} 3$$ ⓑ $$-10 \text{\_\_\_} -5$$ ⓒ $$2 \text{\_\_\_} -6$$ ⓓ $$8 \text{\_\_\_} 9$$</paragraph>
      </problem>
    </exercise>
