      </problem>
      <solution>
        <table summary="Demonstrates translation and simplification of a mathematical product from text to numerical result." number="Table 1.18">
          <tbody>
            <row>
              <cell />
              <cell>$$\text{the product}\ \textit{of}\ -2\ \textit{and}\ 14$$</cell>
            </row>
            <row>
              <cell>Translate.</cell>
              <cell>$$(-2)(14)$$</cell>
            </row>
            <row>
              <cell>Simplify.</cell>
              <cell>$$-28$$</cell>
            </row>
          </tbody>
        </table>
      </solution>
    </example>
