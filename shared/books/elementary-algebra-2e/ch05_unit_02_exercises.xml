    <paragraph>Solve Applications of Systems of Equations by Substitution</paragraph>
    <paragraph>In the following exercises, translate to a system of equations and solve.</paragraph>
    <exercise number="107" has_solution="true">
      <problem>
        <paragraph>The sum of two numbers is 15. One number is 3 less than the other. Find the numbers.</paragraph>
      </problem>
      <solution>
        <paragraph>The numbers are 6 and 9.</paragraph>
      </solution>
    </exercise>
    <exercise number="108" has_solution="false">
      <problem>
        <paragraph>The sum of two numbers is 30. One number is 4 less than the other. Find the numbers.</paragraph>
      </problem>
    </exercise>
    <exercise number="109" has_solution="true">
      <problem>
        <paragraph>The sum of two numbers is −26. One number is 12 less than the other. Find the numbers.</paragraph>
      </problem>
      <solution>
        <paragraph>The numbers are −7 and −19.</paragraph>
      </solution>
    </exercise>
