    <paragraph>Translate to an Equation and Solve</paragraph>
    <paragraph>In the following exercises, translate to an equation and then solve it.</paragraph>
    <exercise number="51" has_solution="true">
      <problem>
        <paragraph>Nine more than $$x$$ is equal to 52.</paragraph>
      </problem>
      <solution>
        <paragraph>$$x + 9 = 52 ; x = 43 x + 9 = 52 ; x = 43$$</paragraph>
      </solution>
    </exercise>
    <exercise number="52" has_solution="false">
      <problem>
        <paragraph>The sum of x and $$-15$$ is 23.</paragraph>
      </problem>
    </exercise>
    <exercise number="53" has_solution="true">
      <problem>
        <paragraph>Ten less than m is $$-14$$ .</paragraph>
      </problem>
      <solution>
        <paragraph>$$m - 10 = -14 ; m = -4 m - 10 = -14 ; m = -4$$</paragraph>
      </solution>
    </exercise>
    <exercise number="54" has_solution="false">
      <problem>
        <paragraph>Three less than y is $$-19$$ .</paragraph>
      </problem>
    </exercise>
    <exercise number="55" has_solution="true">
      <problem>
        <paragraph>The sum of y and $$-30$$ is 40.</paragraph>
      </problem>
      <solution>
        <paragraph>$$y + ( -30 ) = 40 ; y = 70 y + ( -30 ) = 40 ; y = 70$$</paragraph>
      </solution>
    </exercise>
