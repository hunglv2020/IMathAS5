    <heading level="1">Section 2.1 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Verify a Solution of an Equation</paragraph>
    <paragraph>In the following exercises, determine whether the given value is a solution to the equation.</paragraph>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>Is $$y = \frac{5}{3}$$ a solution of $$6y + 10 = 12y$$ ?</paragraph>
      </problem>
      <solution>
        <paragraph>yes</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>Is $$x = \frac{9}{4}$$ a solution of $$4x + 9 = 8x$$ ?</paragraph>
      </problem>
    </exercise>
