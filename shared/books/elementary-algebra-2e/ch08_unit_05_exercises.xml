    <heading level="1">Section 8.5 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Simplify a Complex Rational Expression by Writing It as Division</paragraph>
    <paragraph>In the following exercises, simplify.</paragraph>
    <exercise number="255" has_solution="true">
      <problem>
        <paragraph>$$\frac{\frac{2a}{a + 4}}{\frac{4a^{2}}{a^{2} - 16}}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$a - 4 2 a a - 4 2 a$$</paragraph>
      </solution>
    </exercise>
    <exercise number="256" has_solution="false">
