    <heading level="1">Section 5.6 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Determine Whether an Ordered Pair is a Solution of a System of Linear Inequalities</paragraph>
    <paragraph>In the following exercises, determine whether each ordered pair is a solution to the system.</paragraph>
    <exercise number="275" has_solution="true">
      <problem>
        <paragraph>$$\left\{ \begin{array}{l} {3x + y &gt; 5} \\ {2x - y \leq 10} \end{array} \right.$$</paragraph>
        <paragraph>ⓐ $$(3,-3)$$ ⓑ $$(7,1)$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ true ⓑ false</paragraph>
      </solution>
    </exercise>
    <exercise number="276" has_solution="false">
      <problem>
        <paragraph>$$\left\{ \begin{array}{l} {4x - y &lt; 10} \\ {-2x + 2y &gt; -8} \end{array} \right.$$</paragraph>
        <paragraph>ⓐ $$(5,-2)$$ ⓑ $$(-1,3)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="277" has_solution="true">
      <problem>
        <paragraph>$$\left\{ \begin{array}{l} {y &gt; \frac{2}{3}x - 5} \\ {x + \frac{1}{2}y \leq 4} \end{array} \right.$$</paragraph>
        <paragraph>ⓐ $$(6,-4)$$ ⓑ $$(3,0)$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ false ⓑ true</paragraph>
      </solution>
    </exercise>
    <exercise number="278" has_solution="false">
      <problem>
        <paragraph>$$\left\{ \begin{array}{l} {y &lt; \frac{3}{2}x + 3} \\ {\frac{3}{4}x - 2y &lt; 5} \end{array} \right.$$</paragraph>
        <paragraph>ⓐ $$(-4,-1)$$ ⓑ $$(8,3)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="279" has_solution="true">
