    <heading level="1">Everyday Math</heading>
    <exercise number="323" has_solution="true">
      <problem>
        <paragraph>Tickets for an American Baseball League game for 3 adults and 3 children cost less than \$75, while tickets for 2 adults and 4 children cost less than \$62.</paragraph>
        <list type="ordered">
          <item>ⓐ Write a system of inequalities to model this problem.</item>
          <item>ⓑ Graph the system.</item>
          <item>ⓒ Could the tickets cost \$20 for adults and \$8 for children?</item>
          <item>ⓓ Could the tickets cost \$15 for adults and \$5 for children?</item>
        </list>
      </problem>
      <solution>
        <list type="ordered">
          <item>ⓐ $${3a+3c&lt;752a+4c&lt;62{3a+3c&lt;752a+4c&lt;62$$</item>
          <item>ⓑ</item>
          <item>ⓒ No</item>
          <item>ⓓ Yes</item>
        </list>
      </solution>
    </exercise>
