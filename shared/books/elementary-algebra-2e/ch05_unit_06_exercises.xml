        <paragraph>ⓐ $$(2,3)$$ ⓑ $$(7,-1)$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ true ⓑ false</paragraph>
      </solution>
    </exercise>
    <exercise number="280" has_solution="false">
