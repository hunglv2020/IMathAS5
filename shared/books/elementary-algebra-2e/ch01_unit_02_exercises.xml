    <heading level="1">Everyday Math</heading>
    <exercise number="179" has_solution="true">
      <problem>
        <paragraph>Car insurance Justin’s car insurance has a \$750 deductible per incident. This means that he pays \$750 and his insurance company will pay all costs beyond \$750. If Justin files a claim for \$2,100.</paragraph>
        <list type="ordered">
          <item>ⓐ how much will he pay?</item>
          <item>ⓑ how much will his insurance company pay?</item>
        </list>
      </problem>
      <solution>
        <paragraph>ⓐ \$750 ⓑ \$1,350</paragraph>
      </solution>
    </exercise>
    <exercise number="180" has_solution="false">
