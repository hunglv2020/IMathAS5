    <heading level="1">Everyday Math</heading>
    <exercise number="504" has_solution="false">
      <problem>
        <paragraph>Safety A child’s height, h, must be at least 57 inches for the child to safely ride in the front seat of a car. Write this as an inequality.</paragraph>
      </problem>
    </exercise>
    <exercise number="505" has_solution="true">
      <problem>
        <paragraph>Fighter pilots The maximum height, h, of a fighter pilot is 77 inches. Write this as an inequality.</paragraph>
      </problem>
      <solution>
        <paragraph>$$h \le 77 h \le 77$$</paragraph>
      </solution>
    </exercise>
    <exercise number="506" has_solution="false">
      <problem>
        <paragraph>Elevators The total weight, w, of an elevator’s passengers can be no more than 1,200 pounds. Write this as an inequality.</paragraph>
      </problem>
    </exercise>
    <exercise number="507" has_solution="true">
      <problem>
        <paragraph>Shopping The number of items, n, a shopper can have in the express check-out lane is at most 8. Write this as an inequality.</paragraph>
      </problem>
      <solution>
        <paragraph>$$n \le 8 n \le 8$$</paragraph>
      </solution>
    </exercise>
