    <heading level="1">Section 4.2 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Recognize the Relationship Between the Solutions of an Equation and its Graph</paragraph>
    <paragraph>In the following exercises, for each ordered pair, decide:</paragraph>
    <paragraph>ⓐ Is the ordered pair a solution to the equation? ⓑ Is the point on the line?</paragraph>
    <exercise number="55" has_solution="true">
      <problem>
        <paragraph>$$y = x + 2$$</paragraph>
        <list type="ordered">
          <item>ⓐ $$\left( {0,2} \right)$$</item>
          <item>ⓑ $$\left( {1,2} \right)$$</item>
          <item>ⓒ $$\left( {-1,1} \right)$$</item>
          <item>ⓓ $$\left( {-3,-1} \right)$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>ⓐ yes; yes ⓑ no; no ⓒ yes; yes ⓓ yes; yes</paragraph>
      </solution>
    </exercise>
    <exercise number="56" has_solution="false">
      <problem>
        <paragraph>$$y = x - 4$$</paragraph>
        <list type="ordered">
          <item>ⓐ $$\left( {0,-4} \right)$$</item>
          <item>ⓑ $$\left( {3,-1} \right)$$</item>
          <item>ⓒ $$\left( {2,2} \right)$$</item>
          <item>ⓓ $$\left( {1,-5} \right)$$</item>
        </list>
      </problem>
    </exercise>
    <exercise number="57" has_solution="true">
      <problem>
        <paragraph>$$y = \frac{1}{2}x - 3$$</paragraph>
        <list type="ordered">
          <item>ⓐ $$\left( {0,-3} \right)$$</item>
          <item>ⓑ $$\left( {2,-2} \right)$$</item>
          <item>ⓒ $$\left( {-2,-4} \right)$$</item>
          <item>ⓓ $$\left( {4,1} \right)$$</item>
        </list>
      </problem>
      <solution>
        <paragraph>ⓐ yes; yes ⓑ yes; yes ⓒ yes; yes ⓓ no; no</paragraph>
      </solution>
    </exercise>
