    <heading level="1">Everyday Math</heading>
    <exercise number="385" has_solution="true">
      <problem>
        <paragraph>A supply kit is dropped from an airplane flying at an altitude of 250 feet. Simplify $$\sqrt{\frac{250}{16}}$$ to determine how many seconds it takes for the supply kit to reach the ground.</paragraph>
      </problem>
      <solution>
        <paragraph>$$5 10 4 seconds 5 10 4 seconds$$</paragraph>
      </solution>
    </exercise>
    <exercise number="386" has_solution="false">
      <problem>
