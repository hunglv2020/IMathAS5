    <paragraph>Add: $$12q^{2} + 9q^{2}.$$</paragraph>
  </note>
  <note type="practice" source_type="Try It" title="Try It" number="6.6">
    <paragraph>Add: $$-15c^{2} + 8c^{2}.$$</paragraph>
  </note>
  <example number="6.4">
    <problem>
      <paragraph>Subtract: $$16p - \left( {-7p} \right)$$ .</paragraph>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell/>
            <cell>$$16p - \left( {-7p} \right)$$</cell>
          </row>
          <row>
            <cell>Combine like terms.</cell>
            <cell>$$23p$$</cell>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
