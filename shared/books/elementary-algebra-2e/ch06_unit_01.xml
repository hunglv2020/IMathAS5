            <cell/>
          </row>
          <row>
            <cell/>
            <cell/>
          </row>
          <row>
            <cell>Simplify the exponents.</cell>
            <cell/>
          </row>
          <row>
            <cell>Multiply.</cell>
            <cell/>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell/>
          </row>
        </tbody>
      </table>
      <table>
        <tbody>
          <row>
            <cell>ⓑ $$x = -2$$</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell/>
          </row>
          <row>
