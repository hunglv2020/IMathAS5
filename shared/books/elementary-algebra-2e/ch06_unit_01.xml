  <example number="6.14">
    <problem>
      <paragraph>The polynomial $$-16t^{2} + 250$$ gives the height of a ball $$t$$ seconds after it is dropped from a 250 foot tall building. Find the height after $$t = 2$$ seconds.</paragraph>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell/>
            <cell>$$-16t^{2} + 250$$</cell>
          </row>
          <row>
            <cell>Substitute $$t = 2$$ .</cell>
            <cell>$$-16{(2)}^{2} + 250$$</cell>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell>$$-16 \cdot 4 + 250$$</cell>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell>$$-64 + 250$$</cell>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell>$$186$$</cell>
          </row>
          <row>
            <cell/>
            <cell>After 2 seconds the height of the ball is 186 feet.</cell>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
