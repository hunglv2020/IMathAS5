<section number="9.4" title="Multiply Square Roots">
  <learning_objectives>
    <objective number="" />
    <objective number="" />
  </learning_objectives>
  <note type="Be Prepared" number="9.9">
    <p>Before you get started, take this readiness quiz.</p>
    <p>Simplify: $$\left( {3u} \right)\left( {8v} \right)$$.
If you missed this problem, review Example 6.26.</p>
  </note>
  <note type="Be Prepared" number="9.10">
    <p>Simplify: $$6\left( {12 - 7n} \right)$$.
If you missed this problem, review Example 6.28.</p>
  </note>
