        <paragraph>ⓐ $$y = 5$$ ⓑ $$y = -2$$ ⓒ $$y = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ 187 ⓑ 40 ⓒ 2</paragraph>
      </solution>
    </exercise>
    <exercise number="72" has_solution="true">
