    <heading level="1">Everyday Math</heading>
    <exercise number="49" has_solution="true">
      <problem>
        <paragraph>Decorating Denise wants to have a square accent of designer tiles in her new shower. She can afford to buy 625 square centimeters of the designer tiles. How long can a side of the accent be?</paragraph>
      </problem>
      <solution>
        <paragraph>25 centimeters</paragraph>
      </solution>
    </exercise>
    <exercise number="50" has_solution="false">
      <problem>
        <paragraph>Decorating Morris wants to have a square mosaic inlaid in his new patio. His budget allows for 2025 square inch tiles. How long can a side of the mosaic be?</paragraph>
      </problem>
    </exercise>
