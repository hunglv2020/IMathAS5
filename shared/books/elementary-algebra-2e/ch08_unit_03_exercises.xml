  <exercises>
    <heading level="1">Section 8.3 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Add Rational Expressions with a Common Denominator</paragraph>
    <paragraph>In the following exercises, add.</paragraph>
    <exercise number="129" has_solution="true">
      <problem>
        <paragraph>$$\frac{2}{15} + \frac{7}{15}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$3 5 3 5$$</paragraph>
      </solution>
    </exercise>
    <exercise number="130" has_solution="false">
      <problem>
        <paragraph>$$\frac{4}{21} + \frac{3}{21}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="131" has_solution="true">
      <problem>
        <paragraph>$$\frac{7}{24} + \frac{11}{24}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$1 1$$</paragraph>
      </solution>
    </exercise>
