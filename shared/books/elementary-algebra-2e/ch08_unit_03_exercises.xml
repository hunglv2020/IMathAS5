    <paragraph>Add and Subtract Rational Expressions whose Denominators are Opposites</paragraph>
    <paragraph>In the following exercises, add.</paragraph>
    <exercise number="157" has_solution="true">
      <problem>
        <paragraph>$$\frac{10v}{2v - 1} + \frac{2v + 4}{1 - 2v}$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$4 4$$</paragraph>
      </solution>
    </exercise>
    <exercise number="158" has_solution="false">
      <problem>
        <paragraph>$$\frac{20w}{5w - 2} + \frac{5w + 6}{2 - 5w}$$</paragraph>
      </problem>
    </exercise>
    <exercise number="159" has_solution="true">
      <problem>
        <paragraph>$$\frac{10x^{2} + 16x - 7}{8x - 3} + \frac{2x^{2} + 3x - 1}{3 - 8x}$$</paragraph>
      </problem>
