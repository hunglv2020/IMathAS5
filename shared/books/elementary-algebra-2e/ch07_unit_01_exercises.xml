    <heading level="1">Everyday Math</heading>
    <exercise number="59" has_solution="true">
      <problem>
        <paragraph>Area of a rectangle The area of a rectangle with length 6 less than the width is given by the expression $$w^{2} - 6w$$ , where $$w =$$ width. Factor the greatest common factor from the polynomial.</paragraph>
      </problem>
      <solution>
        <paragraph>$$w ( w - 6 ) w ( w - 6 )$$</paragraph>
      </solution>
    </exercise>
    <exercise number="60" has_solution="false">
      <problem>
        <paragraph>Height of a baseball The height of a baseball t seconds after it is hit is given by the expression $$-16t^{2} + 80t + 4$$ . Factor the greatest common factor from the polynomial.</paragraph>
      </problem>
    </exercise>
