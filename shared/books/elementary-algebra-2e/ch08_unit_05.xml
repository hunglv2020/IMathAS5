  <example number="8.57">
    <problem>
      <paragraph>Simplify: $$\frac{\frac{4}{m^{2} - 7m + 12}}{\frac{3}{m - 3} - \frac{2}{m - 4}}.$$</paragraph>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell/>
            <cell/>
          </row>
          <row>
            <cell>Find the LCD of all fractions in the complex rational expression. The LCD is $$(m - 3)(m - 4)$$ .</cell>
            <cell/>
          </row>
          <row>
            <cell>Multiply the numerator and denominator by the LCD.</cell>
            <cell/>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell/>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell/>
          </row>
          <row>
            <cell>Distribute.</cell>
            <cell/>
          </row>
          <row>
            <cell>Combine like terms.</cell>
            <cell/>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
