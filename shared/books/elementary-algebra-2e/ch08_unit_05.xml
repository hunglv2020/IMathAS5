  <example number="8.58">
    <problem>
      <paragraph>Simplify: $$\frac{\frac{y}{y + 1}}{1 + \frac{1}{y - 1}}.$$</paragraph>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell/>
            <cell/>
          </row>
          <row>
            <cell>Find the LCD of all fractions in the complex rational expression.</cell>
            <cell/>
          </row>
          <row>
            <cell>The LCD is $$(y + 1)(y - 1)$$ .</cell>
            <cell/>
          </row>
          <row>
            <cell>Multiply the numerator and denominator by the LCD.</cell>
            <cell/>
          </row>
          <row>
            <cell>Distribute in the denominator and simplify.</cell>
            <cell/>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell/>
          </row>
          <row>
            <cell>Simplify the denominator, and leave the numerator factored.</cell>
            <cell/>
          </row>
          <row>
            <cell/>
            <cell/>
          </row>
          <row>
            <cell>Factor the denominator, and remove factors common with the numerator.</cell>
            <cell/>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell/>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
