    <paragraph>Complete a Table of Solutions to a Linear Equation</paragraph>
    <paragraph>In the following exercises, complete the table to find solutions to each linear equation.</paragraph>
    <exercise number="21" has_solution="true">
      <problem>
        <paragraph>$$y = 2x - 4$$</paragraph>
        <table>
          <tbody>
            <row>
              <cell>$$x$$</cell>
              <cell>$$y$$</cell>
              <cell>$$\left( {x,y} \right)$$</cell>
            </row>
            <row>
              <cell>0</cell>
              <cell/>
              <cell/>
            </row>
            <row>
              <cell>2</cell>
              <cell/>
              <cell/>
            </row>
            <row>
              <cell>$$-1$$</cell>
              <cell/>
              <cell/>
            </row>
          </tbody>
        </table>
      </problem>
      <solution>
        <table>
          <tbody>
            <row>
              <cell>$$xx$$</cell>
              <cell>$$yy$$</cell>
              <cell>$$(x,y)(x,y)$$</cell>
            </row>
            <row>
              <cell>0</cell>
              <cell>$$-4-4$$</cell>
              <cell>$$(0,-4)(0,-4)$$</cell>
            </row>
            <row>
              <cell>2</cell>
              <cell>0</cell>
              <cell>$$(2,0)(2,0)$$</cell>
            </row>
            <row>
              <cell>$$-1-1$$</cell>
              <cell>$$-6-6$$</cell>
              <cell>$$(-1,-6)(-1,-6)$$</cell>
            </row>
          </tbody>
        </table>
      </solution>
    </exercise>
