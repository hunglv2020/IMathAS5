          <tbody>
            <row>
              <cell />
              <cell />
            </row>
            <row>
              <cell>Find the LCD of all fractions in the equation.The LCD is 8.</cell>
              <cell />
            </row>
            <row>
              <cell>Multiply both sides by the LCD.</cell>
              <cell />
            </row>
            <row>
              <cell>Distribute.</cell>
              <cell />
            </row>
            <row>
              <cell>Simplify—no more fractions.</cell>
              <cell />
            </row>
            <row>
              <cell>Subtract $$3a$$ from both sides.</cell>
              <cell />
            </row>
            <row>
              <cell>Simplify.</cell>
              <cell />
            </row>
            <row>
              <cell>Subtract 6 from both sides.</cell>
              <cell />
            </row>
            <row>
              <cell>Simplify.</cell>
              <cell />
            </row>
            <row>
              <cell>Divide by 5.</cell>
              <cell />
            </row>
            <row>
              <cell>Simplify.</cell>
              <cell />
            </row>
            <row>
              <cell>Check:</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>Let $$a = -2$$.</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell />
