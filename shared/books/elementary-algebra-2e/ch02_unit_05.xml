  <paragraph>The next example uses an equation that is typical of the money applications in the next chapter. Notice that we distribute the decimal before we clear all the decimals.</paragraph>
  <example number="2.57">
    <problem>
      <paragraph>Solve: $$0.25x + 0.05(x + 3) = 2.85$$ .</paragraph>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell/>
            <cell/>
          </row>
          <row>
            <cell>Distribute first.</cell>
            <cell/>
          </row>
          <row>
            <cell>Combine like terms.</cell>
            <cell/>
          </row>
          <row>
            <cell>To clear decimals, multiply by 100.</cell>
            <cell/>
          </row>
          <row>
            <cell>Distribute.</cell>
            <cell/>
          </row>
          <row>
            <cell>Subtract 15 from both sides.</cell>
            <cell/>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell/>
          </row>
          <row>
            <cell>Divide by 30.</cell>
            <cell/>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell/>
          </row>
          <row>
            <cell>Check it yourself by substituting $$x = 9$$ into the original equation.</cell>
            <cell/>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
