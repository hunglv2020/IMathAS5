      <problem>
        <p>Solve: $$-5 = \frac{1}{4}\left( {8x + 4} \right)$$.</p>
      </problem>
      <solution>
        <table>
          <tbody>
            <row>
              <cell />
              <cell />
            </row>
            <row>
              <cell>Distribute.</cell>
              <cell />
            </row>
            <row>
              <cell>Simplify.Now there are no fractions.</cell>
              <cell />
            </row>
            <row>
              <cell>Subtract 1 from both sides.</cell>
              <cell />
