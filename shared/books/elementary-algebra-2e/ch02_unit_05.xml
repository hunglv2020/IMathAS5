              <cell />
            </row>
            <row>
              <cell />
              <cell />
              <cell />
            </row>
            <row>
              <cell />
              <cell />
              <cell />
            </row>
          </tbody>
        </table>
      </solution>
    </example>
    <note type="Try It" number="2.99">
      <p>Solve: $$x + \frac{1}{3} = \frac{1}{6}x - \frac{1}{2}$$.</p>
