    <heading level="1">Everyday Math</heading>
    <exercise number="359" has_solution="true">
      <problem>
        <paragraph>Area of a patio If each side of a square patio is increased by 4 feet, the area of the patio would be 196 square feet. Solve the equation $$\left( {s + 4} \right)^{2} = 196$$ for s to find the length of a side of the patio.</paragraph>
      </problem>
      <solution>
        <paragraph>10 feet</paragraph>
      </solution>
    </exercise>
    <exercise number="360" has_solution="false">
      <problem>
        <paragraph>Watermelon drop A watermelon is dropped from the tenth story of a building. Solve the equation $$-16t^{2} + 144 = 0$$ for $$t$$ to find the number of seconds it takes the watermelon to reach the ground.</paragraph>
      </problem>
    </exercise>
    <heading level="1">Writing Exercises</heading>
    <exercise number="361" has_solution="true">
      <problem>
        <paragraph>Explain how you solve a quadratic equation. How many answers do you expect to get for a quadratic equation?</paragraph>
      </problem>
      <solution>
        <paragraph>Answers may vary.</paragraph>
      </solution>
    </exercise>
    <exercise number="362" has_solution="false">
