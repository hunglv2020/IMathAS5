<section>
  <exercises>
    <heading level="1">Section 7.6 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Use the Zero Product Property</paragraph>
    <paragraph>In the following exercises, solve.</paragraph>
    <exercise number="315" has_solution="true">
      <problem>
        <paragraph>$$\left( {x - 3} \right)\left( {x + 7} \right) = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x = 3 , x = -7 x = 3 , x = -7$$</paragraph>
      </solution>
    </exercise>
    <exercise number="316" has_solution="false">
      <problem>
        <paragraph>$$\left( {y - 11} \right)\left( {y + 1} \right) = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="317" has_solution="true">
      <problem>
        <paragraph>$$\left( {3a - 10} \right)\left( {2a - 7} \right) = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$a = 10 / 3 , a = 7 / 2 a = 10 / 3 , a = 7 / 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="318" has_solution="false">
      <problem>
        <paragraph>$$\left( {5b + 1} \right)\left( {6b + 1} \right) = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="319" has_solution="true">
      <problem>
        <paragraph>$$6m\left( {12m - 5} \right) = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$m = 0 , m = 5 / 12 m = 0 , m = 5 / 12$$</paragraph>
      </solution>
    </exercise>
    <exercise number="320" has_solution="false">
      <problem>
        <paragraph>$$2x\left( {6x - 3} \right) = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="321" has_solution="true">
      <problem>
        <paragraph>$${(y - 3)}^{2} = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y = 3 y = 3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="322" has_solution="false">
      <problem>
        <paragraph>$${(b + 10)}^{2} = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="323" has_solution="true">
      <problem>
        <paragraph>$${(2x - 1)}^{2} = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x = 1 / 2 x = 1 / 2$$</paragraph>
      </solution>
    </exercise>
    <exercise number="324" has_solution="false">
      <problem>
        <paragraph>$${(3y + 5)}^{2} = 0$$</paragraph>
      </problem>
    </exercise>
    <paragraph>Solve Quadratic Equations by Factoring</paragraph>
    <paragraph>In the following exercises, solve.</paragraph>
    <exercise number="325" has_solution="true">
      <problem>
        <paragraph>$$x^{2} + 7x + 12 = 0$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$x = -3 , x = -4 x = -3 , x = -4$$</paragraph>
      </solution>
    </exercise>
    <exercise number="326" has_solution="false">
      <problem>
        <paragraph>$$y^{2} - 8y + 15 = 0$$</paragraph>
      </problem>
    </exercise>
    <exercise number="327" has_solution="true">
      <problem>
        <paragraph>$$5a^{2} - 26a = 24$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$a = -4 / 5 , a = 6 a = -4 / 5 , a = 6$$</paragraph>
      </solution>
    </exercise>
    <exercise number="328" has_solution="false">
      <problem>
        <paragraph>$$4b^{2} + 7b = -3$$</paragraph>
      </problem>
    </exercise>
    <exercise number="329" has_solution="true">
      <problem>
        <paragraph>$$4m^{2} = 17m - 15$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$m = 5 / 4 , m = 3 m = 5 / 4 , m = 3$$</paragraph>
      </solution>
    </exercise>
    <exercise number="330" has_solution="false">
      <problem>
        <paragraph>$$n^{2} = 5n - 6$$</paragraph>
      </problem>
    </exercise>
    <exercise number="331" has_solution="true">
      <problem>
        <paragraph>$$7a^{2} + 14a = 7a$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$a = -1 , a = 0 a = -1 , a = 0$$</paragraph>
      </solution>
    </exercise>
    <exercise number="332" has_solution="false">
      <problem>
        <paragraph>$$12b^{2} - 15b = -9b$$</paragraph>
      </problem>
    </exercise>
    <exercise number="333" has_solution="true">
      <problem>
        <paragraph>$$49m^{2} = 144$$</paragraph>
