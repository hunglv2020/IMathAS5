      </problem>
      <solution>
        <paragraph>$$x = 3 / 2 , x = -1 x = 3 / 2 , x = -1$$</paragraph>
      </solution>
    </exercise>
    <exercise number="338" has_solution="false">
      <problem>
        <paragraph>$$\left( {x + 6} \right)\left( {x - 3} \right) = -8$$</paragraph>
      </problem>
    </exercise>
    <exercise number="339" has_solution="true">
      <problem>
        <paragraph>$$16p^{3} = 24p^{2} - 9p$$</paragraph>
