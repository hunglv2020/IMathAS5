  <example number="7.60">
    <problem>
      <paragraph>Factor completely: $$12x^{2} - 11x + 2$$ .</paragraph>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell/>
            <cell/>
            <cell/>
          </row>
          <row>
            <cell>Is there a GCF?</cell>
            <cell>No.</cell>
            <cell/>
          </row>
          <row>
            <cell>Is it a binomial, trinomial, or arethere more than three terms?</cell>
            <cell>Trinomial.</cell>
            <cell/>
          </row>
          <row>
            <cell>Are a and c perfect squares?</cell>
            <cell>No, a = 12,not a perfect square.</cell>
            <cell/>
          </row>
          <row>
            <cell>Use trial and error or the “ac” method.We will use trial and error here.</cell>
            <cell/>
            <cell/>
          </row>
        </tbody>
      </table>
      <paragraph>Check.</paragraph>
      <paragraph>$$\left( {3x - 2} \right)\left( {4x - 1} \right)$$</paragraph>
      <paragraph>$$12x^{2} - 3x - 8x + 2$$</paragraph>
      <paragraph>$$12x^{2} - 11x + 2 ✓$$</paragraph>
    </solution>
  </example>
