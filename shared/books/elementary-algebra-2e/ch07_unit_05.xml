  <example number="7.61">
    <problem>
      <paragraph>Factor completely: $$g^{3} + 25g$$ .</paragraph>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell>Is there a GCF?</cell>
            <cell>Yes, g.</cell>
            <cell>$$g^{3} + 25g$$</cell>
          </row>
          <row>
            <cell>Factor out the GCF.</cell>
            <cell/>
            <cell>$$g\left( {g^{2} + 25} \right)$$</cell>
          </row>
          <row>
            <cell>In the parentheses, is it a binomial, trinomial,or are there more than three terms?</cell>
            <cell>Binomial.</cell>
            <cell/>
          </row>
          <row>
            <cell>Is it a sum ? Of squares?</cell>
            <cell>Yes.</cell>
            <cell>Sums of squares are prime.</cell>
          </row>
          <row>
            <cell>Check.</cell>
            <cell/>
            <cell/>
          </row>
          <row>
            <cell>Is the expression factored completely?</cell>
            <cell>Yes.</cell>
            <cell/>
          </row>
          <row>
            <cell>Multiply. $$\begin{array}{l} \\ \\ \\ { g\left( {g^{2} + 25} \right)} \\ { g^{3} + 25g ✓} \end{array}$$</cell>
            <cell/>
            <cell/>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
