    <example number="7.63">
      <problem>
        <p>Factor completely: $$4a^{2} - 12ab + 9b^{2}$$.</p>
      </problem>
      <solution>
        <table>
          <tbody>
            <row>
              <cell>Is there a GCF?</cell>
              <cell>No.</cell>
              <cell />
            </row>
            <row>
              <cell>Is it a binomial, trinomial, or are theremore terms?</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>Trinomial with $$a \neq 1$$. But the first term is a  perfect square.</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>Is the last term a perfect square?</cell>
              <cell>Yes.</cell>
              <cell />
            </row>
            <row>
              <cell>Does it fit the pattern, $$a^{2} - 2ab + b^{2}?$$</cell>
              <cell>Yes.</cell>
              <cell />
            </row>
            <row>
              <cell>Write it as a square.</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>Check your answer.</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>Is the expression factored completely?</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>Yes.</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>The binomial is not a difference of squares.</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>Multiply.</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>$$(2a - 3b)^{2}$$</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>$$(2a)^{2} - 2 \cdot 2a \cdot 3b + (3b)^{2}$$</cell>
              <cell />
              <cell />
            </row>
            <row>
              <cell>$$4a^{2} - 12ab + 9b^{2}✓$$</cell>
              <cell />
              <cell />
            </row>
          </tbody>
        </table>
      </solution>
    </example>
