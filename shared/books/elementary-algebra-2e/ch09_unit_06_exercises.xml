    <heading level="1">Section 9.6 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Solve Radical Equations</paragraph>
    <paragraph>In the following exercises, check whether the given values are solutions.</paragraph>
    <exercise number="389" has_solution="true">
      <problem>
        <paragraph>For the equation $$\sqrt{x + 12} = x$$ : ⓐ Is $$x = 4$$ a solution? ⓑ Is $$x = -3$$ a solution?</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ $$yesyes$$ ⓑ $$nono$$</paragraph>
      </solution>
    </exercise>
    <exercise number="390" has_solution="false">
      <problem>
        <paragraph>For the equation $$\sqrt{-y + 20} = y$$ : ⓐ Is $$y = 4$$ a solution? ⓑ Is $$y = -5$$ a solution?</paragraph>
      </problem>
    </exercise>
    <exercise number="391" has_solution="true">
      <problem>
        <paragraph>For the equation $$\sqrt{t + 6} = t$$ : ⓐ Is $$t = -2$$ a solution? ⓑ Is $$t = 3$$ a solution?</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ no ⓑ yes</paragraph>
      </solution>
    </exercise>
