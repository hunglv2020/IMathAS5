        <paragraph>ⓐ $$\left( {\frac{8}{7},\frac{6}{7}} \right)$$ ⓑ $$\left( {1,\frac{3}{4}} \right)$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ yes ⓑ no</paragraph>
      </solution>
    </exercise>
    <exercise number="6" has_solution="false">
