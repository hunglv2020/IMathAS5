<section>
  <exercises>
    <heading level="1">Section 5.1 Exercises</heading>
    <heading level="1">Practice Makes Perfect</heading>
    <paragraph>Determine Whether an Ordered Pair is a Solution of a System of Equations. In the following exercises, determine if the following points are solutions to the given system of equations.</paragraph>
    <exercise number="1" has_solution="true">
      <problem>
        <paragraph>$$\left\{ \begin{array}{l} {2x - 6y = 0} \\ {3x - 4y = 5} \end{array} \right.$$</paragraph>
        <paragraph>ⓐ $$(3,1)$$ ⓑ $$(-3,4)$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ yes ⓑ no</paragraph>
      </solution>
    </exercise>
    <exercise number="2" has_solution="false">
      <problem>
        <paragraph>$$\left\{ \begin{array}{l} {7x - 4y = -1} \\ {-3x - 2y = 1} \end{array} \right.$$</paragraph>
        <paragraph>ⓐ $$(1,2)$$ ⓑ $$(1,-2)$$</paragraph>
      </problem>
    </exercise>
    <exercise number="3" has_solution="true">
      <problem>
        <paragraph>$$\left\{ \begin{array}{l} {2x + y = 5} \\ {x + y = 1} \end{array} \right.$$</paragraph>
        <paragraph>ⓐ $$(4, \text{−3} )$$ ⓑ $$(2,0)$$</paragraph>
      </problem>
      <solution>
        <paragraph>ⓐ yes ⓑ no</paragraph>
      </solution>
    </exercise>
    <exercise number="4" has_solution="false">
      <problem>
        <paragraph>$$\left\{ \begin{array}{l} {-3x + y = 8} \\ {- x + 2y = -9} \end{array} \right.$$</paragraph>
        <paragraph>ⓐ $$(-5,-7)$$ ⓑ $$(-5,7)$$</paragraph>
      </problem>
    </exercise>
