  <note type="procedure" source_type="How To" title="How To">
    <heading level="4">Multiply a rational expression.</heading>
    <list type="ordered">
      <item>Step 1. Factor each numerator and denominator completely.</item>
      <item>Step 2. Multiply the numerators and denominators.</item>
      <item>Step 3. Simplify by dividing out common factors.</item>
    </list>
  </note>
  <example number="8.20">
    <problem>
      <paragraph>Multiply: $$\frac{n^{2} - 7n}{n^{2} + 2n + 1} \cdot \frac{n + 1}{2n}.$$</paragraph>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell/>
            <cell>$$\frac{n^{2} - 7n}{n^{2} + 2n + 1} \cdot \frac{n + 1}{2n}$$</cell>
          </row>
          <row>
            <cell>Factor each numerator and denominator.</cell>
            <cell>$$\frac{n\left( {n - 7} \right)}{\left( {n + 1} \right)\left( {n + 1} \right)} \cdot \frac{n + 1}{2n}$$</cell>
          </row>
          <row>
            <cell>Multiply the numerators and the denominators.</cell>
            <cell>$$\frac{n\left( {n - 7} \right)\left( {n + 1} \right)}{\left( {n + 1} \right)\left( {n + 1} \right)2n}$$</cell>
          </row>
          <row>
            <cell>Remove common factors.</cell>
            <cell>$$\frac{n\left( {n - 7} \right)\left( {n + 1} \right)}{\left( {n + 1} \right)\left( {n + 1} \right)2n}$$</cell>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell>$$\frac{n - 7}{2\left( {n + 1} \right)}$$</cell>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
  <note type="practice" source_type="Try It" title="Try It" number="8.39">
    <paragraph>Multiply: $$\frac{x^{2} - 25}{x^{2} - 3x - 10} \cdot \frac{x + 2}{x}.$$</paragraph>
  </note>
  <note type="practice" source_type="Try It" title="Try It" number="8.40">
    <paragraph>Multiply: $$\frac{x^{2} - 4x}{x^{2} + 5x + 6} \cdot \frac{x + 2}{x}.$$</paragraph>
  </note>
  <example number="8.21">
    <problem>
      <paragraph>Multiply: $$\frac{16 - 4x}{2x - 12} \cdot \frac{x^{2} - 5x - 6}{x^{2} - 16}.$$</paragraph>
    </problem>
    <solution>
      <table>
        <tbody>
          <row>
            <cell/>
            <cell>$$\frac{16 - 4x}{2x - 12} \cdot \frac{x^{2} - 5x - 6}{x^{2} - 16}$$</cell>
          </row>
          <row>
            <cell>Factor each numerator and denominator.</cell>
            <cell>$$\frac{4\left( {4 - x} \right)}{2\left( {x - 6} \right)} \cdot \frac{\left( {x - 6} \right)\left( {x + 1} \right)}{\left( {x - 4} \right)\left( {x + 4} \right)}$$</cell>
          </row>
          <row>
            <cell>Multiply the numerators and the denominators.</cell>
            <cell>$$\frac{4\left( {4 - x} \right)\left( {x - 6} \right)\left( {x + 1} \right)}{2\left( {x - 6} \right)\left( {x - 4} \right)\left( {x + 4} \right)}$$</cell>
          </row>
          <row>
            <cell>Remove common factors.</cell>
            <cell>$$(-1)\frac{2 \cdot 2\left( {4 - x} \right)\left( {x - 6} \right)\left( {x + 1} \right)}{2\left( {x - 6} \right)\left( {x - 4} \right)\left( {x + 4} \right)}$$</cell>
          </row>
          <row>
            <cell>Simplify.</cell>
            <cell>$$- \frac{2\left( {x + 1} \right)}{\left( {x + 4} \right)}$$</cell>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
