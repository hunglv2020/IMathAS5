    <example number="6.27">
      <problem>
        <p>Multiply: $$\left( {\frac{5}{6}x^{3}y} \right)\left( {12xy^{2}} \right).$$</p>
      </problem>
      <solution>
        <table summary="Simplification of an algebraic expression, showing steps including the Commutative Property to arrive at the final product.">
          <tbody>
            <row>
              <cell />
              <cell>$$\left( {\frac{5}{6}x^{3}y} \right)\left( {12xy^{2}} \right)$$</cell>
            </row>
            <row>
              <cell>Use the Commutative Property to rearrange the terms.</cell>
              <cell>$$\frac{5}{6} \cdot 12 \cdot x^{3} \cdot x \cdot y \cdot y^{2}$$</cell>
            </row>
            <row>
              <cell>Multiply.</cell>
              <cell>$$10x^{4}y^{3}$$</cell>
            </row>
          </tbody>
        </table>
      </solution>
    </example>
