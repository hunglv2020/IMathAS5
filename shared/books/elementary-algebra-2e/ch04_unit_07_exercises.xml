    <paragraph>Recognize the Relation Between the Solutions of an Inequality and its Graph</paragraph>
    <paragraph>In the following exercises, write the inequality shown by the shaded region.</paragraph>
    <exercise number="510" has_solution="false">
      <problem>
        <paragraph>Write the inequality shown by the graph with the boundary line $$y = 3x - 4.$$</paragraph>
      </problem>
    </exercise>
    <exercise number="511" has_solution="true">
      <problem>
        <paragraph>Write the inequality shown by the graph with the boundary line $$y = 2x - 4.$$</paragraph>
      </problem>
      <solution>
        <paragraph>$$y &lt; 2 x - 4 y &lt; 2 x - 4$$</paragraph>
      </solution>
    </exercise>
    <exercise number="512" has_solution="false">
