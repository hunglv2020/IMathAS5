    <problem>
      <paragraph>Factor: $$-6a^{2} + 36a$$ .</paragraph>
    </problem>
    <solution>
      <paragraph>The leading coefficient is negative, so the GCF will be negative?</paragraph>
      <table>
        <tbody>
          <row>
            <cell>Since the leading coefficient is negative, the GCF is negative, −6a.</cell>
            <cell/>
          </row>
          <row>
            <cell>Rewrite each term using the GCF.</cell>
            <cell/>
          </row>
          <row>
            <cell>Factor the GCF.</cell>
            <cell/>
          </row>
          <row>
            <cell>Check.</cell>
            <cell/>
          </row>
          <row>
            <cell>$$-6a(a - 6)$$</cell>
            <cell/>
          </row>
          <row>
            <cell>$$-6a \cdot a + (-6a)(-6)$$</cell>
            <cell/>
          </row>
          <row>
            <cell>$$-6a^{2} + 36a✓$$</cell>
            <cell/>
          </row>
        </tbody>
      </table>
    </solution>
  </example>
