{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/jerry/project/IMathAS5/.codex/hooks/session_start.py",
            "timeout": 30,
            "statusMessage": "Loading IMathAS5 workspace guidance"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/jerry/project/IMathAS5/.codex/hooks/pre_edit_guard.py",
            "timeout": 30,
            "statusMessage": "Checking IMathAS edit policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/jerry/project/IMathAS5/.codex/hooks/post_edit_state.py",
            "timeout": 30,
            "statusMessage": "Tracking IMathAS edit state"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/jerry/project/IMathAS5/.codex/hooks/post_bash_state.py",
            "timeout": 30,
            "statusMessage": "Tracking validation commands"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/jerry/project/IMathAS5/.codex/hooks/permission_request.py",
            "timeout": 30,
            "statusMessage": "Reviewing escalation request"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/jerry/project/IMathAS5/.codex/hooks/stop_guard.py",
            "timeout": 30,
            "statusMessage": "Checking IMathAS validation gate"
          }
        ]
      }
    ]
  }
}
